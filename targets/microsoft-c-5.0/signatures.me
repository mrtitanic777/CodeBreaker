;; ============================================================================
;; signatures.me  --  Microsoft C 5.0 RE signature catalog
;; ----------------------------------------------------------------------------
;; Living database of every fingerprint we rely on: file/packer formats, the
;; per-binary identity of each target, the original-source (SCCS) attribution
;; map, and (as recovered) CRT/library and per-function signatures.
;;
;; Tiers:   [BX] byte-exact verified   [BH] behavioral (oracle-tested)
;;          [ID] identified (toolchain/CRT, not reconstructed)   [??] hypothesis
;; ============================================================================


;; --- FORMAT / PACKER SIGNATURES -------------------------------------------

[sig format=MZ]
  magic            "MZ" | "ZM" at 0x00
  startup/__astart B4 30 CD 21 3C 02 73 ?? CD 20   ; mov ah,30h; int 21h; cmp al,2; jae; int 20h
  note             every MS C 5.0 program (16/17 packed) begins __astart with this DOS get-version probe.

[sig packer=EXEPACK]
  detect           header relocs=0  AND  "Packed file is corrupt!" present  AND  "RB" sig word ending the exepack header at CS:0000
  header(16 byte)  u16 real_ip, real_cs, mem_start, exepack_size, real_sp, real_ss, dest_len_para, "RB"
  stub opcodes     B0=run(cnt,byte)  B2=copy(cnt)  |1 = last-command flag ; decompress top-down, in place
  QUIRK            large images pack ONLY the trailing data; code is stored verbatim ahead of it.
                   Decompression is in-place -> seed output with the load module, not zeros.
  unpacker         tools/unexepack.py  (algorithm lifted from the C2.EXE stub disasm)

[sig lib=OMF]
  LIB magic        first byte 0xF0 (LIBHDR)      ; OBJ magic 0x80 (THEADR)
  reader           wt inverse omf <file>         ; source for CRT libmatch signatures


