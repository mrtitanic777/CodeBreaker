;; --- ORIGIN ATTRIBUTION: SCCS module map ----------------------------------
;; 80 original .c source files recovered from @(#)file.c:ver stamps.
;; Use to attribute each recovered function to its authored module (Phase 6).

[driver  CL/QCL]  cc_main cc_msdos error flags get_err getflags strings targetcode

[codegen C2]      MD MDmisc ail andor bitfields canonical children confold const_hack
                  cse cseMD csize ctypes debug emit expand exphelp gencode genswitch
                  getattrib grammar il initil interpret intrinfo intrinsic io ioin loop
                  ltoa mactab main memallo opMD optimize optstring p2pragma p2symtab
                  pragma pril regMD sil sortnode su suMD switchMD tables trees
                  error get_err getflags

[backend C3]      MD ail check_mode code csize dbil dbread debug disasm2 disasm3 error
                  get_err getflags initil io ioin labels ltoa main memallo omf omf_ms
                  opMD p3debug p3io p3symtab pgo pgo2 pgoMD pgoMD2 pragma sil srclist
                  srclist2 strings stub stub2 tables type

[make    MAKE]    macros makeb
[qc      QC]      yypars

;; Shared C2<->C3 back-end library (identical bodies expected -> cross-verify sigs):
[shared C2^C3]    MD ail csize debug error get_err getflags initil io ioin ltoa main
                  memallo opMD pragma sil tables


;; --- CRT / LIBRARY SIGNATURES (Phase 4 — DONE via tools/idlib.py) ----------
;; 1263 fixup-masked signatures built from the shipped OMF libs (S/M/C/L x C/FP/FA +
;; LIBH/EM/87). Matched into every binary; full [ID] lists per binary in
;; work/<bin>/identified.json. CRT code segment is _TEXT (not Lattice's PROG).
;; Named CRT examples confirmed in CL.EXE: _exit __exit _access __NMSG_WRITE
;;   __NMSG_TEXT __cintDIV __ctermsub __find __inittime ...
;;
;; Compiler-helper (toolchain, [ID]) — recurring internal call targets:
[helper __chkstk]  called as  B8 <framesize:iw> E8 <rel:iw>   (mov ax,n; call __chkstk)
                   in CL.EXE __chkstk = image 0x44e6; every framed fn probes it.
[helper __dosret/criterr]  55 8B EC 83 C5 02 B0 04 ... 1F 9E F9 CB  (retf; sahf; stc)
                   shared verbatim across CL@0x4345, SETENV@0x0aad (global addr differs).


;; --- FUNCTION SIGNATURES (Phase 5+) ---------------------------------------
;; tier [BX]=byte-exact verified against the image (modulo masked fixups)

[fn EXEMOD:_TEXT:0x1ade  [BX]  name=inset  size=41]
  proto   int inset(char c)              ; near, __cdecl, K&R char param at [bp+4]
  source  register char *p; for (p=set; *p; p++) if (*p==c) return 1; return 0;
  build   cl /AS /Ox /c
  bytes   55 8B EC 83 EC 02 56 BE **** 8A 4E 04 EB 02 90 46 80 3C 00 74 0C
          3A 0C 75 F6 B8 01 00 5E 8B E5 5D C3 2B C0 5E 8B E5 5D C3   (** = mov si,set fixup)
  verify  BYTE-EXACT vs EXEMOD@0x1ade (only the 2-byte set pointer differs; it is a
          relocatable fixup). Same idiom recurs in ERROUT/SETENV/MAKE/LIB.
  note    template for Phase-5 recovery; see work/recover/inset.c
