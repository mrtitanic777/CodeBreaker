{
  "platform": "chf",
  "title": "Fairchild Channel F",
  "description": "A cartridge at $0800 written whole as F8 source (console_flat8.cpp): flow from its first byte, a DCI's constant that is a line of the cartridge a label, the BIOS routines the code calls by name.",
  "machine": {
    "family": "F8",
    "container": "cartridge (.chf, or .bin starting $55 $2B; at $0800)",
    "cpu": {
      "language": "F8:BE:16:default",
      "bits": 8,
      "endian": "big",
      "decoder": "f8",
      "registers": [
        "A",
        "W",
        "ISAR",
        "DC0",
        "DC1",
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        "R8",
        "R9",
        "R10",
        "R11"
      ],
      "stack": "ISAR"
    },
    "results": [
      "A",
      "W",
      "ISAR",
      "DC0",
      "DC1",
      "R0",
      "R1",
      "R2",
      "R3",
      "R4",
      "R5",
      "R6",
      "R7",
      "R8",
      "R9",
      "R10",
      "R11"
    ],
    "toolchain": "CodeBreaker's own assembler (F8 syntax)"
  },
  "shape": "flat",
  "dialect": "asmf8",
  "fixed": "bios",
  "head": [
    "{stem}.asm -- written by CodeBreaker from {file}",
    "Channel F cartridge, {size} bytes at $0800 (the F8's memory)",
    ""
  ],
  "flat": {
    "cpu": "f8",
    "built": "{stem}.built{ext}"
  }
}
