      {"at": "0x0146", "size": 1, "what": "Super Game Boy support"},
      {"at": "0x0147", "size": 1, "what": "cartridge type"},
      {"at": "0x0148", "size": 1, "what": "ROM size"},
      {"at": "0x0149", "size": 1, "what": "RAM size"},
      {"at": "0x014A", "size": 1, "what": "destination"},
      {"at": "0x014B", "size": 1, "what": "old licensee"},
