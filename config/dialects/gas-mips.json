{
  "name": "gas-mips",
  "description": "GNU as, MIPS: the PlayStation as its programs are written. # comments, $-prefixed registers, decimal offsets and immediates (hex for lui, ori, andi, xori), move / beqz / bnez, .set noreorder, .word, .half, .asciz, .space.",
  "comment": "#",
  "number": {"prefix": "0x", "suffix": "", "case": "upper", "pad": "none"},
  "label": "{name}:",
  "registers": {"prefix": "$", "names": ["zero", "at", "v0", "v1", "a0", "a1", "a2", "a3", "t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "k0", "k1", "gp", "sp", "fp", "ra", "f0", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "f13", "f14", "f15", "f16", "f17", "f18", "f19", "f20", "f21", "f22", "f23", "f24", "f25", "f26", "f27", "f28", "f29", "f30", "f31"]},
  "replace": [[".S ", ".s ", true], [".D ", ".d ", true], [".W ", ".w ", true]],
  "wraps": [{"from": "%up(", "to_open": "(", "to_close": " >> 16)"}],
  "decimal": {"unless": ["lui", "andi", "ori", "xori"]},
  "instructions": [
    {"neutral": "or {w}, {w2}, zero", "dialect": "move {w}, {w2}"},
    {"neutral": "li {w}, {w2}", "dialect": "addiu {w}, $zero, {w2}", "print": false},
    {"neutral": "beq {w}, zero, {w2}", "dialect": "beqz {w}, {w2}"},
    {"neutral": "bne {w}, zero, {w2}", "dialect": "bnez {w}, {w2}"}
  ],
  "blocks": {
    "prologue": ["        .set noreorder", "        .set noat", ""]
  }
}
