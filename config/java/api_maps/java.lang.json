{
  "subsystem": "java.lang",
  "language": "java",
  "description": "java.lang core: math, strings, boxing, System. Targets are C++; a few rows carry by_version overrides to demonstrate the dialect axis (e.g. the null literal and the type-generic <cmath> overloads landed in C++11).",
  "symbols": {
    "null": {"doc": "The null literal (pseudo-symbol modeling how the converter renders `null`).",
      "maps": {"cpp": {"target": "NULL", "kind": "constant",
        "note": "C++03 uses the NULL macro.",
        "by_version": {"c++11": {"target": "nullptr", "kind": "constant",
          "note": "C++11 typed null pointer; also what std_transforms rewrites NULL to."}}}}},
    "Math.sqrt": {"signature": "(double)",
      "maps": {"cpp": {"target": "sqrt", "kind": "direct", "note": "<math.h> / <cmath>.",
        "by_version": {"c++11": {"target": "std::sqrt", "kind": "direct",
          "note": "C++11 <cmath> adds type-generic std::sqrt overloads."}}}}},
    "Math.abs": {"signature": "(int|float|double)",
      "maps": {"cpp": {"target": "j2c::abs", "kind": "shim",
        "note": "Java Math.abs is overloaded per numeric type; a small template preserves the type."}}},
    "Math.min": {"signature": "(T,T)", "maps": {"cpp": {"target": "j2c::min", "kind": "shim"}}},
    "Math.max": {"signature": "(T,T)", "maps": {"cpp": {"target": "j2c::max", "kind": "shim"}}},
    "Math.sin": {"signature": "(double)", "maps": {"cpp": {"target": "sin", "kind": "direct"}}},
    "Math.cos": {"signature": "(double)", "maps": {"cpp": {"target": "cos", "kind": "direct"}}},
    "Math.floor": {"signature": "(double)", "maps": {"cpp": {"target": "floor", "kind": "direct"}}},
    "Math.random": {"signature": "()", "maps": {"cpp": {"target": "j2c::random", "kind": "shim",
      "note": "Uniform double in [0,1); backed by a seeded PRNG, not rand()."}}},
    "String.length": {"signature": "()", "maps": {"cpp": {"target": "JavaString::length", "kind": "shim"}}},
    "String.charAt": {"signature": "(int)", "maps": {"cpp": {"target": "JavaString::charAt", "kind": "shim"}}},
    "String.substring": {"signature": "(int) | (int,int)",
      "maps": {"cpp": {"target": "JavaString::substring", "kind": "signature-adapted",
        "note": "Java (begin,end) exclusive-end vs std::string::substr (pos,count) -- adapter converts end->count."}}},
    "String.equals": {"signature": "(Object)", "maps": {"cpp": {"target": "JavaString::equals", "kind": "shim",
      "note": "Value comparison; NOT operator== on pointers."}}},
    "String.format": {"signature": "(String,Object...)",
      "maps": {"cpp": {"target": "JavaString::format", "kind": "shim", "note": "printf-family under the hood."}}},
    "Integer.parseInt": {"signature": "(String)", "maps": {"cpp": {"target": "JavaString::parseInt", "kind": "shim"}}},
    "Integer.toString": {"signature": "(int)", "maps": {"cpp": {"target": "JavaString::valueOf", "kind": "shim"}}},
    "System.currentTimeMillis": {"signature": "()",
      "maps": {"cpp": {"target": "j2c::currentTimeMillis", "kind": "shim", "note": "QueryPerformanceCounter on 360."}}},
    "System.nanoTime": {"signature": "()", "maps": {"cpp": {"target": "j2c::nanoTime", "kind": "shim"}}},
    "System.arraycopy": {"signature": "(Object,int,Object,int,int)",
      "maps": {"cpp": {"target": "j2c::arraycopy", "kind": "shim", "note": "memmove-based, bounds-checked."}}},
    "Object.hashCode": {"signature": "()", "maps": {"cpp": {"target": "j2c::hashCode", "kind": "shim"}}}
  }
}
