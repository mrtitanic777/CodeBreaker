__pycache__/
*.pyc
# results and caches: regenerated by running the tool
/state/
# what CodeBreaker made of each binary (other people's code and data): never committed
/Converted/
# machine-specific locations (copy settings.example.json)
/settings.json
# native build output
native/*/build/
*.obj
*.o

# from the old checkout: machine-local tools and inputs, never committed
/toolchains/
/reference/
files/
*.iso
config.json
CodeBreaker.config.json
/build/
/dist/
reports/
native/*/*.log
# machine-local inputs the tool reads (docs/NOT_IN_REPO.md): period compilers, OpenWatcom's tree
/binaries/
# the absorbed projects' working copies (docs/PROJECTS_ABSORPTION.md), kept beside the repo
/Projects/
/experiments/premise-proof/open-watcom-v2/
# premise-proof: what its builds make, their machine-specific scripts, and the reconstructed
# lz32/lzexpand source they built (it belongs to the Windows95 tree, not the tool)
/experiments/premise-proof/*.log
/experiments/premise-proof/build_*.bat
/experiments/premise-proof/lz32-build/
/experiments/premise-proof/lzexpand-build/
/experiments/premise-proof/**/*.exe
/experiments/premise-proof/**/*.dll
/experiments/premise-proof/wthunk/*.asm

# regenerated by tools: test runner cache, pip editable-install metadata, old native build trees
.pytest_cache/
*.egg-info/
native/*/build.*/
# the Java engine's Gradle state
native/retromcp/.gradle/
