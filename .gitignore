# Python
__pycache__/
*.pyc
.pytest_cache/

# Logs and snapshots (disposable)
*.log
*.tgz

# Generated converter output (regenerate with
# `python -m j2ctool convert <java_dir> <out_dir>`). Never committed.
/out/
/output/
/output_pristine/
/src/
/include/

# Extracted platform SDKs (large, redistribution not permitted -- bring your own)
/PlatformSDKs/

# COPYRIGHTED / DERIVED MATERIAL -- must never be published.
# Decompiled game source (bring your own), its structural dump, and any per-project
# hand-fixed converted output. The transpiler ships without any game or SDK content.
/original_java/
/signatures.md
/overlays/
/profiles/*.local.json

# Build / packaging intermediates
/build/
/dist/
/_syntaxbuild/
/_batches/
*.egg-info/

# Generated per-project reports (regenerated by the tools; not source)
/BUGFIX_LEDGER.md
