__pycache__/
*.pyc
# results and caches: regenerated by running the tool
/state/
# what CodeBreaker made of each binary (other people's code and data): never committed
/Converted/
# machine-specific locations (copy settings.example.json)
/settings.json
# native build output (native/cb/build is source: the build area). The engines inside native/cb that are built by
# their own tools keep their output beside them: XenonRecomp's (built on demand), the Xbox 360 runtime's tests,
# retromcp's Gradle build.
native/*/build/
!native/cb/build/
native/cb/recompile/xenonrecomp/build/
native/cb/recompile/x360/**/build/
native/cb/recompile/rexglue/**/build/
native/cb/java/retromcp/build/
native/cb/java/retromcp/bin/
*.obj
*.o

# from the old checkout: machine-local tools and inputs, never committed
/toolchains/
/reference/
files/
*.iso
config.json
CodeBreaker.config.json
/build/
/dist/
reports/
native/*/*.log
# machine-local inputs the tool reads (docs/NOT_IN_REPO.md): period compilers, OpenWatcom's tree
/binaries/
# the absorbed projects' working copies (docs/PROJECTS_ABSORPTION.md), kept beside the repo
/Projects/
# local experiments and the OpenWatcom tree (settings: openwatcom)
/experiments/

# regenerated by tools: test runner cache, pip editable-install metadata, old native build trees
.pytest_cache/
*.egg-info/
native/*/build.*/
# the Java engine's Gradle state
native/cb/java/retromcp/.gradle/
native/cb/recompile/xenonrecomp/thirdparty/fmt/support/.gradle/
# test inputs of native/cb are data (objects, binaries), never build output
!native/cb/**/testdata/**
native/cb/**/testdata/**/__pycache__/
# build and run output, not source
codebreaker/xna/bin/
out_sw/
native/*/build-linux/
