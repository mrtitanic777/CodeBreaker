__pycache__/
*.pyc
# what CodeBreaker made of each binary (other people's code and data): never committed
/Converted/
# machine-specific locations (copy settings.example.json)
/settings.json
/config/app.json
/config/app.recent.json
# native build output (src/build is source: the build area). The engines inside src that are built by
# their own tools keep their output beside them: XenonRecomp's (built on demand), the Xbox 360 runtime's tests.
src/*/build/
!src/build/
src/recompile/xenonrecomp/build/
src/recompile/x360/**/build/
src/recompile/rexglue/**/build/
*.obj
*.o

# from the old checkout: machine-local tools and inputs, never committed
/toolchains/
/reference/
files/
*.iso
config.json
CodeBreaker.config.json
/build/
/dist/
reports/
src/*/*.log
# machine-local inputs the tool reads (docs/NOT_IN_REPO.md): period compilers, OpenWatcom's tree
/test-inputs/
# the absorbed projects' working copies (docs/PROJECTS_ABSORPTION.md), kept beside the repo
/Projects/

# regenerated by tools: test runner cache, pip editable-install metadata, old native build trees
.pytest_cache/
*.egg-info/
src/*/build.*/
# the Java engine's Gradle state
src/recompile/xenonrecomp/thirdparty/fmt/support/.gradle/
# test inputs of src are data (objects, binaries), never build output
!src/**/testdata/**
src/**/testdata/**/__pycache__/
# build and run output, not source
codebreaker/xna/bin/
out_sw/
src/*/build-linux/
# the scratch of the people and sessions working on CodeBreaker (gate logs, test runs, scripts): git-ignored
/work/
