# CodeBreaker — track tool CODE only. Keep build artifacts, generated
# ledgers/reports, caches, toolchains, and any user-supplied inputs out of the repo.

__pycache__/
*.pyc

# PyInstaller packaging output (repo-root dirs only; codebreaker/engines/build is CODE)
/build/
/dist/
*.manifest

# generated coverage ledgers, conduct/*.json, logs
reports/

# Vendored assembler/compiler binaries (never distributed; local build dependency)
**/masm32bin/

# Transpiler-Diff generated corpus database (regenerable via `wt diff ingest`)
codebreaker/engines/diff/*.db
codebreaker/engines/diff/*.db-wal
codebreaker/engines/diff/*.db-shm

# User-supplied inputs / reference trees / emulator installs (never commit).
# Anchor /reference/ to the repo root — codebreaker/toolchain/reference is CODE.
/reference/
files/
*.iso

# Object files (recompile build output)
*.o
*.obj

# Local external-tool config (paths are machine-specific; copy config.json.example)
config.json
CodeBreaker.config.json

# Period Microsoft toolchains + DOSBox-X + vc71sp1 (Microsoft-copyrighted; large;
# user-attached local build dependency). NEVER committed — attach via config.json.
/toolchains/

# Data home: the only thing left here is generated Ghidra type archives (regenerable
# via codebreaker/toolchain/ghidra/BuildGDT.py). NEVER committed.
/binaries/

# Project scratch pending native integration (the _sweepdb/*.json curated sweep
# results ARE tracked as the standard of measure; only the staging dir is ignored)
tools/vmm32boot/vmm32stage/

# recovered/: local disassembly + build scratch (regenerable)
/recovered/*.log
/recovered/vxd_loadable.json
/recovered/loadable_phased.json

# editable-install metadata
*.egg-info/

# native C++ engine build output
native/**/build/
native/**/dist/
*.obj

# premise-proof experiment: third-party toolchain clone + build output
experiments/premise-proof/open-watcom-v2/

# premise-proof local build logs + smoke output
experiments/premise-proof/*.log
experiments/premise-proof/smoke/*.exe
experiments/premise-proof/lz32-build/
experiments/premise-proof/wthunk/*.asm
experiments/premise-proof/wthunk/*.obj
