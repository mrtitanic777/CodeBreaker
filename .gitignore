# CodeBreaker — track tool CODE only. Keep build artifacts, generated
# ledgers/reports, caches, and any user-supplied inputs out of the repo.

__pycache__/
*.pyc

# PyInstaller packaging output
build/
dist/
*.manifest

# generated coverage ledgers, conduct/*.json, logs
reports/

# Vendored assembler/compiler binaries (never distributed; local build dependency)
**/masm32bin/

# Transpiler-Diff generated corpus database (regenerable via `wt diff ingest`)
engine/diff/*.db
engine/diff/*.db-wal
engine/diff/*.db-shm

# User-supplied inputs / reference trees / emulator + toolchain installs (never commit)
reference/
files/
*.iso

# Object files (recompile95 build output)
*.o
*.obj

# Local external-tool config (paths are machine-specific; copy config.json.example)
config.json
CodeBreaker.config.json

# Data home: corpus, disassembly, Microsoft toolchain (user-attached), VMs, build
# artifacts. NEVER committed -- attach your own compilers via config.json.
/binaries/

# Merged projects pending native integration into engine/ (their code is absorbed
# into the engine; the raw project dirs + their binaries are not tracked as-is).
