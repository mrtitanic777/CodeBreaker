    "tolower",
    "toupper",
    "ungetc",
    "vfprintf",
    "vsprintf"
  ],
  "runtime_defines": [
    "__acrtused",
    "_cleanup",
    "_filbuf",
    "_flsbuf",
    "_main",
    "fopen",
    "fprintf",
    "malloc"
  ],
  "runtime_headers": [
    "ctype.h",
    "dos.h",
    "fcntl.h",
    "io.h",
    "malloc.h",
    "memory.h",
    "process.h",
    "signal.h",
    "stdio.h",
    "stdlib.h",
    "string.h"
  ],
  "runtime_internals": [
    "_IOREAD",
    "_IOWRT",
    "_base",
    "_cnt",
    "_filbf",
    "_filbuf",
    "_file",
    "_flag",
    "_flsbuf",
    "_iob",
    "_iobuf",
    "_ptr"
  ],
  "platform": {
    "header": "dosrt.h",
    "source": "dosrt.c",
    "calls": [
      "_ctype",
      "_ffree",
      "_fmalloc",
      "_freect",
      "_psp",
      "allmem",
      "close",
      "corein",
      "coremax",
      "coreout",
      "creat",
      "dos_far",
      "dos_int21",
      "fillb",
      "flushall",
      "getdrive",
      "getmem",
      "getml",
      "gets",
      "heap_avail",
      "intdos",
      "ipnCore",
      "isatty",
      "itoa",
      "kbdchar",
      "kbdnew",
      "longjmp",
      "lseek",
      "memicmp",
      "movbytes",
      "open",
      "read",
      "rlsmem",
      "rlsml",
      "setjmp",
      "setmode",
      "sizmem",
      "sopen",
      "strcmpi",
      "stricmp",
      "terminate",
      "unlink",
      "write"
    ],
    "renames": {
      "setjmp": "dos_setjmp",
      "longjmp": "dos_longjmp"
    }
  },
  "widths": {
    "char": 8,
    "short": 16,
    "int": 16,
    "long": 32,
    "pointer": 16
  },
  "int_storage": 16,
  "printf_hex_upper": true,
  "char_signed": true,
  "notes": {
    "_main": "the command line was cut into words at spaces alone (no quotes); the C library of today cuts it its own way",
    "fopen": "text mode as the old library had it: \\n is \\r\\n in a text file (on Windows the C library's own text mode; elsewhere files are binary)",
    "kbdchar": "DOS's buffered line input (function 0Ah): the line, a carriage return, a line feed; at the end of the input -1",
    "corein": "the memory above the program's 64K: here pages of a block of the heap of as many pages as coremax says",
    "getdrive": "the current drive (0 = A:); on a system without drives, C:",
    "longjmp": "a longjmp without a value: 1 (the old one returned whatever was in AX)",
    "sopen": "the sharing asked for is not kept (no other program shares the file)"
  },
  "struct_align": 2,
  "keywords_removed": [
    "far",
    "near",
    "huge",
    "_far",
    "_near",
    "_huge",
    "pascal",
    "_pascal",
    "cdecl",
    "_cdecl",
    "fortran",
    "_fortran",
    "interrupt",
    "_interrupt",
    "_export",
    "_loadds",
    "_saveregs"
  ],
  "text_mode": true
}