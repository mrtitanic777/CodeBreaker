{
  "_comment": "Editable source-tree map for the reconstructed Win95 16-bit DLLs. This is a PLAUSIBLE reconstruction of Microsoft's Chicago source layout, NOT verified ground truth -- correct it as real evidence emerges. Placement precedence: exact_map (high confidence) -> rules (family, medium) -> UNSORTED (marked @REVIEW). Nothing is force-classified; ambiguous DLLs stay in UNSORTED by design.",

  "root": "WIN95",

  "layout": {
    "CORE":     {"desc": "16-bit core user-mode subsystem", "children": ["KERNEL", "USER", "GDI", "TOOLHELP", "THUNK"]},
    "SHELL":    {"desc": "Shell & common UI", "children": ["SHELL", "COMMDLG", "COMCTL", "CTL3D"]},
    "SETUP":    {"desc": "Setup / install", "children": []},
    "OLE":      {"desc": "OLE / COM", "children": ["OLECLI", "OLESVR", "OLE2", "COMPOBJ", "STORAGE", "TYPELIB"]},
    "MMEDIA":   {"desc": "Multimedia", "children": ["MMSYSTEM", "MCI", "MSACM", "MSVIDEO", "DDRAW"]},
    "COMM":     {"desc": "Communications & 16-bit networking", "children": ["WINSOCK", "NETAPI", "TAPI", "RAS", "NETWARE", "NETMEETING"]},
    "MAPI":     {"desc": "Messaging (MAPI)", "children": []},
    "PRINT":    {"desc": "Printing subsystem & printer drivers", "children": []},
    "DRIVERS":  {"desc": "16-bit device drivers (.DRV)", "children": []},
    "BASE":     {"desc": "Base utility libraries", "children": ["LZEXPAND", "VER", "MATH"]},
    "GAMES":    {"desc": "Bundled games/accessories", "children": []},
    "INC":      {"desc": "Global master header files", "children": []},
    "TOOLS":    {"desc": "Build toolchain (pointer to ../../../toolchain)", "children": []},
    "BUILD":    {"desc": "Master build scripts & makefiles", "children": []},
    "UNSORTED": {"desc": "Reconstructed DLLs not yet confidently placed -- HAND REVIEW", "children": []}
  },

  "scaffold_out_of_scope": {
    "VMM32":  "Ring-0 VMM & VxDs (.VXD/LE) -- out of NE reconstruction scope",
    "VNET":   "32-bit/VxD network stack (NDIS/TCPIP VxDs) -- out of scope",
    "_note":  "Scaffold dirs are created empty with a SCOPE.md so the tree mirrors Microsoft's shape, but the reconstruction pipeline never populates them (16-bit NE user-mode only)."
  },

  "populated_external": {
    "MSDOS":  "Real-mode MS-DOS 7.10 base -- NOT a 16-bit NE DLL, so not pipeline output, but populated with the complete buildable MS-DOS 7.10 source (microsoft/MS-DOS MIT v4.0 tree + clean-room 7.10 deltas) vendored from the LoganOS reconstruction.",
    "_note":  "Components filed here are populated from real external source, not the 16-bit-NE pipeline. cmd_init must NOT overwrite their hand-written SCOPE.md; it only ensures the dir exists."
  },

  "exact_map": {
    "krnl386.exe": "CORE/KERNEL", "kernel.exe": "CORE/KERNEL", "toolhelp.dll": "CORE/TOOLHELP",
    "user.exe": "CORE/USER", "gdi.exe": "CORE/GDI", "systhunk.dll": "CORE/THUNK", "cmthunks.dll": "CORE/THUNK", "mnmthk16.dll": "CORE/THUNK",
    "shell.dll": "SHELL/SHELL", "commdlg.dll": "SHELL/COMMDLG", "comctl31.dll": "SHELL/COMCTL", "commctrl.dll": "SHELL/COMCTL", "kommctrl.dll": "SHELL/COMCTL", "ctl3dv2.dll": "SHELL/CTL3D", "iconlib.dll": "SHELL", "moricons.dll": "SHELL", "progman.exe": "SHELL", "winfile.exe": "SHELL", "control.exe": "SHELL", "sysedit.exe": "SHELL",
    "ole2.dll": "OLE/OLE2", "ole2conv.dll": "OLE/OLE2", "ole2disp.dll": "OLE/OLE2", "ole2nls.dll": "OLE/OLE2", "olecli.dll": "OLE/OLECLI", "olesvr.dll": "OLE/OLESVR", "mciole.dll": "OLE", "compobj.dll": "OLE/COMPOBJ", "storage.dll": "OLE/STORAGE", "typelib.dll": "OLE/TYPELIB", "stdole.tlb": "OLE/TYPELIB",
    "mmsystem.dll": "MMEDIA/MMSYSTEM", "mmci.dll": "MMEDIA/MCI", "mmmixer.dll": "MMEDIA/MMSYSTEM", "msmixmgr.dll": "MMEDIA/MMSYSTEM", "msacm.dll": "MMEDIA/MSACM", "msvideo.dll": "MMEDIA/MSVIDEO", "dispdib.dll": "MMEDIA", "ddraw16.dll": "MMEDIA/DDRAW",
    "winsock.dll": "COMM/WINSOCK", "winnet16.dll": "COMM", "netapi.dll": "COMM/NETAPI", "netos.dll": "COMM", "netdi.dll": "COMM", "netdde.exe": "COMM", "nddeapi.dll": "COMM", "nddenb.dll": "COMM", "inet16.dll": "COMM", "mstcp.dll": "COMM", "winpopup.exe": "COMM", "rplimage.dll": "COMM/RPLIMAGE",
    "lzexpand.dll": "BASE/LZEXPAND", "suexpand.dll": "BASE/LZEXPAND", "ver.dll": "BASE/VER", "verx.dll": "BASE/VER", "winver.exe": "BASE/VER", "win87em.dll": "BASE/MATH",
    "sol.exe": "GAMES", "freecell.exe": "GAMES", "winmine.exe": "GAMES", "mshearts.exe": "GAMES", "cards.dll": "GAMES"
  },

  "rules": [
    ["\\.drv$",              "DRIVERS",         "16-bit device driver"],
    ["^ole",                 "OLE",             "OLE family (prefix)"],
    ["^mnm",                 "COMM/NETMEETING", "NetMeeting family (prefix)"],
    ["^(tapi|rasapi|umdm|modemui|serialui|dialer)", "COMM", "telephony/modem/RAS family"],
    ["^(nw|nwnds|dlcndi|mswebndi)", "COMM/NETWARE", "NetWare/redirector family"],
    ["^(setup|inst|finstall|uninstal|w95inf|rnasetup)", "SETUP", "setup/install family"],
    ["^(hp|unidrv|msprint|pkpd|pmspl|dmcolor|wps|sf40)", "PRINT", "printing family"],
    ["^(mci|msacm|avi|avicap|avifile|msvideo)", "MMEDIA", "multimedia family"],
    ["^(mapi|cmc)",          "MAPI",            "messaging family"],
    ["^(twain|twunk|faxcodec|awdevl)", "MMEDIA", "imaging/TWAIN family"],
    ["^tour",                "SHELL",           "Welcome/tour applet"]
  ],

  "default": "UNSORTED"
}
