/* CodeBreaker's terminal interface (ui/terminal.py). Colours come from the "codebreaker" theme. */

Screen {
    background: $background;
}

Header {
    background: $panel;
    color: $foreground;
}

.pane-title {
    padding: 0 1;
    color: $primary;
    text-style: bold;
}

.dim-line {
    color: $foreground-muted;
    height: 1;
    padding: 0 1;
}

/* -- home: the corpus ---------------------------------------------------------------------- */
#side {
    width: 54;
    padding: 1 2;
    background: $surface;
    border-right: tall $panel;
}

#logo {
    height: 5;
    margin-bottom: 1;
}

#totals {
    margin: 1 0;
}

#main {
    padding: 1 1 0 1;
}

Input {
    border: tall $panel;
    background: $surface;
    margin-bottom: 1;
}

Input:focus {
    border: tall $primary;
}

DataTable {
    background: $background;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

DataTable > .datatable--header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: $surface 40%;
}

/* -- a module ------------------------------------------------------------------------------- */
#mod-head {
    height: auto;
    padding: 1 1;
    background: $surface;
    border-bottom: tall $panel;
}

#mod-body {
    height: 1fr;
}

#fn-pane {
    width: 64;
    padding: 1 1 0 1;
    border-right: tall $panel;
}

#detail {
    padding: 0 1;
}

#detail TabPane {
    padding: 1 0 0 0;
}

Tabs {
    background: $background;
}

Tab.-active {
    color: $primary;
    text-style: bold;
}

/* -- jobs ----------------------------------------------------------------------------------- */
#jobs-list {
    width: 64;
    padding: 1 1 0 1;
    border-right: tall $panel;
}

#jobs-log-pane {
    padding: 1 1 0 1;
}

RichLog {
    background: $background;
}

/* -- dialogs -------------------------------------------------------------------------------- */
Help, Ask, Info {
    align: center middle;
    background: $background 70%;
}

#help {
    width: 92;
    height: auto;
    padding: 1 3;
    background: $surface;
    border: round $primary;
}

#help-logo {
    margin-bottom: 1;
}

#ask {
    width: 70;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#info {
    width: 110;
    height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#info-title {
    color: $primary;
    margin-bottom: 1;
}

LoadingIndicator {
    height: 3;
    color: $primary;
}

Footer {
    background: $panel;
}

#detail TabPane Static {
    width: 100%;
}
