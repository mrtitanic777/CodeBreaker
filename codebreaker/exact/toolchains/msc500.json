{
 "name": "msc500",
 "title": "Microsoft C 5.0 (CL.EXE and its passes C1-C3), 1987",
 "kit": "msc500",
 "emulator": "dos",
 "stage": {
  "files": {
   "CL.EXE": "SETUP/CL.EXE",
   "C1.EXE": "SETUP/C1.EXE",
   "CL.ERR": "SETUP/CL.ERR",
   "C2.EXE": "COMPILER/C2.EXE",
   "C3.EXE": "COMPILER/C3.EXE",
   "C1.ERR": "COMPILER/C1.ERR",
   "C23.ERR": "COMPILER/C23.ERR"
  },
  "include": "INCLIBSM/INCLUDE"
 },
 "psp": "0x1000",
 "_psp": "the passes are packed; their unpacker fails when loaded below 64K",
 "env": [
  "PATH=C:\\",
  "INCLUDE=C:\\INCX;C:\\INCLUDE",
  "TMP=C:\\"
 ],
 "_env": "the project's own headers (INCX) are searched before the kit's",
 "switches": "-AS",
 "file_switches": "MFLAGS",
 "passes": [
  {
   "run": "CL.EXE",
   "args": "/c {switches} {tag}.C"
  }
 ],
 "_passes": "the driver runs the passes itself (CL.EXE's EXEC)",
 "output": "{tag}.OBJ",
 "default_variant": "release",
 "variants": {
  "release": []
 },
 "libraries": {
  "M": [
   {
    "tag": "5.0",
    "path": "LIB_M_C/MLIBC.LIB"
   },
   {
    "tag": "H5.0",
    "path": "INCLIBSM/LIB/LIBH.LIB"
   }
  ],
  "S": [
   {
    "tag": "5.0",
    "path": "INCLIBSM/SLIBC.LIB"
   },
   {
    "tag": "H5.0",
    "path": "INCLIBSM/LIB/LIBH.LIB"
   }
  ]
 },
 "objects": {
  "M": [
   "INCLIBSM/LIB/BINMODE.OBJ",
   "INCLIBSM/LIB/SETARGV.OBJ"
  ],
  "S": [
   "INCLIBSM/LIB/BINMODE.OBJ",
   "INCLIBSM/LIB/SETARGV.OBJ",
   "INCLIBSM/SVARSTCK.OBJ"
  ]
 },
 "carve": {
  "prologues": [],
  "frames": true,
  "calls": true,
  "_": "C 5.0: push bp / mov bp,sp (far: inc bp first), the stack probe a call to __chkstk with the frame's size in AX"
 },
 "link": {
  "run": "UTILITES/LINK.EXE",
  "dir": "LIB_M_C",
  "libs": {
   "M": [
    "MLIBC.LIB"
   ]
  },
  "psp": "0x1000",
  "_": "LINK 3.61 of the C 5.0 diskettes (a response file); the medium model's library"
 },
 "communal": {
  "segment": "c_common",
  "align": "para",
  "_": "communal names: segment c_common (class BSS) after every module's _BSS, paragraph aligned"
 },
 "segment_switch": "-NT {name}"
}