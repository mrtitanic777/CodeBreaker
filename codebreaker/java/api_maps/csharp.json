{
  "subsystem": "csharp.bcl",
  "language": "csharp",
  "description": "C# / .NET base class library -> C++ and Java. The 'cpp' rows are demonstrator rows; the 'java' rows are the rebinding the C# kit makes on the way to the C++03 back end, whose runtime is Java's library (codebreaker/translate/dotnet/cs2cpp.py): one row per BCL call it carries, 'unsupported' where it refuses with the reason.",
  "symbols": {
    "Console.WriteLine": {
      "signature": "(...)",
      "maps": {
        "cpp": {
          "target": "std::cout << ... << std::endl",
          "kind": "macro"
        },
        "java": {
          "target": "System.out.println",
          "kind": "signature-adapted",
          "note": "one argument; a bool is written as C# writes it (True/False); a double or float is refused (C#'s text is not Java's)"
        }
      }
    },
    "List.Add": {
      "signature": "(T)",
      "maps": {
        "cpp": {
          "target": "std::vector::push_back",
          "kind": "direct"
        },
        "java": {
          "target": "ArrayList.add",
          "kind": "direct"
        }
      }
    },
    "List.Count": {
      "doc": "Property.",
      "maps": {
        "cpp": {
          "target": "std::vector::size",
          "kind": "macro"
        },
        "java": {
          "target": "ArrayList.size",
          "kind": "direct",
          "note": "a property, read as the method"
        }
      }
    },
    "String.Substring": {
      "signature": "(int) | (int,int)",
      "maps": {
        "cpp": {
          "target": "std::string::substr",
          "kind": "signature-adapted",
          "note": "C# Substring(start,length) matches substr(pos,count) directly -- unlike Java's (begin,end)."
        },
        "java": {
          "target": "String.substring",
          "kind": "signature-adapted",
          "note": "Substring(start) as is; Substring(start, length) -> substring(start, start + length), start a name or literal"
        }
      }
    },
    "String.Format": {
      "signature": "(String,...)",
      "maps": {
        "cpp": {
          "target": "j2c::format",
          "kind": "shim",
          "note": "{0} placeholders -> printf/fmt."
        }
      }
    },
    "Math.Sqrt": {
      "signature": "(double)",
      "maps": {
        "cpp": {
          "target": "std::sqrt",
          "kind": "direct"
        },
        "java": {
          "target": "Math.sqrt",
          "kind": "direct"
        }
      }
    },
    "Dictionary.TryGetValue": {
      "signature": "(K,out V)",
      "maps": {
        "cpp": {
          "target": "std::map::find",
          "kind": "signature-adapted",
          "note": "out-param + bool return -> iterator check."
        },
        "java": {
          "target": "",
          "kind": "unsupported",
          "note": "an out parameter"
        }
      }
    },
    "Console.Write": {
      "maps": {
        "java": {
          "target": "System.out.print",
          "kind": "signature-adapted",
          "note": "as Console.WriteLine"
        }
      }
    },
    "String.Length": {
      "maps": {
        "java": {
          "target": "String.length",
          "kind": "direct",
          "note": "a property, read as the method"
        }
      }
    },
    "String.Chars": {
      "maps": {
        "java": {
          "target": "String.charAt",
          "kind": "direct",
          "note": "the indexer s[i]"
        }
      }
    },
    "String.ToUpper": {
      "maps": {
        "java": {
          "target": "String.toUpperCase",
          "kind": "direct"
        }
      }
    },
    "String.ToLower": {
      "maps": {
        "java": {
          "target": "String.toLowerCase",
          "kind": "direct"
        }
      }
    },
    "String.Contains": {
      "maps": {
        "java": {
          "target": "String.contains",
          "kind": "direct"
        }
      }
    },
    "String.Equals": {
      "maps": {
        "java": {
          "target": "String.equals",
          "kind": "direct"
        }
      }
    },
    "String.Trim": {
      "maps": {
        "java": {
          "target": "String.trim",
          "kind": "signature-adapted",
          "note": ".NET trims Unicode white space, Java chars <= space"
        }
      }
    },
    "String.op_Equality": {
      "maps": {
        "java": {
          "target": "String.equals",
          "kind": "signature-adapted",
          "note": "a == b on strings: by value; == null stays =="
        }
      }
    },
    "List.Item": {
