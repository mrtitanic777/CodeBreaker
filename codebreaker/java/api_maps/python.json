{
 "subsystem": "python.builtins",
 "language": "python",
 "description": "CPython builtins / stdlib -> C++ and C. The cpp targets (C++17 forms) are what the Python front end (codebreaker/translate/frontends/python) writes through backends/cpp17.py: a target is a template ({recv} the receiver, {0}.. the arguments, {args} all of them, {T} the result type) over native/ported/include/py.hpp.",
 "symbols": {
  "len": {
   "signature": "(seq)",
   "maps": {
    "cpp": {
     "target": "std::size",
     "kind": "direct",
     "by_version": {
      "c++98": {
       "target": ".size()",
       "kind": "macro",
       "note": "Pre-C++17 has no std::size; call the container's .size() member."
      }
     }
    },
    "c": {
     "target": "(explicit length arg)",
     "kind": "unsupported",
     "note": "C arrays carry no length; the caller must thread an explicit count."
    }
   }
  },
  "print": {
   "signature": "(*args)",
   "maps": {
    "cpp": {
     "target": "std::cout <<",
     "kind": "macro",
     "note": "Join args with ' ', append '\\n'."
    },
    "c": {
     "target": "printf",
     "kind": "signature-adapted",
     "note": "Needs a format string built from arg types."
    }
   }
  },
  "range": {
   "signature": "(start,stop,step)",
   "maps": {
    "cpp": {
     "target": "(for-loop)",
     "kind": "macro",
     "note": "Lower to a counted for-loop; no lazy sequence object."
    },
    "c": {
     "target": "(for-loop)",
     "kind": "macro"
    }
   }
  },
  "str.upper": {
   "signature": "()",
   "maps": {
    "cpp": {
     "target": "j2c::toUpper",
     "kind": "shim",
     "note": "std::toupper per char over the string.",
     "by_version": {
      "c++17": {
       "target": "{recv}.upper({args})",
       "kind": "macro"
      }
     }
    },
    "c": {
     "target": "toupper (per char)",
     "kind": "shim"
    }
   }
  },
  "str.split": {
   "signature": "(sep)",
   "maps": {
    "cpp": {
     "target": "j2c::split",
     "kind": "shim",
     "note": "Returns std::vector<std::string>.",
     "by_version": {
      "c++17": {
       "target": "py::split({recv}{,args})",
       "kind": "shim"
      }
     }
    },
    "c": {
     "target": "strtok_r",
     "kind": "signature-adapted",
     "note": "Destructive; different ownership model."
    }
   }
  },
