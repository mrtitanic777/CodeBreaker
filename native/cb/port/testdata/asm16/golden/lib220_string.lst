				; strcpy(to, from), strcat(to, from): a string,
				 with its 0, copied; to is the answer
				
 0000				_TEXT	SEGMENT	PARA PUBLIC 'CODE'
					ASSUME	CS:_TEXT
					EXTRN	cret:NEAR, _strlen:NEAR
					PUBLIC	_strcpy, _strcat
 0000				_strcpy	PROC	NEAR
 0000  55				PUSH	BP
 0001  8B EC				MOV	BP,SP
 0003  57				PUSH	DI
 0004  56				PUSH	SI
 0005  8B 76 06				MOV	SI,[BP+6]
 0008  8B 7E 04				MOV	DI,[BP+4]
 000B  8B D7				MOV	DX,DI
 000D  FC				CLD
 000E  33 C0				XOR	AX,AX
 0010  8A 04			CPY1:	MOV	AL,[SI]
 0012  A4				MOVSB
 0013  0B C0				OR	AX,AX
 0015  75 F9				JNZ	CPY1
 0017  8B C2				MOV	AX,DX
 0019  E9 0000 E			JMP	cret
 001C				_strcpy	ENDP
				
 001C				_strcat	PROC	NEAR
 001C  55				PUSH	BP
