// codebreaker.rc -- the icon and the version information of codebreaker.exe (the window's icon is resource 1).
#include <winver.h>

1 ICON "res/codebreaker.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CodeBreaker\0"
            VALUE "FileDescription", "CodeBreaker\0"
            VALUE "FileVersion", "2.1.0.0\0"
            VALUE "InternalName", "codebreaker\0"
            VALUE "OriginalFilename", "codebreaker.exe\0"
            VALUE "ProductName", "CodeBreaker\0"
            VALUE "ProductVersion", "2.1.0.0\0"
            VALUE "LegalCopyright", "See LICENSE\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
