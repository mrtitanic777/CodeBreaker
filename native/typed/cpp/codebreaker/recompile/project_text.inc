if(EXISTS "${CMAKE_SOURCE_DIR}/graphics/rex_dxbc/CMakeLists.txt")
    add_subdirectory(graphics/rex_dxbc)
endif()

# every translation unit under src/ (the sharded recomp + init + runtime) and the
