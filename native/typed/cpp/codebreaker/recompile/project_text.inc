# recompiled code uses __builtin_bswap / rotate; GCC or Clang recommended.
if (MSVC)
    target_compile_options(@name@ PRIVATE /bigobj /Od /wd4267 /wd4244 /wd4018)
else()
    target_compile_options(@name@ PRIVATE -O1 -fno-strict-aliasing -w)
