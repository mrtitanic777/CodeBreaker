rexglue: this module's own translation on the rexglue kernel core (scaffold, below; needs -o).)CBX";

// HOST_IMPL: host implementations of the tractable named imports ({import: [statement, ...]}), in the order the Python has them
static void fill_host_impl(py::dict<py::str, py::list<py::str>>& d) {
    d.set(py::str("RtlInitializeCriticalSection"), py::list<py::str>{py::str("ctx.r3.s64 = 0;")});
    d.set(py::str("RtlInitializeCriticalSectionAndSpinCount"), py::list<py::str>{py::str("ctx.r3.s64 = 0;")});
    d.set(py::str("RtlEnterCriticalSection"), py::list<py::str>{py::str("/* single-thread bring-up: no-op */")});
    d.set(py::str("RtlLeaveCriticalSection"), py::list<py::str>{py::str("/* single-thread bring-up: no-op */")});
    d.set(py::str("RtlTryEnterCriticalSection"), py::list<py::str>{py::str("ctx.r3.s64 = 1;")});
    d.set(py::str("RtlDeleteCriticalSection"), py::list<py::str>{py::str("/* no-op */")});
    d.set(py::str("RtlZeroMemory"), py::list<py::str>{py::str("std::memset(base + ctx.r3.u32, 0, ctx.r4.u32);")});
    d.set(py::str("RtlFillMemory"), py::list<py::str>{py::str("std::memset(base + ctx.r3.u32, (int)ctx.r5.u32, ctx.r4.u32);")});
    d.set(py::str("RtlCopyMemory"), py::list<py::str>{py::str("std::memcpy(base + ctx.r3.u32, base + ctx.r4.u32, ctx.r5.u32);")});
    d.set(py::str("RtlCompareMemory"), py::list<py::str>{py::str("uint32_t n = ctx.r5.u32, i = 0;"), py::str("const uint8_t* a = base + ctx.r3.u32; const uint8_t* b = base + ctx.r4.u32;"), py::str("while (i < n && a[i] == b[i]) ++i; ctx.r3.u64 = i;")});
    d.set(py::str("ExAllocatePool"), py::list<py::str>{py::str("ctx.r3.u64 = rex_heap_alloc(ctx.r3.u32);")});
    d.set(py::str("ExAllocatePoolWithTag"), py::list<py::str>{py::str("ctx.r3.u64 = rex_heap_alloc(ctx.r3.u32);")});
