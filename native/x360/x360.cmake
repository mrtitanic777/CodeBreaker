# CodeBreaker's Xbox 360 runtime: builds a recompiled title into a Windows program.
#
#   include(<CodeBreaker>/native/x360/x360.cmake)
#   x360_title(<target> <recompiled library dir> <module_info.cpp>)
#
# The library dir holds XenonRecomp's output for the title (ppc_*.cpp, ppc_config.h, ppc_context.h,
# ppc_func_mapping.cpp); module_info.cpp describes it to the runtime (modules.h: g_titleModule). The program is the
# runtime (runtime/src: kernel, XAM, GPU, audio, input, file system; system/: the system UI and its formats) with the
# title linked in. Clang is required (clang-cl on Windows): the generated code uses its builtins.

if (NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "A recompiled Xbox 360 title needs Clang (clang-cl on Windows).")
endif()
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
find_package(Python3 REQUIRED COMPONENTS Interpreter)

set(X360_ROOT "${CMAKE_CURRENT_LIST_DIR}")
set(X360_RUNTIME "${X360_ROOT}/runtime")
set(X360_PPC_SHARED "${X360_RUNTIME}/ppc_shared")
set(X360_XENON "${X360_ROOT}/../xenonrecomp")
# CPU level of the build: haswell (x86-64-v3) by default; x86-64-v2 for older CPUs.
set(X360_MARCH "haswell" CACHE STRING "-march of the build (haswell or x86-64-v2)")

function(x360_title target library_dir module_info)
    # the register settings the title was recompiled with, for the runtime's ppc_config.h (they change PPCContext)
    # re-read whenever the title is regenerated with other settings: the runtime and the title must agree on the
    # PPCContext layout
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${library_dir}/ppc_config.h")
    file(STRINGS "${library_dir}/ppc_config.h" settings REGEX "^#define PPC_CONFIG_")
    list(JOIN settings "\n" settings)
    set(settings_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}_settings")
    file(CONFIGURE OUTPUT "${settings_dir}/x360_ppc_settings.h" CONTENT
        "// Generated by native/x360/x360.cmake from the title's ppc_config.h.\n#pragma once\n${settings}\n")

    # the recompiled title: its generated code first, the shared indirect-call table force-included before it
    file(GLOB title_sources CONFIGURE_DEPENDS "${library_dir}/ppc_*.cpp")
    if (NOT title_sources)
        message(FATAL_ERROR "${library_dir} has no recompiled code (ppc_*.cpp): run XenonRecomp first.")
    endif()
    add_library(${target}_title STATIC ${title_sources} "${module_info}")
    target_include_directories(${target}_title PRIVATE "${library_dir}" "${X360_PPC_SHARED}" "${X360_RUNTIME}/src"
        "${X360_XENON}/thirdparty/simde" "${settings_dir}")
    target_compile_options(${target}_title PRIVATE "/FI${X360_PPC_SHARED}/ppc_lookup.h" -fno-strict-aliasing
        -march=${X360_MARCH} /fp:strict -Wno-unused-label -Wno-unused-variable)

    # stubs for the imports the runtime does not implement
    file(GLOB_RECURSE kernel_sources CONFIGURE_DEPENDS "${X360_RUNTIME}/src/kernel/*.cpp")
    set(stubs "${CMAKE_CURRENT_BINARY_DIR}/${target}_imports_unimplemented.cpp")
    add_custom_command(OUTPUT "${stubs}"
        COMMAND Python3::Interpreter -I "${X360_ROOT}/tools/gen_import_stubs.py" "${X360_RUNTIME}/src/kernel" "${stubs}"
            "${library_dir}/ppc_func_mapping.cpp"
        DEPENDS "${X360_ROOT}/tools/gen_import_stubs.py" "${library_dir}/ppc_func_mapping.cpp" ${kernel_sources}
        COMMENT "Stubs for the kernel/XAM imports the runtime does not implement")
    # no system modules are linked into a title's program
    set(linked "${CMAKE_CURRENT_BINARY_DIR}/${target}_linked_modules.cpp")
    file(CONFIGURE OUTPUT "${linked}" CONTENT "// Generated by native/x360/x360.cmake: the recompiled system modules linked in (none).
#include \"modules.h\"
#include <cstddef>
namespace kernel
{
    extern const modules::RecompiledModule* const kLinkedSystemModules[] = { nullptr };
    extern const size_t kLinkedSystemModuleCount = 0;
}
")

    file(GLOB_RECURSE runtime_sources CONFIGURE_DEPENDS "${X360_RUNTIME}/src/*.cpp")
    include("${X360_ROOT}/system/xui/xui.cmake")
    include("${X360_ROOT}/system/live/live.cmake")
    include("${X360_ROOT}/system/stfs/stfs.cmake")
    include("${X360_ROOT}/system/guide/guide.cmake")
    include("${X360_ROOT}/system/transition/transition.cmake")
    include("${X360_ROOT}/system/pads/pads.cmake")
    add_executable(${target} ${runtime_sources} "${stubs}" "${linked}" ${X360_XUI_SOURCES} ${X360_LIVE_SOURCES}
        ${X360_STFS_SOURCES} ${X360_GUIDE_SOURCES} ${X360_TRANSITION_SOURCES} ${X360_PADS_SOURCES})
    target_include_directories(${target} PRIVATE "${X360_RUNTIME}/src" "${X360_PPC_SHARED}" "${settings_dir}"
        "${X360_XENON}/XenonUtils" "${X360_XENON}/thirdparty/simde" "${X360_XUI_INCLUDE_DIR}" ${X360_LIVE_INCLUDE_DIRS}
        "${X360_STFS_INCLUDE_DIR}" "${X360_GUIDE_INCLUDE_DIR}" "${X360_TRANSITION_INCLUDE_DIR}" "${X360_PADS_INCLUDE_DIR}")
    target_link_libraries(${target} PRIVATE ${target}_title winmm xinput bcrypt d3d12 dxgi d3dcompiler ole32 ws2_32)
    target_compile_options(${target} PRIVATE -fno-strict-aliasing -march=${X360_MARCH} /fp:strict /Z7)
    target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
    # a Windows program: the log is <program>.log beside the title's files; a fatal error shows a box
    target_link_options(${target} PRIVATE /DEBUG /SUBSYSTEM:WINDOWS /ENTRY:mainCRTStartup)
endfunction()
