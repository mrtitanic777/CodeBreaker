from typing import (
    Dict,
    List,
    Optional,
    Tuple,
    Union,
)


class Event:
    def __init__(
        self,
        file: str,
        category: str,
        message: str,
        line: int = ...,
        severity: <class 'Union'>[str, None] = ...,
        source: str = ...,
        rule: str = ...,
        snippet: str = ...
    ) -> None: ...
    def as_dict(self) -> Dict[str, <class 'Union'>]: ...


class Ledger:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def add(self, file: str, category: str, message: str, **kw) -> None: ...
    def by_file(self) -> Dict[str, List[Event]]: ...
    def file_risk_table(self) -> List[Tuple[str, int, Dict[str, int], Dict[str, int]]]: ...
    def risk_score(self, file_events: List[Event]) -> int: ...
    def to_json(self) -> str: ...
    def totals_by_category(self) -> Dict[str, int]: ...
    def totals_by_severity(self) -> Dict[str, int]: ...
