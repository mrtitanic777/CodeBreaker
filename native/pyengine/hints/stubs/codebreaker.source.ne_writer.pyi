from capstone import CsInsn
from codebreaker.translate.l2 import Assembly
from typing import (
    Dict,
    List,
    Optional,
    Set,
    Tuple,
    Union,
)


class Writer:
    def __init__(self, path: str) -> None: ...
    def _data(self, L: Assembly, si: int, base: int, a: int, end: int) -> None: ...
    def _data_plain(self, L: Assembly, a: int, end: int, segtab: int) -> None: ...
    def _decode(self) -> None: ...
    def _function_starts(self, entries: List[Tuple[int, int]]) -> Set[Tuple[int, int]]: ...
    def _nasm(self, si: int, i: CsInsn, tgt: <class 'Union'>[int, None]) -> str: ...
    def _segment(
        self,
        L: Assembly,
        s: Dict[str, <class 'Union'>],
        lines_of: Dict[int, Tuple[int, int]]
    ) -> None: ...
    @staticmethod
    def _target(i: CsInsn) -> <class 'Union'>[int, None]: ...
    def label(self, si: int, a: int) -> str: ...
    def ref(self, si: int, a: int) -> str: ...
    def source(
        self,
        raw: frozenset = ...,
        mark_all: bool = ...,
        stub: None = ...,
        exact: bool = ...
    ) -> Tuple[str, Dict[int, Tuple[int, int]]]: ...
    def text(self, si: int, i: CsInsn, raw: bool) -> List[str]: ...
    def wanted(self, mark_all: bool) -> Set[Tuple[int, int]]: ...
