from codebreaker.analyze.native import Handle
from typing import (
    Callable,
    Iterator,
    List,
    Optional,
    Set,
    Tuple,
    Union,
)


def _load_pe(path: str) -> Image: ...


def arguments(fn: Function, i: int, n: int) -> List[Tuple[str, int, int]]: ...


def definition(fn: Function, i: int, reg: str, depth: int = ...) -> Tuple[str, int, int]: ...


def family(reg: str) -> str: ...


def kind_of(path: str) -> str: ...


def load(module: str, work: None = ...) -> Image: ...


class Image:
    def __init__(self, path: str, kind: str, bits: int) -> None: ...
    def _auto_name(self, va: int) -> str: ...
    def _finish(self) -> None: ...
    def _function(self, row: List[<class 'Union'>]) -> Function: ...
    def _handle(self) -> Handle: ...
    def discover(self) -> Set[int]: ...
    def each(self) -> Iterator[Function]: ...
    @property
    def flat(self) -> bool: ...
    def function(self, start: int) -> Function: ...
    def memo(
        self,
        key: str,
        make: Callable
    ) -> <class 'Union'>[Dict[int, <class 'Union'>], codebreaker.analyze.call_graph.Graph]: ...
    def read(self, va: int, n: int) -> bytes: ...
    def span(self, va: int) -> Tuple[int, bytes, bool, bool, str, int]: ...
    def u32(self, va: int) -> int: ...
