from codebreaker.java.ir import JType
from typing import Optional


class OwnershipCatalog:
    @classmethod
    def empty(cls) -> OwnershipCatalog: ...


class TypeResolver:
    def __init__(
        self,
        known_classes: <class 'Union'>[Set[str], None] = ...,
        value_types: <class 'Union'>[Set[str], None] = ...,
        interface_types: <class 'Union'>[Set[str], None] = ...,
        enum_types: <class 'Union'>[Set[str], None] = ...,
        members: <class 'Union'>[Dict[str, <class 'Union'>], Dict[str, Dict[str, <class 'Union'>]], None] = ...,
        method_renames: <class 'Union'>[Dict[str, <class 'Union'>], Dict[str, Set[Any]], Dict[str, Set[str]], None] = ...,
        typed_enum_types: <class 'Union'>[Set[str], None] = ...,
        thread_like: <class 'Union'>[Set[str], None] = ...
    ) -> None: ...
    def base_cpp(self, name: str) -> str: ...
    def cpp_type(self, jtype: JType, context: str = ...) -> str: ...
    def extends_value_container(self, class_name: str) -> bool: ...
    def field_type(self, jtype: JType) -> str: ...
    def is_pointer(self, jtype: JType) -> bool: ...
    def is_value(self, jtype: JType) -> bool: ...
    def member_field_type(self, class_name: str, field_name: str) -> JType: ...
    def ownership(self, jtype: JType) -> str: ...
    def param_type(self, jtype: JType) -> str: ...
    def port_note(self, jtype: JType) -> <class 'Union'>[str, None]: ...
    def renamed_method(self, class_name: str, method_name: str) -> str: ...
    def return_type(self, jtype: JType) -> str: ...

