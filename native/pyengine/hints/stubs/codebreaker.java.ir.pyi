from typing import (
    List,
    Optional,
    Tuple,
)


class EnumConst:
    def __init__(self, name: str, args: <class 'Union'>[List[<class 'Union'>[Any, str]], None] = ...) -> None: ...


class Field:
    def __init__(
        self,
        name: str,
        jtype: JType,
        access: str = ...,
        is_static: bool = ...,
        is_final: bool = ...,
        initializer: <class 'Union'>[str, None] = ...,
        line: int = ...
    ) -> None: ...


class JClass:
    def __init__(
        self,
        name: str,
        package: <class 'Union'>[str, None] = ...,
        parent: <class 'Union'>[str, None] = ...,
        interfaces: <class 'Union'>[None, List[str]] = ...,
        is_interface: bool = ...,
        is_abstract: bool = ...,
        is_enum: bool = ...,
        source_path: <class 'Union'>[str, None] = ...
    ) -> None: ...
    def constructors(self) -> List[<class 'Union'>[Any, codebreaker.java.ir.Method]]: ...
    def field(self, name: str) -> <class 'Union'>[codebreaker.java.ir.Field, None]: ...
    def instance_fields(self) -> List[<class 'Union'>[codebreaker.java.ir.Field, Any]]: ...
    def is_typed_enum(self) -> bool: ...
    def method(self, name: str) -> <class 'Union'>[codebreaker.java.ir.Method, None]: ...
    def owns_heap_field(self) -> bool: ...
    def static_fields(self) -> List[<class 'Union'>[codebreaker.java.ir.Field, Any]]: ...


class JType:
    def __eq__(self, other: JType) -> bool: ...
    def __hash__(self) -> int: ...
    def __init__(
        self,
        name: str,
        array_dims: int = ...,
        args: <class 'Union'>[None, List[codebreaker.java.ir.JType]] = ...
    ) -> None: ...
    def __ne__(self, other: JType) -> bool: ...
    def __repr__(self) -> str: ...
    def element(self) -> JType: ...
    @property
    def is_array(self) -> bool: ...
    @property
    def is_generic(self) -> bool: ...


class Method:
    def __init__(
        self,
        name: str,
        return_type: <class 'Union'>[codebreaker.java.ir.JType, None] = ...,
        params: <class 'Union'>[List[codebreaker.java.ir.Param], None] = ...,
        access: str = ...,
        is_static: bool = ...,
        is_abstract: bool = ...,
        is_final: bool = ...,
        is_ctor: bool = ...,
        body: None = ...,
        line: int = ...
    ) -> None: ...
    @property
    def arity(self) -> int: ...
    @property
    def param_types(self) -> List[JType]: ...
    def signature(self) -> Tuple[str, Tuple[str, str]]: ...


class Param:
    def __init__(self, name: str, jtype: JType, is_final: bool = ...) -> None: ...
