from capstone import CsInsn
from codebreaker.translate.l2 import Assembly
from typing import (
    Dict,
    List,
    Optional,
    Set,
    Tuple,
    Union,
)


class Writer:
    def __init__(self, path: str) -> None: ...
    def _data(self, L: Assembly, a: int, end: int, header: bool = ...) -> None: ...
    def _decode(self) -> None: ...
    def _fits(self, i: CsInsn) -> bool: ...
    def _import_rvas(self) -> Dict[int, int]: ...
    def _nasm(self, i: CsInsn, tgt: <class 'Union'>[int, None], sites: List[<class 'Union'>[Any, int]]) -> str: ...
    @staticmethod
    def _secname(name: str, i: int) -> str: ...
    @staticmethod
    def _target(i: CsInsn) -> <class 'Union'>[int, None]: ...
    def _va_of_offset(self, o: int) -> int: ...
    def name(self, va: int) -> str: ...
    def offset(self, va: int) -> int: ...
    def ref(self, va: int) -> str: ...
    def section_of(self, va: int) -> Dict[str, <class 'Union'>]: ...
    def source(self, raw: frozenset = ..., mark_all: bool = ..., stub: None = ...) -> Tuple[str, Dict[int, int]]: ...
    def text(self, i: CsInsn, raw: bool) -> List[str]: ...
    def wanted(self) -> Set[int]: ...

