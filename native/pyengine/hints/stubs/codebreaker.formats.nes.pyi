from typing import List


def _mapped(rom: ROM, address: int) -> int: ...


def _memory(rom: ROM) -> bytearray: ...


def functions(rom: ROM) -> List[int]: ...


def is_nes(path: str) -> bool: ...


def parse(data: bytes, path: str = ...) -> ROM: ...


def read(path: str) -> ROM: ...


class ROM:
    def functions(self) -> List[int]: ...
    def mapped(self, address: int) -> int: ...
    def memory(self) -> bytearray: ...

