from typing import (
    Dict,
    List,
    Tuple,
    Union,
)


class XDBF:
    def __init__(self, data: bytes) -> None: ...
    def _entry_bytes(self, off: int, length: int) -> bytes: ...
    def _payload_map(self) -> Dict[Tuple[int, int], bytes]: ...
    def achievements(self) -> List[Dict[str, <class 'Union'>]]: ...
    def build(self) -> bytes: ...
    def payload(self, ns: int, eid: int) -> bytes: ...
    def set_payload(self, ns: int, eid: int, data: bytes) -> None: ...
    def unlock_achievement(self, ach_id: int, unlock: bool = ...) -> bool: ...

