from codebreaker.translate.ir import Type
from typing import (
    Callable,
    Dict,
    List,
    Optional,
    Tuple,
    Union,
)


def anon_key(line: int, col: int) -> str: ...


def builtin(
    words: List[str],
    model: Model
) -> Type: ...


def fn_type(
    ret: Type,
    params: List[<class 'Union'>[Type, Any]],
    variadic: bool = ...,
    names: None = ...
) -> Type: ...


def normalise(t: Type) -> Type: ...


def tokens(s: str) -> List[str]: ...


class Layouts:
    def __init__(self, model: Model, record: Callable) -> None: ...
    def align(self, t: Type) -> int: ...
    def lay_out(
        self,
        name: str,
        fields: List[Tuple[str, Type]],
        union: bool = ...
    ) -> Tuple[Type, int]: ...
    def record_align(self, r: Type) -> int: ...
    def size(self, t: Type) -> int: ...
    def size_align(self, t: Type) -> Tuple[int, int]: ...


class Model:
    def __init__(
        self,
        triple: str,
        pointer: int,
        long: int,
        wchar: int,
        char_signed: bool = ...,
        long_double: int = ...
    ) -> None: ...
    @classmethod
    def for_triple(cls, triple: str) -> Model: ...
    def json(self, language: str, std: str) -> Dict[str, <class 'Union'>]: ...


class Parser:
    def __init__(self, model: Model, names: Callable) -> None: ...
    def declarator(self, t: Type) -> Type: ...
    def parse(self, text: str) -> Type: ...
    def peek(self, k: int = ...) -> <class 'Union'>[str, None]: ...
    def qualified_name(self) -> <class 'Union'>[Tuple[str, List[Any]], Tuple[str, List[codebreaker.translate.ir.Type]]]: ...
    def specifiers(self) -> Type: ...
    def suffixes(self, t: Type) -> Type: ...
    def take(self, want: <class 'Union'>[str, None] = ...) -> str: ...
    def template_args(self) -> List[Type]: ...
    def type_(self) -> Type: ...

