from re import Pattern
from typing import (
    Dict,
    List,
    Optional,
    Set,
    Tuple,
    Union,
)


def _assignments(text: str, var: str) -> List[<class 'Union'>[Any, str]]: ...


def _constants() -> Tuple[Dict[str, int], List[Tuple[str, int, str]]]: ...


def _deref(var: str) -> Pattern: ...


def _family(prefixes: Tuple[str], header: <class 'Union'>[str, None] = ...) -> List[Tuple[str, int]]: ...


def _local_names(text: str) -> Dict[str, str]: ...


def _prototype(name: str) -> <class 'Union'>[Dict[str, <class 'Union'>], None]: ...


def _rename(text: str, names: Dict[str, str]) -> str: ...


def _struct_vars(text: str) -> Dict[str, str]: ...


def calls(text: str) -> List[Tuple[str, int, int, List[str]]]: ...


def calls_hint(text: str) -> str: ...


def constant(function: str, parameter: str, value: int) -> <class 'Union'>[str, None]: ...


def prefixes_of(base: str, parameter: str) -> Tuple[str]: ...


class Readable:
    def __init__(self, doc: Dict[str, <class 'Union'>], string_at: <class 'Union'>[Callable, None] = ...) -> None: ...
    def _compared(self, text: str) -> str: ...
    def _constants(self, text: str) -> str: ...
    def _fields(self, text: str) -> str: ...
    def _global_names(self) -> Dict[str, str]: ...
    def _proc_name(self, value: str) -> str: ...
    def _strings(self, text: str) -> str: ...
    def definitions(self) -> str: ...
    def function(self, name: str) -> str: ...
    def header(self, text: str) -> str: ...
    def results_unused(self) -> Set[str]: ...
    def struct_definitions(self) -> str: ...
