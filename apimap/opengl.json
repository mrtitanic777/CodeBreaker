{
  "subsystem": "opengl",
  "language": "opengl",
  "description": "OpenGL 1.x fixed-function pipeline (as exposed by LWJGL GL11), realized on Xbox 360 as Direct3D 9. Immediate mode and GL selection have NO 1:1 D3D9 call -- they resolve to hand-written emulator shims (kind=shim) in the j2c::gl namespace. Constants map to D3D enums (kind=constant).",
  "symbols": {
    "GL11.glBegin": {"signature": "(int)", "doc": "Open an immediate-mode primitive.",
      "maps": {"direct3d9": {"target": "j2c::gl::begin", "kind": "shim",
        "note": "Starts accumulating vertices into a scratch buffer; the D3D draw happens at glEnd."}}},
    "GL11.glEnd": {"signature": "()", "doc": "Close and draw the immediate-mode primitive.",
      "maps": {"direct3d9": {"target": "j2c::gl::end", "kind": "shim",
        "note": "Flushes the accumulated vertices via IDirect3DDevice9::DrawPrimitiveUP."}}},
    "GL11.glVertex3f": {"signature": "(float,float,float)", "doc": "Immediate-mode vertex.",
      "maps": {"direct3d9": {"target": "j2c::gl::vertex3f", "kind": "shim",
        "note": "Appends a vertex (with the current color/texcoord) to the immediate-mode buffer."}}},
    "GL11.glVertex2f": {"signature": "(float,float)",
      "maps": {"direct3d9": {"target": "j2c::gl::vertex2f", "kind": "shim", "note": "z=0."}}},
    "GL11.glTexCoord2f": {"signature": "(float,float)", "doc": "Set current texcoord for next vertex.",
      "maps": {"direct3d9": {"target": "j2c::gl::texCoord2f", "kind": "shim"}}},
    "GL11.glColor4f": {"signature": "(float,float,float,float)",
      "maps": {"direct3d9": {"target": "j2c::gl::color4f", "kind": "shim", "note": "Sets current vertex color (RGBA)."}}},
    "GL11.glColor3f": {"signature": "(float,float,float)",
      "maps": {"direct3d9": {"target": "j2c::gl::color3f", "kind": "shim", "note": "alpha=1."}}},
    "GL11.glNormal3f": {"signature": "(float,float,float)",
      "maps": {"direct3d9": {"target": "j2c::gl::normal3f", "kind": "shim"}}},

    "GL11.glInitNames": {"signature": "()", "doc": "GL selection: reset the name stack.",
      "maps": {"direct3d9": {"target": "j2c::gl::initNames", "kind": "shim",
        "note": "Selection/picking is emulated in software (D3D9 has no name stack)."}}},
    "GL11.glPushName": {"signature": "(int)",
      "maps": {"direct3d9": {"target": "j2c::gl::pushName", "kind": "shim"}}},
    "GL11.glPopName": {"signature": "()",
      "maps": {"direct3d9": {"target": "j2c::gl::popName", "kind": "shim"}}},
    "GL11.glLoadName": {"signature": "(int)",
      "maps": {"direct3d9": {"target": "j2c::gl::loadName", "kind": "shim"}}},
    "GL11.glRenderMode": {"signature": "(int)", "doc": "Switch between GL_RENDER and GL_SELECT.",
      "maps": {"direct3d9": {"target": "j2c::gl::renderMode", "kind": "shim",
        "note": "In GL_SELECT the emulator records hits into the select buffer; returns hit count."}}},
    "GL11.glSelectBuffer": {"signature": "(IntBuffer)",
      "maps": {"direct3d9": {"target": "j2c::gl::selectBuffer", "kind": "shim"}}},
    "GL11.glGetInteger": {"signature": "(int,IntBuffer)",
      "maps": {"direct3d9": {"target": "j2c::gl::getInteger", "kind": "shim",
        "note": "GL_VIEWPORT etc. served from cached D3D viewport state."}}},
    "GL11.glGetFloat": {"signature": "(int,FloatBuffer)",
      "maps": {"direct3d9": {"target": "j2c::gl::getFloat", "kind": "shim"}}},

    "GL11.GL_TRIANGLES":  {"maps": {"direct3d9": {"target": "D3DPT_TRIANGLELIST", "kind": "constant"}}},
    "GL11.GL_QUADS":      {"maps": {"direct3d9": {"target": "(emulated: 2 triangles/quad)", "kind": "constant",
        "note": "D3D9 has no quad primitive; the immediate-mode shim tessellates quads to triangle pairs."}}},
    "GL11.GL_TRIANGLE_STRIP": {"maps": {"direct3d9": {"target": "D3DPT_TRIANGLESTRIP", "kind": "constant"}}},
    "GL11.GL_VIEWPORT":   {"maps": {"direct3d9": {"target": "(cached viewport)", "kind": "constant"}}},
    "GL11.GL_SELECT":     {"maps": {"direct3d9": {"target": "j2c::gl::MODE_SELECT", "kind": "constant"}}},
    "GL11.GL_RENDER":     {"maps": {"direct3d9": {"target": "j2c::gl::MODE_RENDER", "kind": "constant"}}},
    "GL11.GL_MODELVIEW":  {"maps": {"direct3d9": {"target": "D3DTS_VIEW", "kind": "constant"}}},
    "GL11.GL_PROJECTION": {"maps": {"direct3d9": {"target": "D3DTS_PROJECTION", "kind": "constant"}}}
  }
}
