{
 "name": "msc400",
 "title": "Microsoft C 4.00 (MSC.EXE and its passes C1-C3), 1986",
 "kit": "msc400",
 "emulator": "dos",
 "stage": {
  "files": {
   "MSC.EXE": "C_COMPILER/MSC.EXE",
   "C1.EXE": "C_COMPILER/C1.EXE",
   "C2.EXE": "C_COMPILER/C2.EXE",
   "C3.EXE": "C_COMPILER/C3.EXE"
  },
  "include": "C_INC_LIB_S"
 },
 "_stage": "(the include folder also holds the libraries; only files are copied, the .H among them are what the passes read)",
 "psp": "0x1000",
 "_psp": "the passes are packed; their unpacker fails when loaded below 64K",
 "env": [],
 "switches": "-Oat",
 "file_switches": "MFLAGS",
 "derive": {
  "ot": {
   "regex": "-O[a-z]*s",
   "then": "-Os",
   "else": "-Ot"
  },
  "gs": {
   "regex": "(^|\\s)-Gs(\\s|$)",
   "then": " -Gs",
   "else": ""
  }
 },
 "passes": [
  {
   "run": "C1.EXE",
   "env": [
    "MSC_CMD_FLAGS=-il C:\\{tag6} -f {tag}.C -pc \\:/ -Q 24242 -A snd -Ze{gs} -I C:/INCX -I C:/INCLUDE -DM_I86 -DMSDOS -DM_I86SM -W 1 ",
    "NO87= "
   ]
  },
  {
   "run": "C2.EXE",
   "env": [
    "MSC_CMD_FLAGS=-il C:\\{tag6} -CSN {ot} -G0{gs} -A snd -W 1 ",
    "NO87= "
   ]
  },
  {
   "run": "C3.EXE",
   "env": [
    "MSC_CMD_FLAGS=-il C:\\{tag6} -FPi {ot} -Oa -c {tag}.OBJ -A snd -CC 0sO ",
    "NO87= "
   ]
  }
 ],
 "_passes": "MSC.EXE gives each pass its switches in the environment (MSC_CMD_FLAGS), not on its command line; its default is -Ot",
 "output": "{tag}.OBJ",
 "default_variant": "release",
 "variants": {
  "release": [],
  "masm400": [
   1,
   5
  ]
 },
 "_variants": "masm400: the state between 3.00 and 4.00 that compiled MASM 4.00 (changes 2-4 are other tries at it)",
 "patches": [
  {
   "change": 1,
   "file": "C3.EXE",
   "at": 44732,
   "was": "740f",
   "now": "eb0f",
   "in_memory": true,
   "note": "AND of memory with 0 stays an AND (C3 AEBC; change 3 of 3.00's list)"
  },
  {
