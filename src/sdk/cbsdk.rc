// sdk/cbsdk.rc -- cbsdk.dll's version information, from the headers' version (cb/version.h).
#include <winver.h>
#include "cb/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CB_SDK_VERSION_MAJOR, CB_SDK_VERSION_MINOR, CB_SDK_VERSION_PATCH, 0
 PRODUCTVERSION CB_SDK_VERSION_MAJOR, CB_SDK_VERSION_MINOR, CB_SDK_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CodeBreaker\0"
            VALUE "FileDescription", "CodeBreaker SDK\0"
            VALUE "FileVersion", CB_SDK_VERSION_STRING "\0"
            VALUE "InternalName", "cbsdk\0"
            VALUE "OriginalFilename", "cbsdk.dll\0"
            VALUE "ProductName", "CodeBreaker SDK\0"
            VALUE "ProductVersion", CB_SDK_VERSION_STRING "\0"
            VALUE "LegalCopyright", "See LICENSE\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
