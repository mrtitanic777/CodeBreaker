# embed_nids.cmake -- config/nids/*.nids as C++ string literals (the generated file is nids_embedded.cpp in the
# build folder). Included by src/CMakeLists.txt; the glob re-runs CMake when a description is added or removed, and the
# files are configure dependencies, so an edit regenerates it.
file(GLOB CB_NIDS_FILES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../../config/nids/*.nids")
list(SORT CB_NIDS_FILES)
set(CB_NIDS_TABLE "")
set(CB_NIDS_TEXTS "")
set(CB_NIDS_COUNT 0)
foreach(nids_file IN LISTS CB_NIDS_FILES)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${nids_file}")
  get_filename_component(nids_name "${nids_file}" NAME)
  file(READ "${nids_file}" nids_text)
  string(LENGTH "${nids_text}" nids_len)
  # a literal holds at most about 16 KB in MSVC: cut the text in pieces that the compiler joins
  set(pieces "")
  set(at 0)
  while(at LESS nids_len)
    string(SUBSTRING "${nids_text}" ${at} 8000 piece)
    string(APPEND pieces "R\"NID(${piece})NID\"\n")
    math(EXPR at "${at} + 8000")
  endwhile()
  if(pieces STREQUAL "")
    set(pieces "\"\"")
  endif()
  string(APPEND CB_NIDS_TEXTS "static const char kText${CB_NIDS_COUNT}[] =\n${pieces};\n")
  string(APPEND CB_NIDS_TABLE "    {\"${nids_name}\", kText${CB_NIDS_COUNT}},\n")
  math(EXPR CB_NIDS_COUNT "${CB_NIDS_COUNT} + 1")
endforeach()
set(CB_NIDS_OUT "${CMAKE_BINARY_DIR}/nids_embedded.cpp")
file(WRITE "${CB_NIDS_OUT}.tmp"
"// generated by src/formats/embed_nids.cmake from config/nids/*.nids -- do not edit
#include <cstddef>

namespace cb::formats::nids {
namespace {
${CB_NIDS_TEXTS}}  // namespace

struct EmbeddedNids {
    const char* file;
    const char* text;
};
extern const EmbeddedNids kEmbeddedNids[] = {
${CB_NIDS_TABLE}    {nullptr, nullptr}};
extern const std::size_t kEmbeddedNidsCount = ${CB_NIDS_COUNT};
}  // namespace cb::formats::nids
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CB_NIDS_OUT}.tmp" "${CB_NIDS_OUT}")   # (the compile only reruns when the text changed)
file(REMOVE "${CB_NIDS_OUT}.tmp")
