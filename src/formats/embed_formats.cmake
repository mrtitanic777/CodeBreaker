# embed_formats.cmake -- config/formats/*.fmt as C++ string literals (the generated file is formats_embedded.cpp in the
# build folder). Included by src/CMakeLists.txt; the glob re-runs CMake when a description is added or removed, and the
# files are configure dependencies, so an edit regenerates it.
file(GLOB CB_FMT_FILES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../../config/formats/*.fmt")
list(SORT CB_FMT_FILES)
set(CB_FMT_TABLE "")
set(CB_FMT_TEXTS "")
set(CB_FMT_COUNT 0)
foreach(fmt IN LISTS CB_FMT_FILES)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fmt}")
  get_filename_component(fmt_name "${fmt}" NAME)
  file(READ "${fmt}" fmt_text)
  string(LENGTH "${fmt_text}" fmt_len)
  # a literal holds at most about 16 KB in MSVC: cut the text in pieces that the compiler joins
  set(pieces "")
  set(at 0)
  while(at LESS fmt_len)
    string(SUBSTRING "${fmt_text}" ${at} 8000 piece)
    string(APPEND pieces "R\"FMT(${piece})FMT\"\n")
    math(EXPR at "${at} + 8000")
  endwhile()
  if(pieces STREQUAL "")
    set(pieces "\"\"")
  endif()
  string(APPEND CB_FMT_TEXTS "static const char kText${CB_FMT_COUNT}[] =\n${pieces};\n")
  string(APPEND CB_FMT_TABLE "    {\"${fmt_name}\", kText${CB_FMT_COUNT}},\n")
  math(EXPR CB_FMT_COUNT "${CB_FMT_COUNT} + 1")
endforeach()
set(CB_FMT_OUT "${CMAKE_BINARY_DIR}/formats_embedded.cpp")
file(WRITE "${CB_FMT_OUT}.tmp"
"// generated by src/formats/embed_formats.cmake from config/formats/*.fmt -- do not edit
#include <cstddef>

namespace cb::formats::engine {
namespace {
${CB_FMT_TEXTS}}  // namespace

struct EmbeddedFormat {
    const char* file;
    const char* text;
};
extern const EmbeddedFormat kEmbeddedFormats[] = {
${CB_FMT_TABLE}    {nullptr, nullptr}};
extern const std::size_t kEmbeddedFormatCount = ${CB_FMT_COUNT};
}  // namespace cb::formats::engine
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CB_FMT_OUT}.tmp" "${CB_FMT_OUT}")   # (the compile only reruns when the text changed)
file(REMOVE "${CB_FMT_OUT}.tmp")
