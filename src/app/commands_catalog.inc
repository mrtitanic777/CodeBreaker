// The commands, by name, in the order `help` lists them: name, how it is written, what it does. Each entry is one line of `help`.
// Every command is listed here, by name. Nothing is discovered by scanning folders.
    {"app", "app [--screenshot PNG ...]", "the CodeBreaker window, what `codebreaker` starts with no command; --screenshot PNG draws it to a file"},
    {"convert", "convert FILE [--to LANG] [--out DIR] [--asm] [--check]", "turn a program into source code you can read and build"},
    {"inspect", "inspect FILE [--names|--library|--origin|--analyze|--classes|--functions|--imports|--calls|--switch-tables|--facts]", "say what a file is and what is inside it"},
    {"extract", "extract FILE [OUT] [--list]", "take the files out of a disc image, cabinet, archive, package or font file"},
    {"build", "build FOLDER [--against F] [--out DIR]", "make a program again from its source folder, and check it against the original"},
    {"check", "check FILE [--bytes|--exact|--repair|--teeth|--drivers|--java|--cs|--py|--score16]", "prove that rebuilt source behaves like the original (or matches its bytes)"},
    {"compare", "compare A B [--json FILE] [--carry]", "match two builds of a program, function by function"},
    {"corpus", "corpus [run|progress|scoreboard|place|coverage|reach|list] ...", "work on the whole collection: run it, watch it, score it"},
    {"lookup", "lookup NAME", "explain a name, a service call or a signature"},
    {"xbox", "xbox [xex|edit|crypto|config|match] ...", "Xbox 360 tools: edit and re-sign a program, crypto, recompiler setup"},
    {"module", "module <name> [--no-verify]", "reconstruct one module: decompile, build, judge, write its source"},
    {"scoreboard", "scoreboard", "rewrite the scoreboard from stored results"},
    {"place", "place <module> ... | --all", "where each module's source goes in the source tree"},
    {"sweep", "sweep [options]", "reconstruct and judge every module (resumable)"},
    {"decompile", "decompile <name or file> [--out FILE]", "CodeBreaker's decompiler: any program to source (a DOS/Windows module to C; a console, Xbox 360, Java or .NET program as `convert` makes it)"},
    {"disassemble", "disassemble FILE [--at ADDR] [--cpu NAME] [--count N]", "CodeBreaker's disassembler: any program or ROM, for any processor (`disassemble --list`)"},
    {"assemble", "assemble SOURCE --cpu NAME [-o OUT]", "CodeBreaker's assembler: source for any processor to its bytes (`assemble --list`)"},
    {"compile", "compile SOURCE.c [--target i86|i386] [args]", "CodeBreaker's compiler: C to an object, in this program (OpenWatcom's wcc / wcc386)"},
    {"link", "link <linker arguments>", "CodeBreaker's linker: objects to a program, in this program (OpenWatcom's wlink)"},
    {"measure", "measure <name>", "reconstruct and judge one module; writes nothing to the tree"},
    {"match", "match <module> [--try]", "optional: does a period compiler give the original's bytes back?"},
    {"repair", "repair <module>", "move each function toward the authored bytes (behaviour-preserving)"},
    {"teeth", "teeth <module>", "break functions the judge passed, on purpose: does it notice?"},
    {"invert", "invert <16-bit module>", "read functions back into the source their compiler was given (compiler models)"},
    {"vxd", "vxd <tool> ...", "a driver as the driver kit's macro source; build and compare it"},
    {"ne-asm", "ne-asm <tool> ...", "16-bit hand-written assembly as cMacros source; build and compare it"},
    {"build16", "build16 <source folder>", "a 16-bit DLL built with Microsoft C 6 and LINK 5.60, compared by segment"},
    {"flat-thunk", "flat-thunk <module> [--recover DIR] [--build DIR] [--ow-build DIR]", "a 32-to-16-bit thunk DLL (lz32 and its kind): its source recovered, built with the thunk compiler, ML, CL and LINK, and compared"},
    {"names", "names <module>", "every function and import with its best name and where it came from"},
    {"identify", "identify <module>", "runtime-library functions of a module, and what built it"},
    {"demangle", "demangle <name>", "a decorated C++ name as its declaration"},
    {"media", "media list|extract <image>", "files of a floppy, hard-disk or CD image"},
    {"dos-functions", "dos-functions <program>", "functions found in a real-mode program, by evidence"},
    {"dos-interrupts", "dos-interrupts [int [AH]]", "name a DOS or BIOS service"},
    {"analyze", "analyze <module> [--what a,b]", "call graph, conventions, globals, strings, structures, classes, dispatch"},
    {"driver-services", "driver-services [FILE ...]", "names of ring-0 services; how many of a driver's calls they name"},
    {"driver-source", "driver-source <driver>", "a driver's assembly source from its image, built and checked"},
    {"dos-source", "dos-source <program>", "a real-mode program's assembly source, built and compared"},
    {"dos-build", "dos-build <folder> [--against F]", "that program made again from its source folder alone"},
    {"pe-source", "pe-source <program> [--stub F]", "a 32-bit Windows program's assembly source (NASM), built and compared byte for byte"},
    {"ne-source", "ne-source <program>", "a 16-bit Windows / OS/2 program's assembly source (NASM), built and compared byte for byte"},
    {"le-source", "le-source <driver>", "a VxD's (or VMM32.VXD's) file as assembly source (NASM), built and compared byte for byte"},
    {"origin", "origin <module> [--list]", "which of a 16-bit module's functions were written in assembly"},
    {"boot-floppy", "boot-floppy", "the Win95 Setup boot floppy, made from the rebuilt files"},
    {"nasm", "nasm <NASM's arguments>", "x86asm, CodeBreaker's own x86 assembler, run on files as NASM is (NASM 3.02 with the MASM mode: --masm)"},
    {"driver-build", "driver-build <folder or .asm>", "assemble and link a driver, check it against the original"},
    {"driver-judge", "driver-judge <rebuilt> <orig>", "run every entry point of both drivers and compare"},
    {"resources", "resources <module> [--out DIR]", "a module's resources as .rc and files, compiled and compared"},
    {"cab", "cab list|extract|create ...", "Microsoft cabinet files"},
    {"disc", "disc <folder> <out.iso>", "write a CD image (also --list, --extract)"},
    {"versions", "versions <module> --from A --to B", "match the functions of two builds: identical, changed, added, removed"},
    {"fonts", "fonts FILE [--show TEXT]", "list and draw the raster fonts in a .FON/.FNT"},
    {"info", "info <file-or-module>", "what an executable is and holds (headers, imports, exports, resources)"},
    {"xex", "xex <command> <file.xex> ...", "an Xbox 360 executable: info, list, extract the basefile, convert, patch, re-sign (any command takes a .xex: it is read as its basefile)"},
    {"recompile", "recompile <image or .xex> --all [-o FILE]", "an Xbox 360 program as C++ that runs on a PC (every function; --at ADDR --size N for one; --check compiles it)"},
    {"recompile-project", "recompile-project <title> [--check [s]]", "an Xbox 360 title (a .xex, package, disc image or folder) as a project that builds and runs on a PC (docs/RECOMPILE.md)"},
    {"xenon-recompile", "xenon-recompile <config.toml>", "XenonRecomp on a configuration, its output folder synced (changed files in, stale ones out): what a build runs, the Xbox 360 Dashboard's modules too"},
    {"heavyiron", "heavyiron <cmd> <file.ho> ...", "Heavy Iron GoodEngine archives (Up, WALL-E, SpongeBob): list, extract, replace an asset, textures as PNG"},
    {"gfx", "gfx <cmd> <file> ...", "Scaleform GFx menus: movies, images, fonts, placements; a font as TTF"},
    {"xex-imports", "xex-imports <module.xex>", "its imports: library, ordinal, name, function or variable, slot, thunk"},
    {"xbox-disc", "xbox-disc files|read|unpack <image> ...", "an Xbox 360 disc image's files: listed, one read, all unpacked"},
    {"xex-basic", "xex-basic <file.xex> <out.xex>", "the unencrypted, basic-compressed form XenonRecomp reads"},
    {"xenon-config", "xenon-config <basic.xex> <out.toml>", "a module's XenonRecomp configuration (--out-dir, --switch-tables, --file-path)"},
    {"switch-tables", "switch-tables <basic.xex> <out.toml>", "its switch tables (with XenonAnalyse's)"},
    {"corpus-executables", "corpus-executables", "every corpus executable: its format, a tab, its path"},
    {"xex-edit", "xex-edit <op> <file.xex> ...", "change its privilege flags, or its code at an address (nop, bytes, asm, hook)"},
    {"ppc-calls", "ppc-calls <.xex or image> [-o F]", "what its calls show: argument counts, registers kept, variadic functions"},
    {"xna", "xna <package, folder or .exe> [--name N]", "an XNA game: C# of its assemblies (ILSpy) and its content as PNG/JSON"},
    {"xdk-match", "xdk-match <.xex or image> [libs] [-o F]", "name the XDK library functions it was linked with"},
    {"system-ui", "system-ui <update package> <dir>", "the Xbox 360 runtime's system UI assets from the owner's system update"},
    {"crypto", "crypto <tool> [args]", "Xbox 360 console crypto (XeCrypt, keyvaults, boot chain, NAND, shadowboots)"},
    {"classes", "classes <.xex or image> [-o F]", "its C++ classes from run-time type information: bases, virtual function tables, which class introduces each virtual function"},
    {"coverage", "coverage [--module NAME]", "how much of every corpus module is accounted for, and in what state"},
    {"reach", "reach <file or folder> [--judge]", "anything at all: what each program is, its platform (or the platform there is no lane for yet), and with --judge how far its lane gets; a few of each platform, one at a time"},
    {"mcp", "mcp [--http PORT]", "CodeBreaker as an MCP server for an assistant (stdio; or HTTP with a token)"},
    {"serve", "serve [--status|--stop]", "the CodeBreaker service: one process the MCP servers and `facts` all ask (started on demand; exits when idle)"},
    {"progress", "progress [--once]", "watch a running sweep"},
    {"settings", "settings", "every setting, and whether what it names is there"},
    {"cache", "cache [--stats|--prune|--clear|--tidy|--migrate]", "what the cache keeps; prune or clear it (--tidy cleans state/, --migrate carries old results over)"},
    {"facts", "facts <binary> [kind [key]]", "what a binary's database holds (the engine's facts) and what each was made from; --make to make one current, --databases for all"},
    {"knowledge", "knowledge [platform [kind [key]]]", "the knowledge base: every platform's names, prototypes, signatures, structures and stand-ins, and where each came from"},
    {"tidy-state", "tidy-state [--dry] [--stray]", "state/'s size by part, and what is stale in it removed (killed runs' disk copies, old caches, idle build objects)"},
    {"regress", "regress <all15|setup|slow> [--runs N] [--vms N]", "the milestone regression: the 15 MINI.CAB modules rebuilt and booted to Setup's License page, the Setup chain, the slow cases"},
    {"migrate-state", "migrate-state [--dry]", "carry what the Python-driven program kept (judged results, the knowledge base) to where this program reads it"},
    {"judge-c-java", "judge-c-java roundtrip [--keep] [--work DIR] [--main CLASS] [FILE.java ...]", "Java -> C++ -> Java on the JVM: the Java lane's C++ read back by clang, mapped back onto Java's library, written as Java, original against round-tripped"},
    {"judge-cs-cpp", "judge-cs-cpp [--cxx gcc|clang|msvc|PATH] [--keep] [--work DIR] [--l2] [FILE.cs|DIR ...]", "C# -> C++17 judged by running both: each program (default: the C# corpus) lowered by the Roslyn front end, written by the C++17 back end, compiled by the host C++ compiler and run beside the C# program; a score table (lowers, writes, compiles, agrees)"},
    {"judge-py-cpp", "judge-py-cpp [--cxx gcc|clang|msvc|PATH] [--keep] [--work DIR] [FILE.py ...]", "Python -> C++17 judged by running both: each module's run_* functions (default: the Python corpus) lowered by the Python front end, written by the L2 core's C++17 back end, compiled by the host C++ compiler and run beside CPython; a score table (lowers, writes, compiles, agrees)"},
    {"java", "java <tool> ...", "the Java transpiler: a Java program as C++03 (convert, decompile, worklist, ...; `java --help` lists them)"},
    {"score16", "score16 [options]", "the 16-bit gate's scoreboard: each 16-bit module's C beside its own assembly"},
    {"exact", "exact <module> ...", "exact recovery: a module's functions rebuilt to the original's bytes"},
    {"dos-run", "dos-run [--dir D] [--save S] [--trace-calls] [--out F] <program> [args...]", "run a DOS program on CodeBreaker's own DOS executive (no DOSBox-X): what it printed and wrote"},
