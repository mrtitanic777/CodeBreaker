// The tools of the window, one line per command of commands_catalog.inc: name, title, group, one plain sentence, argument spec (see tools.hpp; "=" derives
// the spec from the command table's usage line). The commands left out are in kLeftOut at the end, with the reason.
    {"convert", "Convert to source", "Convert", "Turns a program, a disc image or a source file into a folder of source code, showing each stage as it goes.", "F File; ?C Language=original|cpp17|csharp --to; ?D Save_in --out"},
    {"pe-source", "Windows program", "Convert", "Turns a 32-bit Windows program back into assembly source, then rebuilds it to prove the source is right.", "="},
    {"ne-source", "Windows 3.x program", "Convert", "Turns a 16-bit Windows or OS/2 program back into assembly source, then rebuilds it to prove the source is right.", "="},
    {"dos-source", "DOS program", "Convert", "Turns a DOS program back into assembly source, then rebuilds it to prove the source is right.", "="},
    {"le-source", "Windows driver (VxD)", "Convert", "Turns a Windows 95 driver, or the whole VMM32.VXD, back into assembly source and rebuilds it byte for byte.", "="},
    {"driver-source", "Driver", "Convert", "Writes a driver's assembly source from its file, builds it again and checks it matches.", "="},
    {"dos-build", "Rebuild a DOS program", "Build", "Makes a DOS program again from its source folder alone, and compares it with the original if you give one.", "D Source_folder; ?F Compare_with --against"},
    {"driver-build", "Build a driver", "Build", "Assembles and links a driver from its source and checks it against the original.", "F Folder_or_assembly_file"},
    {"build", "Build a module", "Build", "Builds a whole module (code, data, resources and exports) from its source and checks it.", "T Module; ?D Save_in --out"},
    {"resources", "Resources", "Build", "Writes a module's icons, dialogs and other resources as files, compiles them again and compares.", "T Module; ?D Save_in --out"},
    {"exact", "Exact recovery", "Check", "Rebuilds a module's functions until they match the original's bytes exactly.", "*T Modules"},
    {"disc", "CD image", "Build", "Writes a folder of files into a CD image (the command also lists and extracts images).", "D Folder; F Image_to_write"},
    {"info", "What is this file?", "Inspect", "Says what an executable is and what is inside it: headers, imports, exports and resources.", "F File_or_module"},
    {"analyze", "Analyze a program", "Inspect", "Maps a program: who calls whom, calling conventions, global data, strings, structures and classes.", "T Module; ?T Only --what"},
    {"names", "Function names", "Inspect", "Lists every function and import of a module with the best name known for it and where the name came from.", "T Module; ?B Score_the_naming_rules --measure"},
    {"decompile", "Decompile to C", "Convert", "Turns any program (32-bit, 16-bit or PowerPC) back into C source. Nothing is built or changed.", "="},
    {"identify", "Library code", "Inspect", "Finds the standard-library functions inside a module and says what compiler built it.", "="},
    {"demangle", "Read a C++ name", "Look up", "Turns a scrambled C++ name such as ?foo@@YAXH@Z back into the declaration it stands for.", "="},
    {"media", "Disk image files", "Extract", "Lists the files on a floppy, hard-disk or CD image, or takes them out.", "="},
    {"dos-functions", "DOS functions", "Inspect", "Finds the functions inside a DOS program and says what evidence shows each one.", "="},
    {"dos-interrupts", "DOS and BIOS services", "Look up", "Names a DOS or BIOS service from its interrupt number (and function number).", "?T Interrupt; ?T Function"},
    {"driver-services", "Driver services", "Look up", "Names the services a driver can call and says how many of its calls they account for.", "?*F Drivers"},
    {"origin", "Hand-written code finder", "Inspect", "Says which functions of a 16-bit module were written in assembly rather than C.", "="},
    {"cab", "Cabinet files", "Extract", "Lists, extracts or creates Microsoft cabinet (.cab) files.", "C Action=list|extract|create; ?W More"},
    {"versions", "Compare two versions", "Compare", "Matches the functions of two builds of a program: identical, changed, added or removed.", "T Module; T Old_build --from; T New_build --to"},
    {"fonts", "Raster fonts", "Extract", "Lists the raster fonts in a .FON or .FNT file and can draw some text with them.", "F Font_file; ?T Text_to_draw --show"},
    {"classes", "C++ classes", "Inspect", "Recovers a program's C++ classes: their bases, virtual function tables and which class introduces each function.", "F Program; ?F Save_to -o"},
    {"facts", "Program facts", "Inspect", "Shows what the database of a program holds and what each fact was made from.", "F Program; ?T Kind; ?T Key; ?B Make_current --make; ?B List_databases --databases"},
    {"knowledge", "Knowledge base", "Look up", "Browses what CodeBreaker knows about each platform: names, prototypes, signatures and structures.", "?T Platform; ?T Kind; ?T Key"},
    {"reach", "Identify any program", "Collection", "Says what any file or folder is and which platform it is for, and with Judge how far CodeBreaker gets with it.", "F File_or_folder; ?B Judge_it --judge"},
    {"judge-cs-cpp", "C# to C++", "Check", "Translates C# programs to C++17, runs both and checks they print the same.", "?C Compiler=gcc|clang|msvc --cxx; ?B Keep_the_work_folder --keep; ?D Work_folder --work; ?B Write_the_translator_form --l2; ?*F C#_files"},
    {"judge-py-cpp", "Python to C++", "Check", "Translates Python modules to C++17, runs both and checks they give the same answers.", "?C Compiler=gcc|clang|msvc --cxx; ?B Keep_the_work_folder --keep; ?D Work_folder --work; ?*F Python_files"},
    {"judge-c-java", "C to Java", "Check", "Takes Java through C++ and back to Java, runs the original and the round trip, and checks they agree.", "C Mode=roundtrip; ?B Keep_the_work_folder --keep; ?D Work_folder --work; ?T Main_class --main; ?*F Java_files"},
    {"java", "Java to C++", "Convert", "Runs the Java transpiler tools: a Java program as C++03, decompiling and more (type --help as the tool to list them).", "W Tool_and_arguments"},
    {"module", "Rebuild a module", "Convert", "Decompiles one Windows 95 module, builds it again, checks it behaves like the original and writes its source into the tree.", "="},
    {"scoreboard", "Scoreboard", "Collection", "Rewrites the progress scoreboard from the results already stored.", "="},
    {"place", "Where source goes", "Collection", "Shows where each module's source belongs in the source tree.", "?*T Modules; ?B Every_module --all"},
    {"sweep", "Rebuild everything", "Collection", "Rebuilds and checks every module in turn; it can be stopped and run again to carry on.", "?W Options"},
    {"repair", "Repair toward the authors' bytes", "Check", "Moves each function closer to the bytes the authors wrote without changing what it does.", "="},
    {"invert", "Read 16-bit source back", "Convert", "Reads 16-bit functions back into the source their compiler was given.", "T 16-bit_module"},
    {"vxd", "Driver kit source", "Convert", "Shows a Windows 95 driver as the driver kit's macro source, builds it and compares it.", "W Tool_and_arguments"},
    {"ne-asm", "Hand-written 16-bit assembly", "Convert", "Shows 16-bit hand-written assembly as cMacros source, builds it and compares it.", "W Tool_and_arguments"},
    {"build16", "Build a 16-bit DLL", "Convert", "Builds a 16-bit DLL with Microsoft C 6 and LINK 5.60 and compares it segment by segment.", "D Source_folder"},
    {"flat-thunk", "Thunk DLL", "Convert", "Recovers and rebuilds a 32-to-16-bit thunk DLL such as lz32 from its pieces.", "T Module; ?D Recover_to --recover; ?D Build_in --build; ?D Build_with_OpenWatcom_in --ow-build"},
    {"boot-floppy", "Setup boot floppy", "Build", "Makes the Windows 95 Setup boot floppy from the rebuilt files (about a minute and a half).", ""},
    {"driver-judge", "Compare two drivers", "Check", "Runs every entry point of a rebuilt driver and of the original and compares what they do.", "F Rebuilt_driver; F Original_driver"},
    {"xex", "Xbox 360 program", "Xbox 360", "Shows, lists, unpacks, converts, patches or re-signs an Xbox 360 program (.xex).", "T Command; F Xbox_360_program; ?W More"},
    {"recompile", "Xbox 360 to C++", "Convert", "Turns an Xbox 360 program into C++ that runs on a PC; Check also compiles it.", "F Program; ?B Every_function --all; ?F Save_to -o; ?B Check_it_compiles --check"},
    {"recompile-project", "Xbox 360 game to PC project", "Convert", "Turns a whole Xbox 360 game (program, package, disc image or folder) into a project that builds and runs on a PC.", "F Game; ?B Check_it_builds --check"},
    {"xenon-recompile", "Run XenonRecomp", "Build", "Runs the recompiler on a configuration file and brings its output folder up to date.", "F Configuration"},
    {"heavyiron", "Heavy Iron archives", "Extract", "Lists, extracts and replaces assets in the archives of Up, WALL-E and SpongeBob, and saves textures as PNG.", "T Command; F Archive; ?W More"},
    {"gfx", "Scaleform menus", "Extract", "Looks inside Scaleform GFx menus: movies, images, fonts and placements; a font can be saved as TTF.", "T Command; F File; ?W More"},
    {"xex-imports", "Xbox 360 imports", "Inspect", "Lists what an Xbox 360 module imports: library, ordinal, name and kind.", "="},
    {"xbox-disc", "Xbox 360 disc", "Extract", "Lists the files of an Xbox 360 disc image, reads one, or unpacks them all.", "C Action=files|read|unpack; F Disc_image; ?W More"},
    {"xex-basic", "Unpack an Xbox 360 program", "Extract", "Writes the unencrypted, uncompressed form of an Xbox 360 program that the recompiler reads.", "F Program; F Save_as"},
    {"xenon-config", "Recompiler configuration", "Xbox 360", "Writes the recompiler's configuration file for a module.", "F Unpacked_program; F Save_as"},
    {"switch-tables", "Switch tables", "Inspect", "Finds the switch tables of an Xbox 360 module and writes them to a file.", "F Unpacked_program; F Save_as"},
    {"xex-edit", "Edit an Xbox 360 program", "Xbox 360", "Changes a program's privilege flags, or its code at an address.", "T Operation; F Xbox_360_program; ?W More"},
    {"ppc-calls", "PowerPC calls", "Inspect", "Shows what a program's calls reveal: argument counts, registers kept and variadic functions.", "F Program; ?F Save_to -o"},
    {"xna", "XNA game", "Convert", "Turns an XNA game into C# source for its code and PNG and JSON for its content.", "F Game; ?T Name --name"},
    {"xdk-match", "Find XDK functions", "Xbox 360", "Names the Xbox development-kit library functions a program was linked with.", "F Program; ?F Save_to -o"},
    {"system-ui", "Xbox 360 system screens", "Extract", "Takes the runtime's system screens out of a system update package.", "F Update_package; D Save_in"},
    {"crypto", "Xbox 360 crypto", "Xbox 360", "Console cryptography tools: keys, key vaults, the boot chain, NAND images and shadowboots.", "W Tool_and_arguments"},
    {"measure", "Measure a module", "Check", "Rebuilds and checks one module and reports how it did, without writing anything to the source tree.", "="},
    {"match", "Match the original's bytes", "Check", "Tries whether a period compiler gives back the original's exact bytes (optional).", "="},
    {"teeth", "Test the checker", "Check", "Breaks functions the checker passed, on purpose, to see whether it notices.", "="},
    {"coverage", "Coverage", "Collection", "Shows how much of every module is accounted for, and in what state.", "?T Module --module"},
    {"score16", "16-bit scoreboard", "Check", "Scores each 16-bit module's C beside its own assembly.", "?W Options"},
    {"regress", "Milestone regression", "Maintenance", "Rebuilds the 15 setup modules and boots them in virtual machines to prove nothing broke (slow).", "C Which=all15|setup|slow; ?T Runs --runs; ?T Virtual_machines --vms"},
    {"corpus-executables", "List the programs", "Collection", "Lists every program of the collection with its format and where it is.", ""},
    {"settings", "Settings report", "Maintenance", "Shows every setting and whether the file or folder it names is there.", ""},
    {"cache", "Cache", "Maintenance", "Shows what the cache keeps, or prunes it or clears it.", "?B Show_sizes --stats; ?B Prune --prune; ?B Clear_everything --clear"},
    {"tidy-state", "Tidy up", "Maintenance", "Shows how big the working folder is and removes what is stale in it.", "?B Only_look --dry; ?B Include_stray_files --stray"},
    {"migrate-state", "Carry over old results", "Maintenance", "Moves what the earlier version kept (results, the knowledge base) to where this one reads it.", "?B Only_look --dry"},
    {"serve", "Background service", "Maintenance", "Shows or stops the background process that answers the assistant tools.", "?B Show_status --status; ?B Stop_it --stop"},
    {"progress", "Watch a rebuild", "Collection", "Shows how far a running rebuild of every module has got.", "?B Once --once"},
