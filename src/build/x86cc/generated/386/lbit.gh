

typedef struct local_bit_set {
	a_bit_set	_0;
} local_bit_set;

inline void LBitAssign( local_bit_set &dst, const local_bit_set &src ) { (dst)._0 = (src)._0; }

inline bool LBitEmpty( const local_bit_set &set ) { return ( (set)._0 == 0 ); }

inline void LBitSet( local_bit_set &dst, a_bit_set a ) { (dst)._0 = (a_bit_set)a; }

inline void LBitFirst( local_bit_set &set ) { LBitSet( set, 1 ); }

inline void LBitInit( local_bit_set &set, a_bit_set val ) { LBitSet( set, val ); }


inline bool LBitOverlap( const local_bit_set &a, const local_bit_set &b ) { return ( ( ( (a)._0 & (b)._0 ) ) ) != 0; }


inline void LBitTurnOff( local_bit_set &a, const local_bit_set &b ) { (a)._0 &= ~(b)._0; }


inline void LBitTurnOn( local_bit_set &a, const local_bit_set &b ) { (a)._0 |= (b)._0; }

inline unsigned int &LBitScalar( local_bit_set &a ) { return ( (a)._0 ); }

#ifdef _LBit_DEFINE_BITNEXT
static void _LBitNext( local_bit_set *set ) {

    (*set)._0 <<= 1;
}
#endif

