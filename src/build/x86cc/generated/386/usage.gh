"Usage: wcc386 [options] file [options]\0"
" \0"
"Options:\0"
"          ( /option is also accepted )\0"
"-3r             386 register calling conventions\0"
"-3s             386 stack calling conventions\0"
"-4r             486 register calling conventions\0"
"-4s             486 stack calling conventions\0"
"-5r             Pentium register calling conventions\0"
"-5s             Pentium stack calling conventions\0"
"-6r             Pentium Pro register calling conventions\0"
"-6s             Pentium Pro stack calling conventions\0"
"-?              print this message\0"
"-aa             allow non const initializers for local aggregates or unions\0"
"        Make Dependency Information\0"
"-ad{[=<file>],bs,d[=<file>],fs,hp[=<file>],t[=<file>]} \0"
"  [=<file>]     - generate make style automatic dependency file\0"
"  bs            - force path separators to '\\' in auto-depend file\0"
"  d[=<file>]    - specify first dependency in make style auto-depend file\0"
"  fs            - force path separators to '/' in auto-depend file\0"
"  hp[=<file>]   - specify default path for headers without one\0"
"  t[=<file>]    - specify target in make style auto-depend file\0"
"-ai             turn off type checking on static initialization\0"
"-aq             turn off qualifier mismatch warning for const/volatile\0"
"-b{c,d,g,m,r,w} Application type\0"
"  c             - build target is a console application\0"
"  d             - build target is a dynamic link library (DLL)\0"
"  g             - build target is a GUI application\0"
"  m             - build target is a multi-thread environment\0"
"  r             - build target uses DLL version of C/C++ run-time library\0"
"  w             - build target is a default windowing application\0"
"-bt[=<os>]      build target is operating system <os>\0"
"        Debugging Information\0"
"-d{0,1,1+,2,2~,3} \0"
"  0             - none\0"
"  1             - only line numbers\0"
"  1+            - only line numbers\0"
"  2             - symbolic information\0"
"  2~            - -d2 but without type names\0"
"  3             - symbolic information with unreferenced type names\0"
"-d<name>[=text] same as #define name [text] before compilation\0"
"-d+             allow extended -d macro definitions\0"
"-db             generate browsing information\0"
"-e[=<num>]      set limit on number of error messages\0"
"        Default calling convention\0"
"-ec{c,d,f,p,r,s,w} \0"
"  c             - __cdecl\0"
"  d             - __stdcall\0"
"  f             - __fastcall\0"
"  p             - __pascal\0"
"  r             - __fortran\0"
"  s             - __syscall\0"
"  w             - __watcall (default)\0"
"-ee             call epilogue hook routine\0"
"-ef             use full path names in error messages\0"
"-ei             force enum base type to use at least an int\0"
"-em             force enum base type to use minimum integral type\0"
"-en             emit routine names in the code segment\0"
"-eoc            emit COFF object files\0"
"-eoe            emit ELF object files\0"
"-eoo            emit OMF object files\0"
"-ep[=<num>]     call prologue hook routine with <num> stack bytes available\0"
"-eq             do not display error messages (but still write to .err file)\0"
"-et             emit Pentium profiling code\0"
"-et0            emit Pentium-CTR0 profiling code\0"
"-ez             generate PharLap EZ-OMF object files\0"
"-fh[=<file>]    use pre-compiled header (PCH) file\0"
"-fhq[=<file>]   do not display pre-compiled header activity warnings\0"
"-fi=<file>      force <file> to be included\0"
"-fip[=<file>]   automatic inclusion of <file> instead of _preincl.h (default)\0"
"-fo[=<file>]    set object file name\0"
"-fp{2,3,5,6}    Generate Floating-point code\0"
"  2             - 80287 FPU code\0"
"  3             - 80387 FPU code\0"
"  5             - 80387 FPU code optimize for Pentium\0"
"  6             - 80387 FPU code optimize for Pentium Pro\0"
"-fpc            calls to floating-point library\0"
"-fpd            enable Pentium FDIV bug check\0"
"-fpi            inline 80x87 instructions with emulation\0"
"-fpi87          inline 80x87 instructions\0"
"-fpr            generate backward compatible 80x87 code\0"
"-fr[=<file>]    set error file name\0"
"-ft             check for truncated versions of file names\0"
"-fti            print informational message when opening include file\0"
"-fx             do not check for truncated versions of file names\0"
"-g=<name>       set code group name\0"
"-h{c,d,w}       Debugging Information format\0"
"  c             - generate Codeview debugging information\0"
"  d             - generate DWARF debugging information\0"
"  w             - generate Watcom debugging information\0"
"-i=<path>       add directory to list of include directories\0"
"-j              change char default from unsigned to signed\0"
"-m{c,f,l,m,s}   Memory model\0"
"  c             - compact - small code/large data\0"
"  f             - flat - small code/small data assuming CS=DS=SS=ES\0"
"  l             - large - large code/large data\0"
"  m             - medium - large code/small data\0"
"  s             - small - small code/small data (defaul)\0"
"-nc=<name>      set code class name\0"
"-nd=<name>      set data segment name\0"
"-nm=<file>      set module name\0"
"-nt=<name>      set name of text segment\0"
"        Optimization\0"
"-o{a,b,c,d,e[=<num>],f,f+,h,i,k,l,l+,m,n,o,p,r,s,t,u,x,z} \0"
"  a             - relax aliasing constraints\0"
"  b             - enable branch prediction\0"
"  c             - disable <call followed by return> to <jump> optimization\0"
"  d             - disable all optimizations\0"
"  e[=<num>]     - expand user functions inline (<num> controls max size)\0"
"  f             - generate traceable stack frames as needed\0"
"  f+            - always generate traceable stack frames\0"
"  h             - enable expensive optimizations (longer compiles)\0"
"  i             - expand intrinsic functions inline\0"
"  k             - include prologue/epilogue in flow graph\0"
"  l             - enable loop optimizations\0"
"  l+            - enable loop unrolling optimizations\0"
"  m             - generate inline code for math functions\0"
"  n             - allow numerically unstable optimizations\0"
"  o             - continue compilation if low on memory\0"
"  p             - generate consistent floating-point results\0"
"  r             - reorder instructions for best pipeline usage\0"
"  s             - favor code size over execution time in optimizations\0"
"  t             - favor execution time over code size in optimizations\0"
"  u             - all functions must have unique addresses\0"
"  x             - equivalent to -obmiler -s\0"
"  z             - NULL points to valid memory in the target environment\0"
"        Preprocess source file\0"
"-p{,c,l,w=<num>} \0"
"                - preprocess source file\0"
"  c             - preserve comments\0"
"  l             - insert #line directives\0"
"  w=<num>       - wrap output lines at <num> columns. Zero means no wrap.\0"
"-pil            preprocessor ignores #line directives\0"
"-pm             dump predefined macros to output\0"
"-q              operate quietly (display only error messages)\0"
"-r              save/restore segment registers across calls\0"
"-ri             return chars and shorts as ints\0"
"-s              remove stack overflow checks\0"
"-sg             generate calls to grow the stack\0"
"-st             touch stack through SS first\0"
"-u[=<name>]     undefine macro name\0"
"-v              output function declarations to .def file\0"
"-vcap           VC++ compatibility: alloca allowed in argument lists\0"
"        Warning control\0"
"-w{=<num>,cd=<id>,ce=<id>,e,x} \0"
"  =<num>        - set warning level number\0"
"  cd=<id>       - disable warning message <id>\0"
"  ce=<id>       - enable warning message <id>\0"
"  e             - treat all warnings as errors\0"
"  x             - set warning level to maximum setting\0"
"-x              ignore all ..INCLUDE environment variables\0"
"-xx             ignore default directories for file search (.,../h,../c,...)\0"
"-zA             disable all extensions (strict ISO/ANSI C)\0"
"-za             disable extensions (i.e., accept only ISO/ANSI C)\0"
"-zam            disable old non-ISO compliant names (macros, symbols)\0"
"-zastd=<std>    use specified ISO/ANSI C language standard (c89,c99)\0"
"-zc             place const data into the code segment\0"
"-zdf            DS floats (i.e. not fixed to DGROUP)\0"
"-zdl            load DS directly from DGROUP\0"
"-zdp            DS is pegged to DGROUP\0"
"-ze             enable extensions (i.e., near, far, export, etc.)\0"
"-zev            enable arithmetic on void derived types\0"
"-zff            FS floats (i.e. not fixed to a segment)\0"
"-zfp            FS is pegged to a segment\0"
"-zfw            generate FWAIT instructions\0"
"-zg             generate function prototypes using base types\0"
"-zgf            GS floats (i.e. not fixed to a segment)\0"
"-zgp            GS is pegged to a segment\0"
"        Multi-byte/Unicode character support\0"
"-zk{0,0u,1,2,3,l,u=<num>,u8} \0"
"  0             - Japanese (Kanji, CP 932)\0"
"  0u            - translate double-byte Kanji to Unicode\0"
"  1             - Chinese/Taiwanese (Traditional, CP 950)\0"
"  2             - Korean (Wansung, CP 949)\0"
"  3             - Chinese (Simplified, CP 936)\0"
"  l             - local installed language\0"
"  u=<num>       - load Unicode translate table for specified code page\0"
"  u8            - Unicode UTF-8\0"
"-zl             remove default library information\0"
"-zld            remove file dependency information\0"
"-zlf            always generate default library information\0"
"-zls            remove automatically inserted symbols\0"
"-zm             emit functions in separate segments\0"
"-zp=<num>       pack structure members with alignment {1,2,4,8,16}\0"
"-zpw            output warning when padding is added in a class\0"
"-zq             operate quietly (display only error messages)\0"
"-zri            inline floating point rounding calls\0"
"-zro            omit floating point rounding calls (non ANSI)\0"
"-zs             syntax check only\0"
"-zt[=<num>]     far data threshold (i.e., larger objects go in far memory)\0"
"-zu             SS != DGROUP (i.e., do not assume stack is in data segment)\0"
"-zw             generate code for Microsoft Windows\0"
"-zz             remove \"@size\" from __stdcall names (10.0 compatible)\0"
