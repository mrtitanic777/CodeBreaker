
#define _DBit_SIZE 256

typedef struct dom_bit_set {
	a_bit_set	_0;
	a_bit_set	_1;
	a_bit_set	_2;
	a_bit_set	_3;
	a_bit_set	_4;
	a_bit_set	_5;
	a_bit_set	_6;
	a_bit_set	_7;
} dom_bit_set;

inline void DBitAssign( dom_bit_set &dst, const dom_bit_set &src )
{
    (dst)._0 = (src)._0;
    (dst)._1 = (src)._1;
    (dst)._2 = (src)._2;
    (dst)._3 = (src)._3;
    (dst)._4 = (src)._4;
    (dst)._5 = (src)._5;
    (dst)._6 = (src)._6;
    (dst)._7 = (src)._7;
}

inline bool DBitEmpty( const dom_bit_set &set )
{
    return ( (set)._0 == 0 &&
        (set)._1 == 0 &&
        (set)._2 == 0 &&
        (set)._3 == 0 &&
        (set)._4 == 0 &&
        (set)._5 == 0 &&
        (set)._6 == 0 &&
        (set)._7 == 0 );
}

inline void DBitSet( dom_bit_set &dst, a_bit_set a, a_bit_set b, a_bit_set c, a_bit_set d, a_bit_set e, a_bit_set f, a_bit_set g, a_bit_set h )
{
    (dst)._0 = a;
    (dst)._1 = b;
    (dst)._2 = c;
    (dst)._3 = d;
    (dst)._4 = e;
    (dst)._5 = f;
    (dst)._6 = g;
    (dst)._7 = h;
}

inline void DBitFirst( dom_bit_set &set ) { DBitSet( set, 1, 0, 0, 0, 0, 0, 0, 0 ); }

inline void DBitInit( dom_bit_set &set, a_bit_set val )
{
    DBitSet( set, val, val, val, val, val, val, val, val );
}

inline void DBitIter( BackRun &run, void (*routine)( BackRun &, unsigned int ), const dom_bit_set &set )
{
    (routine)( run, (set)._0 );
    (routine)( run, (set)._1 );
    (routine)( run, (set)._2 );
    (routine)( run, (set)._3 );
    (routine)( run, (set)._4 );
    (routine)( run, (set)._5 );
    (routine)( run, (set)._6 );
    (routine)( run, (set)._7 );
}

CB_ALWAYS_INLINE bool DBitOverlap( const dom_bit_set &a, const dom_bit_set &b )
{
    return ( ( (a)._0 & (b)._0 ) ||
        ( (a)._1 & (b)._1 ) ||
        ( (a)._2 & (b)._2 ) ||
        ( (a)._3 & (b)._3 ) ||
        ( (a)._4 & (b)._4 ) ||
        ( (a)._5 & (b)._5 ) ||
        ( (a)._6 & (b)._6 ) ||
        ( (a)._7 & (b)._7 ) );
}

inline bool DBitSame( const dom_bit_set &a, const dom_bit_set &b )
{
    return ( ( (a)._0 == (b)._0 ) &&
        ( (a)._1 == (b)._1 ) &&
        ( (a)._2 == (b)._2 ) &&
        ( (a)._3 == (b)._3 ) &&
        ( (a)._4 == (b)._4 ) &&
        ( (a)._5 == (b)._5 ) &&
        ( (a)._6 == (b)._6 ) &&
        ( (a)._7 == (b)._7 ) );
}

inline void DBitTurnOff( dom_bit_set &a, const dom_bit_set &b )
{
    (a)._0 &= ~(b)._0;
    (a)._1 &= ~(b)._1;
    (a)._2 &= ~(b)._2;
    (a)._3 &= ~(b)._3;
    (a)._4 &= ~(b)._4;
    (a)._5 &= ~(b)._5;
    (a)._6 &= ~(b)._6;
    (a)._7 &= ~(b)._7;
}

inline void DBitIntersect( dom_bit_set &a, const dom_bit_set &b )
{
    (a)._0 &= (b)._0;
    (a)._1 &= (b)._1;
    (a)._2 &= (b)._2;
    (a)._3 &= (b)._3;
    (a)._4 &= (b)._4;
    (a)._5 &= (b)._5;
    (a)._6 &= (b)._6;
    (a)._7 &= (b)._7;
}

inline void DBitTurnOn( dom_bit_set &a, const dom_bit_set &b )
{
    (a)._0 |= (b)._0;
    (a)._1 |= (b)._1;
    (a)._2 |= (b)._2;
    (a)._3 |= (b)._3;
    (a)._4 |= (b)._4;
    (a)._5 |= (b)._5;
    (a)._6 |= (b)._6;
    (a)._7 |= (b)._7;
}


#ifdef _DBit_DEFINE_BITNEXT
static void _DBitNext( dom_bit_set *set ) {

    if( set->_0 & 0x80000000 ) {
	DBitSet( *set, 0, 1, 0, 0, 0, 0, 0, 0 );
    } else {
	if( set->_1 & 0x80000000 ) {
	    DBitSet( *set, 0, 0, 1, 0, 0, 0, 0, 0 );
	} else {
	    if( set->_2 & 0x80000000 ) {
		DBitSet( *set, 0, 0, 0, 1, 0, 0, 0, 0 );
	    } else {
		if( set->_3 & 0x80000000 ) {
		    DBitSet( *set, 0, 0, 0, 0, 1, 0, 0, 0 );
		} else {
		    if( set->_4 & 0x80000000 ) {
			DBitSet( *set, 0, 0, 0, 0, 0, 1, 0, 0 );
		    } else {
			if( set->_5 & 0x80000000 ) {
			    DBitSet( *set, 0, 0, 0, 0, 0, 0, 1, 0 );
			} else {
			    if( set->_6 & 0x80000000 ) {
				DBitSet( *set, 0, 0, 0, 0, 0, 0, 0, 1 );
			    } else {
				if( set->_7 & 0x80000000 ) {
				    DBitSet( *set, 0, 0, 0, 0, 0, 0, 0, 0 );
				} else {
				    (*set)._0 <<= 1;
				    (*set)._1 <<= 1;
				    (*set)._2 <<= 1;
				    (*set)._3 <<= 1;
				    (*set)._4 <<= 1;
				    (*set)._5 <<= 1;
				    (*set)._6 <<= 1;
				    (*set)._7 <<= 1;
				}
			    }
			}
		    }
		}
	    }
	}
    }
}
#endif

