<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <global>
    <range space="ram"/>
    <range space="SPAD"/>
    <range space="PORT"/>
  </global>
  <stackpointer register="ISAR" space="SPAD" growth="positive"/>
  <default_proto>
    <prototype name="__asmA" extrapop="0" stackshift="0" strategy="register">
      <input>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
      </output>
    </prototype>
  </default_proto>
</compiler_spec>
