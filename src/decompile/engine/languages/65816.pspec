<?xml version="1.0" encoding="UTF-8"?>
<!-- CodeBreaker: the 65C816 in native mode. The widths of the accumulator and the index registers
     are the context variables m16 and x16 (0: 8 bits, the state CodeBreaker's own decoder reads
     in); REP and SEP change them. The vectors are those of native mode; the console's
     hardware registers ($2100-$437F of each system bank) are volatile. -->
<processor_spec>
  <programcounter register="PC"/>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="RAM" first="0x002100" last="0x00437f"/>
  </volatile>
  <context_data>
    <context_set space="RAM">
      <set name="m16" val="0"/>
      <set name="x16" val="0"/>
    </context_set>
  </context_data>
  <default_symbols>
    <symbol name="COP" address="00FFE4" entry="true" type="code_ptr"/>
    <symbol name="BRK" address="00FFE6" entry="true" type="code_ptr"/>
    <symbol name="ABORT" address="00FFE8" entry="true" type="code_ptr"/>
    <symbol name="NMI" address="00FFEA" entry="true" type="code_ptr"/>
    <symbol name="IRQ" address="00FFEE" entry="true" type="code_ptr"/>
    <symbol name="RES" address="00FFFC" entry="true" type="code_ptr"/>
  </default_symbols>
</processor_spec>
