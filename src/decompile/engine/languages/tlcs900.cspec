<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="XSP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="4" stackshift="4" strategy="register">
      <input>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="2" maxsize="2">
          <register name="BC"/>
        </pentry>
        <pentry minsize="4" maxsize="4">
          <register name="XDE"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="2" maxsize="2">
          <register name="WA"/>
        </pentry>
        <pentry minsize="4" maxsize="4">
          <register name="XWA"/>
        </pentry>
      </output>
      <unaffected>
        <register name="XSP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
