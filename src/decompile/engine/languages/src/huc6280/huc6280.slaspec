# sleigh specification file for the Hudson HuC6280 (PC Engine): the 65C02 plus the HuC6280 additions.
# Derived from the 6502/65C02 descriptions in this directory (Ghidra, Apache-2.0).
# Zero page is $2000-$20FF and the stack $2100-$21FF in the logical address space (MPR1 maps RAM at $2000).

define endian=little;
define alignment=1;

define space RAM     type=ram_space      size=2  default;
define space register type=register_space size=1;

define register offset=0x00  size=1 [ A X Y P ];
define register offset=0x20 size=2  [ PC      SP   ];
define register offset=0x20 size=1  [ PCL PCH S SH ];
define register offset=0x30 size=1 [ N V B D I Z C ];	# status bits
define register offset=0x37 size=1 [ T ];			# memory-operation flag (P bit 5)
define register offset=0x40 size=1 [ MPR0 MPR1 MPR2 MPR3 MPR4 MPR5 MPR6 MPR7 ];	# mapping registers: 8K logical pages -> 21-bit physical

#TOKENS

define token opbyte (8)
   op       = (0,7)

   aaa      = (5,7)
   bbb      = (2,4)
   cc       = (0,1)
;

define token data8 (8)
   imm8		= (0,7)
   rel		= (0,7) signed
;

define token data (16)
	imm16 = (0,15)
;

macro popSR() {
	SP = SP + 1;
	local ccr = *:1 SP;
	N = ccr[7,1];
	T = ccr[5,1];
	V = ccr[6,1];
	B = ccr[4,1];
	D = ccr[3,1];
	I = ccr[2,1];
	Z = ccr[1,1];
	C = ccr[0,1];
}

macro pushSR() {
	local ccr:1 = 0xff;
	ccr[7,1] = N;
	ccr[6,1] = V;
	ccr[5,1] = T;
	ccr[4,1] = 1;	# CodeBreaker: PHP and BRK push B set (only an interrupt pushes it clear)
	ccr[3,1] = D;
	ccr[2,1] = I;
	ccr[1,1] = Z;
	ccr[0,1] = C;
	*:1 (SP) = ccr;
	SP = SP -1;
}

macro resultFlags(value) {
	Z = (value == 0);
	N = (value s< 0);
}

macro subtraction_flags1(register, operand, result) {
	local complement_register = ~register;

	V = ( ((register & ~operand & ~result) | (complement_register & operand & result)) & 0b10000000 ) != 0;
	N = (result s< 0);
	Z = (result == 0);
	C = ( ((complement_register & operand) | (operand & result) | (result & complement_register)) & 0b10000000 ) != 0;
}


################################################################
# Pseudo Instructions
################################################################

define pcodeop readIRQ;

################################################################
REL: reloc		is rel	[ reloc = inst_next + rel; ] { export *:2 reloc; } 

# Immediate
OP1: "#"imm8    is bbb=2; imm8			{ tmp:1 = imm8; export tmp; }
# Zero Page
OP1: imm8       is bbb=1; imm8			{ tmp:2 = 0x2000 + imm8; export *:1 tmp; }
# Zero Page Indexed X
OP1: imm8,X     is bbb=5 & X; imm8		{ tmp:2 = 0x2000 + zext(imm8 + X); export *:1 tmp; }
# Absolute
OP1: imm16      is bbb=3; imm16			{ export *:1 imm16; }
# Absolute Indexed X
OP1: imm16,X    is bbb=7 & X; imm16		{ tmp:2 = imm16 + zext(X); export *:1 tmp; }
# Absolute Indexed Y
OP1: imm16,Y    is bbb=6 & Y; imm16		{ tmp:2 = imm16 + zext(Y); export *:1 tmp; }
# Indirect X  (CodeBreaker: the pointer's two bytes wrap within page zero, as the chip reads them)
OP1: (imm8,X)   is bbb=0 & X; imm8		{ p:1 = imm8 + X; lo:2 = 0x2000 + zext(p); hi:2 = 0x2000 + zext(p + 1); tmp:2 = zext(*:1 lo) | (zext(*:1 hi) << 8); export *:1 tmp; }
# Indirect Y
OP1: (imm8),Y   is bbb=4 & Y; imm8		{ p:1 = imm8; lo:2 = 0x2000 + zext(p); hi:2 = 0x2000 + zext(p + 1); tmp:2 = zext(*:1 lo) | (zext(*:1 hi) << 8); tmp = tmp + zext(Y); export *:1 tmp; }

# Immediate
OP2: "#"imm8    is bbb=0; imm8			{ tmp:1 = imm8; export tmp; }
# Zero Page
OP2: imm8       is bbb=1; imm8			{ tmp:2 = 0x2000 + imm8; export *:1 tmp; }
OP2: A          is bbb=2 & A            { export A; }
# Absolute
OP2: imm16      is bbb=3; imm16			{ export *:1 imm16; }
# Zero Page Indexed X
OP2: imm8,X     is bbb=5 & X; imm8		{ tmp:2 = 0x2000 + zext(imm8 + X); export *:1 tmp; }
# Absolute Indexed X
OP2: imm16,X    is bbb=7 & X; imm16		{ tmp:2 = imm16 + zext(X); export *:1 tmp; }

OP2ST: OP2      is OP2                  { export OP2; }
OP2ST: imm8,Y   is bbb=5 & Y; imm8		{ tmp:2 = 0x2000 + zext(imm8 + Y); export *:1 tmp; }

OP2LD: OP2      is OP2                  { export OP2; }
OP2LD: imm8,Y   is bbb=5 & Y; imm8		{ tmp:2 = 0x2000 + zext(imm8 + Y); export *:1 tmp; }
OP2LD: imm16,Y  is bbb=7 & Y; imm16		{ tmp:2 = imm16 + zext(Y); export *:1 tmp; }


ADDR8:  imm8    is imm8		{ tmp:2 = 0x2000 + imm8; export *:1 tmp; }
ADDR16: imm16   is imm16   	{ export *:1 imm16; }
ADDRI:  (imm16)   is imm16    { tmp:2 = imm16; export *:2 tmp; }


# Instructions


:ADC OP1     is (cc=1 & aaa=3) ... & OP1
{
	local op1 = OP1;
	local tmpC = C;
	# CodeBreaker: the carry in counts toward the carry out; V is signed overflow
	local result = A + op1 + tmpC;
	C = carry(A, op1) || carry(A + op1, tmpC);
	V = ((A ^ result) & (op1 ^ result) & 0x80) != 0;
	A = result;

	resultFlags(A);
}

:AND OP1     is (cc=1 & aaa=1) ... & OP1
{ 
	A = A & OP1; 
	resultFlags(A);
}

:ASL OP2     is (op=0x06 | op=0x0A | op=0x0E | op=0x16 | op=0x1E) ... & OP2
{
	local tmp = OP2;
	C = tmp >> 7;
	tmp = tmp << 1;
	OP2 = tmp;
	resultFlags(tmp);	
}

:BCC  REL			is op=0x90; REL
{
	if (C == 0) goto REL;
}

:BCS  REL			is op=0xB0; REL
{
	if (C) goto REL;
}

:BEQ  REL			is op=0xF0; REL
{
	if (Z) goto REL;
}

:BIT OP2     is (op=0x24 | op=0x2C) ... & OP2
{
	local operand = OP2;	# CodeBreaker: read once (a read of a hardware register is an event)
	N = (operand & 0x80) == 0x80;
	V = (operand & 0x40) == 0x40;
	local value = A & operand;
	Z = (value == 0);
}

:BMI  REL			is op=0x30; REL
{
	if (N) goto REL;
}

:BNE  REL			is op=0xD0; REL
{
	if (Z == 0) goto REL;
}

:BPL  REL			is op=0x10; REL
{
	if (N == 0) goto REL;
}

:BRK   is op=0x00
{
	*:2 (SP - 1) = inst_next + 1;	# CodeBreaker: the address two past BRK
	SP = SP - 2;
	B = 1;
	pushSR();
	I = 1;
	local target:2 = 0xFFF6;
	goto [*:2 target];
}

:BVC  REL			is op=0x50; REL
{
	if (V == 0) goto REL;
}

:BVS  REL			is op=0x70; REL
{
	if (V) goto REL;
}

:CLC     is op=0x18
{
	C = 0;
}

:CLD     is op=0xD8
{
	D = 0;
}

:CLI     is op=0x58
{
	I = 0;
}

:CLV     is op=0xB8
{
	V = 0;
}

:CMP OP1     is (cc=1 & aaa=6) ... & OP1
{ 
	local op1 = OP1;
	local tmp = A - op1;
	resultFlags(tmp);
	C = (A >= op1);
}

:CPX OP2     is (op=0xE0 | op=0xE4 | op=0xEC) ... & OP2
{
	local op1 = OP2;
	local tmp = X - op1;
	resultFlags(tmp);
	C = (X >= op1);
}

:CPY OP2     is (op=0xC0 | op=0xC4 | op=0xCC) ... & OP2
{
	local op1 = OP2;
	local tmp = Y - op1;
	resultFlags(tmp);
	C = (Y >= op1);
}

:DEC OP2     is (op=0xC6 | op=0xCE | op=0xD6 | op=0xDE) ... & OP2
{
	local tmp = OP2 - 1;
	OP2 = tmp;
	resultFlags(tmp);
}

:DEX     is op=0xCA
{
	X = X - 1;
	resultFlags(X);
}


:DEY     is op=0x88
{
	Y = Y -1;
	resultFlags(Y);
}

:EOR OP1     is (cc=1 & aaa=2) ... & OP1
{ 
	local op1 = OP1;
	A = A ^ op1;
	resultFlags(A);
}

:INC OP2     is (op=0xE6 | op=0xEE | op=0xF6 | op=0xFE) ... & OP2
{
	local tmp = OP2 + 1;
	OP2 = tmp;
	resultFlags(tmp);
}

:INY     is op=0xC8
{
	Y = Y + 1;
	resultFlags(Y);
}

:INX     is op=0xE8
{
	X = X + 1;
	resultFlags(X);
}

:JMP ADDR16     is (op=0x4C); ADDR16
{
	goto ADDR16;
}

:JMP ADDRI     is (op=0x6c); ADDRI
{
	goto [ADDRI];
}

:JSR   ADDR16    is op=0x20; ADDR16
{
	*:2 (SP-1) = inst_next - 1;	# CodeBreaker: the address of its own last byte (RTS adds one)
	SP=SP-2; 
	call ADDR16;
}

:LDA OP1     is (cc=1 & aaa=5) ... & OP1
{
	A = OP1;
	resultFlags(A);
}

:LDY OP2     is (op=0xA0 | op=0xA4 | op=0xAC | op=0xB4 | op=0xBC) ... & OP2
{
	Y = OP2;
	resultFlags(Y);
}

:LDX OP2LD     is (op=0xA2 | op=0xA6 | op=0xAE | op=0xB6 | op=0xBE) ... & OP2LD
{
	X = OP2LD;
	resultFlags(X);
}

:LSR OP2     is (op=0x46 | op=0x4A | op=0x4E | op=0x56 | op=0x5E) ... & OP2
{
	local tmp = OP2;
	C = tmp & 1;
	tmp = tmp >> 1;
	OP2 = tmp;
	Z = (tmp == 0);
	N = 0;	
}

:NOP     is op=0xEA
{
}

:ORA  OP1    is  (cc=1 & aaa=0) ... & OP1
{
	A = A | OP1; 
	resultFlags(A);
}

:PHP     is op=0x8
{
	pushSR();
}

:PLP     is op=0x28
{
	popSR();
}

:PHA     is op=0x48
{
	*:1 (SP) = A;
	SP = SP - 1;
}

:PLA     is op=0x68
{
	SP = SP + 1;
	A = *:1 (SP);
	resultFlags(A);
}

:ROL OP2     is (op=0x26 | op=0x2A | op=0x2E | op=0x36 | op=0x3E) ... & OP2
{
	local tmpC = C;
	local op2 = OP2;
	C = op2 >> 7;
	local result = op2 << 1;
	result = result | tmpC;
	OP2 = result;
	resultFlags(result);	
}

:ROR OP2     is (op=0x66 | op=0x6A | op=0x6E | op=0x76 | op=0x7E) ... & OP2
{
	local tmpC = C << 7;
	local tmp = OP2;
	C = tmp & 1;
	tmp = tmp >> 1;
	tmp = tmp | tmpC;
	OP2 = tmp;
	resultFlags(tmp);	
}

:RTI      is op=0x40
{
	popSR();

    SP = SP+1;
	tmp:2 = *:2 SP;
	SP = SP+1;

	return [tmp];
}

:RTS      is op=0x60
{
	SP = SP+1;
	tmp:2 = *:2 SP;
	SP = SP+1;

	return [tmp + 1];	# CodeBreaker: JSR pushed the address of its last byte
}

:SBC OP1     is (cc=1 & aaa=7) ... & OP1
{
	local op1 = OP1;
	local result = A - op1 - !C;

	local wide:2 = zext(A) - zext(op1) - zext(!C);	# CodeBreaker: (before the macro sets C)
	subtraction_flags1(A, op1, result);
	# CodeBreaker: the carry is "no borrow" (the macro's is the borrow)
	C = wide s>= 0;
	A = result;	

	# resultFlags(tmp);
	# C = ((A <= op1) * C) | (A < op1);
	# A = tmp;
}

:SEC     is op=0x38
{
	C = 1;
}

:SED     is op=0xF8
{
	D = 1;	
}

:SEI     is op=0x78
{
	I = 1;
}

:STA OP1     is (cc=1 & aaa=4 & bbb!=2) ... & OP1		# CodeBreaker: $89 is no STA (there is no store to an immediate)
{
	OP1 = A;
}

:STX OP2ST     is (op=0x86 | op=0x8E | op=0x96) ... & OP2ST
{
	OP2ST = X;
}

:STY OP2     is (op=0x84 | op=0x8C | op=0x94) ... & OP2
{
	OP2 = Y;
}

:TAX     is op=0xAA
{
	X = A;
	resultFlags(X);
}

:TAY     is op=0xA8
{
	Y = A;
	resultFlags(Y);
}

:TSX     is op=0xBA
{
	X = S;
    resultFlags(X);	
}

:TXA     is op=0x8A
{
	A = X;
	resultFlags(A);
}

:TXS     is op=0x9A
{
	S = X;
}

:TYA     is op=0x98
{
	A = Y;
	resultFlags(A);
}

################################################################
# 65C02 instructions
################################################################

define token bitopbyte (8)
    bitop           = (0,7)

    action          = (7,7)
    bitindex        = (4,6) dec
    optype          = (0,3)
;

define token testopbyte (8)
    top             = (0, 7)
    taaa            = (5, 7)
    td              = (4, 4)
    tbb             = (2, 3)
    tcc             = (0, 1)
;

################################################################

# Zero Page Indirect
ZIOP:   (imm8)    is bbb=4; imm8  { addr:2 = 0x2000 + imm8; tmp:2 = *:2 addr; export *:1 tmp; }

OPTB:   imm8      is tbb=1; imm8  { tmp:2 = 0x2000 + imm8; export *:1 tmp; }
OPTB:   imm16     is tbb=3; imm16 { export *:1 imm16; }

# Absolute Indexed Indirect
ADDRIX: (imm16,X) is X; imm16     { addr:2 = imm16 + zext(X); tmp:2 = *:2 addr; export tmp; }


# the bit number, written after the mnemonic (BBR0 .. BBS7)
BITN: "0" is bitindex=0 { }
BITN: "1" is bitindex=1 { }
BITN: "2" is bitindex=2 { }
BITN: "3" is bitindex=3 { }
BITN: "4" is bitindex=4 { }
BITN: "5" is bitindex=5 { }
BITN: "6" is bitindex=6 { }
BITN: "7" is bitindex=7 { }

# Instructions

:ADC ZIOP                      is (cc=2 & aaa=3) ... & ZIOP
{
    local op1 = ZIOP;
    local tmpC = C;

    local result = A + op1 + tmpC;
    C = carry(A, op1) || carry(A + op1, tmpC);
    V = ((A ^ result) & (op1 ^ result) & 0x80) != 0;
    A = result;
    resultFlags(A);
}

:AND ZIOP                      is (cc=2 & aaa=1) ... & ZIOP
{
    A = A & ZIOP;
    resultFlags(A);
}

:BBR^BITN imm8, REL    is (action=0 & optype=0xF) & bitindex & BITN ; imm8 ; REL {
    local ptr:2 = 0x2000 + imm8;
    local value:1 = *:1 ptr;
    local jump = (value & (1 << bitindex)) == 0;
    if (jump) goto REL;
}

:BBS^BITN imm8, REL    is (action=1 & optype=0xF) & bitindex & BITN ; imm8 ; REL {
    local ptr:2 = 0x2000 + imm8;
    local value:1 = *:1 ptr;
    local jump = (value & (1 << bitindex)) != 0;
    if (jump) goto REL;
}

:BIT "#"imm8                   is op=0x89; imm8
{
    local value:1 = imm8;
    N = (value & 0x80) == 0x80;
    V = (value & 0x40) == 0x40;
    value = A & value;
    Z = (value == 0);
}

:BIT OP2                       is (op=0x34 | op=0x3C) ... & OP2
{
    N = (OP2 & 0x80) == 0x80;
    V = (OP2 & 0x40) == 0x40;
    local value = A & OP2;
    Z = (value == 0);
}

:BRA  REL                      is op=0x80; REL
{
    goto REL;
}

:CMP ZIOP                      is (cc=2 & aaa=6) ... & ZIOP
{
    local op1 = ZIOP;
    local tmp = A - op1;
    resultFlags(tmp);
    C = (A >= op1);
}

:DEC A                         is op=0x3A & A
{
    local tmp = A - 1;
    A = tmp;
    resultFlags(tmp);
}

:EOR ZIOP                      is (cc=2 & aaa=2) ... & ZIOP
{
    local op1 = ZIOP;
    A = A ^ op1;
    resultFlags(A);
}

:INC A                         is op=0x1A & A
{
    A = A + 1;
    resultFlags(A);
}

:JMP ADDRIX                    is (op=0x7C); ADDRIX
{
    goto [ADDRIX];
}

:LDA ZIOP                      is (cc=2 & aaa=5) ... & ZIOP
{
    A = ZIOP;
    resultFlags(A);
}

:ORA  ZIOP                     is (cc=2 & aaa=0) ... & ZIOP
{
    A = A | ZIOP;
    resultFlags(A);
}

:PHX                           is op=0xDA
{
    *:1 (SP) = X;
    SP = SP - 1;
}

:PLX                           is op=0xFA
{
    SP = SP + 1;
    X = *:1 (SP);
    resultFlags(X);
}

:PHY                           is op=0x5A
{
    *:1 (SP) = Y;
    SP = SP - 1;
}

:PLY                           is op=0x7A
{
    SP = SP + 1;
    Y = *:1 (SP);
    resultFlags(Y);
}

:RMB^BITN imm8         is (action=0 & optype=7) & bitindex & BITN ; imm8 {
    local ptr:2 = 0x2000 + imm8;
    local value:1 = *:1 ptr;
    value = value & ~(1 << bitindex);
    *:1 ptr = value;
}

:SBC ZIOP                      is (cc=2 & aaa=7) ... & ZIOP
{
    local op1 = ZIOP;
    local result = A - op1 - !C;
    local wide:2 = zext(A) - zext(op1) - zext(!C);
    subtraction_flags1(A, op1, result);
    C = wide s>= 0;
    A = result;
}

:SMB^BITN imm8         is (action=1 & optype=7) & bitindex & BITN ; imm8 {
    local ptr:2 = 0x2000 + imm8;
    local value:1 = *:1 ptr;
    value = value | (1 << bitindex);
    *:1 ptr = value;
}

:STA ZIOP                      is (cc=2 & aaa=4) ... & ZIOP
{
    ZIOP = A;
}

:STZ imm8                      is op=0x64 ; imm8
{
    local tmp:2 = 0x2000 + imm8;
    *:1 tmp = 0;
}

:STZ imm8,X                    is op=0x74 & X ; imm8
{
    local tmp:2 = 0x2000 + zext(imm8 + X);
    *:1 tmp = 0;
}

:STZ imm16                     is op=0x9C ; imm16
{
    local tmp:2 = imm16;
    *:1 tmp = 0;
}

:STZ imm16,X                   is op=0x9E & X ; imm16
{
    local tmp:2 = imm16 + zext(X);
    *:1 tmp = 0;
}

:TRB OPTB                      is (tcc=0 & taaa=0 & td=1) ... & OPTB
{
    local op1 = OPTB;
    Z = (A & op1) == 0;
    OPTB = (~A) & op1;
}

:TSB OPTB                      is (tcc=0 & taaa=0 & td=0) ... & OPTB
{
    local op1 = OPTB;
    Z = (A & op1) == 0;
    OPTB = A | op1;
}

################################################################
# HuC6280 additions
################################################################

define token data8b (8)
    imm8b   = (0,7)
;

define token data16b (16)
    imm16b  = (0,15)
;

define token data16c (16)
    imm16c  = (0,15)
;

define pcodeop cpu_slow;    # CSL: 1.79 MHz
define pcodeop cpu_fast;    # CSH: 7.16 MHz

:SXY is op=0x02 { local t = X; X = Y; Y = t; }
:SAX is op=0x22 { local t = A; A = X; X = t; }
:SAY is op=0x42 { local t = A; A = Y; Y = t; }

:CLA is op=0x62 { A = 0; }
:CLX is op=0x82 { X = 0; }
:CLY is op=0xC2 { Y = 0; }

:CSL is op=0x54 { cpu_slow(); }
:CSH is op=0xD4 { cpu_fast(); }

# The next instruction's memory operand is the zero page byte addressed by X (T flag); the flag is
# only set here.
:SET is op=0xF4 { T = 1; }

# VDC ports (the I/O page is mapped at $0000)
:ST0 "#"imm8 is op=0x03; imm8 { local port:2 = 0x0000; *:1 port = imm8; }
:ST1 "#"imm8 is op=0x13; imm8 { local port:2 = 0x0002; *:1 port = imm8; }
:ST2 "#"imm8 is op=0x23; imm8 { local port:2 = 0x0003; *:1 port = imm8; }

# Mapping registers: the mask picks the MPRs (bit n = MPRn)
:TAM "#"imm8 is op=0x53; imm8
{
    local mask:1 = imm8;
    if ((mask & 0x01) == 0) goto <n0>; MPR0 = A; <n0>
    if ((mask & 0x02) == 0) goto <n1>; MPR1 = A; <n1>
    if ((mask & 0x04) == 0) goto <n2>; MPR2 = A; <n2>
    if ((mask & 0x08) == 0) goto <n3>; MPR3 = A; <n3>
    if ((mask & 0x10) == 0) goto <n4>; MPR4 = A; <n4>
    if ((mask & 0x20) == 0) goto <n5>; MPR5 = A; <n5>
    if ((mask & 0x40) == 0) goto <n6>; MPR6 = A; <n6>
    if ((mask & 0x80) == 0) goto <n7>; MPR7 = A; <n7>
}

:TMA "#"imm8 is op=0x43; imm8
{
    local mask:1 = imm8;
    if ((mask & 0x01) == 0) goto <n0>; A = MPR0; <n0>
    if ((mask & 0x02) == 0) goto <n1>; A = MPR1; <n1>
    if ((mask & 0x04) == 0) goto <n2>; A = MPR2; <n2>
    if ((mask & 0x08) == 0) goto <n3>; A = MPR3; <n3>
    if ((mask & 0x10) == 0) goto <n4>; A = MPR4; <n4>
    if ((mask & 0x20) == 0) goto <n5>; A = MPR5; <n5>
    if ((mask & 0x40) == 0) goto <n6>; A = MPR6; <n6>
    if ((mask & 0x80) == 0) goto <n7>; A = MPR7; <n7>
}

:BSR REL is op=0x44; REL
{
    *:2 (SP-1) = inst_next - 1;
    SP = SP - 2;
    call REL;
}

# Block transfers: source, destination, length (a length of 0 is 65536 bytes)
:TII imm16, imm16b, imm16c is op=0x73; imm16; imm16b; imm16c
{
    local s:2 = imm16; local d:2 = imm16b; local n:2 = imm16c;
  <loop>
    *:1 d = *:1 s;
    s = s + 1; d = d + 1; n = n - 1;
    if (n != 0) goto <loop>;
}

:TDD imm16, imm16b, imm16c is op=0xC3; imm16; imm16b; imm16c
{
    local s:2 = imm16; local d:2 = imm16b; local n:2 = imm16c;
  <loop>
    *:1 d = *:1 s;
    s = s - 1; d = d - 1; n = n - 1;
    if (n != 0) goto <loop>;
}

:TIN imm16, imm16b, imm16c is op=0xD3; imm16; imm16b; imm16c
{
    local s:2 = imm16; local d:2 = imm16b; local n:2 = imm16c;
  <loop>
    *:1 d = *:1 s;
    s = s + 1; n = n - 1;
    if (n != 0) goto <loop>;
}

:TIA imm16, imm16b, imm16c is op=0xE3; imm16; imm16b; imm16c
{
    local s:2 = imm16; local d:2 = imm16b; local n:2 = imm16c; local alt:2 = 0;
  <loop>
    local t:2 = d + alt;
    *:1 t = *:1 s;
    s = s + 1; alt = alt ^ 1; n = n - 1;
    if (n != 0) goto <loop>;
}

:TAI imm16, imm16b, imm16c is op=0xF3; imm16; imm16b; imm16c
{
    local s:2 = imm16; local d:2 = imm16b; local n:2 = imm16c; local alt:2 = 0;
  <loop>
    local t:2 = s + alt;
    *:1 d = *:1 t;
    d = d + 1; alt = alt ^ 1; n = n - 1;
    if (n != 0) goto <loop>;
}

# TST #mask, memory: Z from (mask & memory); N, V are memory bits 7 and 6
macro tst(mask, v) {
    N = (v & 0x80) == 0x80;
    V = (v & 0x40) == 0x40;
    local r:1 = mask & v;
    Z = (r == 0);
}

:TST "#"imm8, imm8b is op=0x83; imm8; imm8b
{
    local a:2 = 0x2000 + imm8b; local v:1 = *:1 a; tst(imm8, v);
}

:TST "#"imm8, imm16b is op=0x93; imm8; imm16b
{
    local a:2 = imm16b; local v:1 = *:1 a; tst(imm8, v);
}

:TST "#"imm8, imm8b,X is op=0xA3 & X; imm8; imm8b
{
    local a:2 = 0x2000 + zext(imm8b + X); local v:1 = *:1 a; tst(imm8, v);
}

:TST "#"imm8, imm16b,X is op=0xB3 & X; imm8; imm16b
{
    local a:2 = imm16b + zext(X); local v:1 = *:1 a; tst(imm8, v);
}
