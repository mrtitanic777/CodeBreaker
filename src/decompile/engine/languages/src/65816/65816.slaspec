# --- LDX LDY STX STY CPX CPY (the width of the index registers)

:LDX EA_DP is x16=0 & op=0xA6; EA_DP
{
    local v:1 = *:1 EA_DP;
    X = zext(v);
    resultFlags(v);
}

:STX EA_DP is x16=0 & op=0x86; EA_DP
{
    *:1 EA_DP = XL;
}

:LDX EA_ABS is x16=0 & op=0xAE; EA_ABS
{
    local v:1 = *:1 EA_ABS;
    X = zext(v);
    resultFlags(v);
}

:STX EA_ABS is x16=0 & op=0x8E; EA_ABS
{
    *:1 EA_ABS = XL;
}

:LDX EA_DPY is x16=0 & op=0xB6; EA_DPY
{
    local v:1 = *:1 EA_DPY;
    X = zext(v);
    resultFlags(v);
}

:STX EA_DPY is x16=0 & op=0x96; EA_DPY
{
    *:1 EA_DPY = XL;
}

:LDX EA_ABSY is x16=0 & op=0xBE; EA_ABSY
{
    local v:1 = *:1 EA_ABSY;
    X = zext(v);
    resultFlags(v);
}

:LDY EA_DP is x16=0 & op=0xA4; EA_DP
{
    local v:1 = *:1 EA_DP;
    Y = zext(v);
    resultFlags(v);
}

:STY EA_DP is x16=0 & op=0x84; EA_DP
{
    *:1 EA_DP = YL;
}

:LDY EA_ABS is x16=0 & op=0xAC; EA_ABS
{
    local v:1 = *:1 EA_ABS;
    Y = zext(v);
    resultFlags(v);
}

:STY EA_ABS is x16=0 & op=0x8C; EA_ABS
{
    *:1 EA_ABS = YL;
}

:LDY EA_DPX is x16=0 & op=0xB4; EA_DPX
{
    local v:1 = *:1 EA_DPX;
    Y = zext(v);
    resultFlags(v);
}

:STY EA_DPX is x16=0 & op=0x94; EA_DPX
{
    *:1 EA_DPX = YL;
}

:LDY EA_ABSX is x16=0 & op=0xBC; EA_ABSX
{
    local v:1 = *:1 EA_ABSX;
    Y = zext(v);
    resultFlags(v);
}

:CPX EA_DP is x16=0 & op=0xE4; EA_DP
{
    local v:1 = *:1 EA_DP;
    local r:1 = XL - v;
    resultFlags(r);
    C = (XL >= v);
}

:CPY EA_DP is x16=0 & op=0xC4; EA_DP
{
    local v:1 = *:1 EA_DP;
    local r:1 = YL - v;
    resultFlags(r);
    C = (YL >= v);
}

:CPX EA_ABS is x16=0 & op=0xEC; EA_ABS
{
    local v:1 = *:1 EA_ABS;
    local r:1 = XL - v;
    resultFlags(r);
    C = (XL >= v);
}

:CPY EA_ABS is x16=0 & op=0xCC; EA_ABS
{
    local v:1 = *:1 EA_ABS;
    local r:1 = YL - v;
    resultFlags(r);
    C = (YL >= v);
}

:LDX "#"imm8 is x16=0 & op=0xA2; imm8
{
    local v:1 = imm8;
    X = zext(v);
    resultFlags(v);
}

:LDY "#"imm8 is x16=0 & op=0xA0; imm8
{
    local v:1 = imm8;
    Y = zext(v);
    resultFlags(v);
}

:CPX "#"imm8 is x16=0 & op=0xE0; imm8
{
    local v:1 = imm8;
    local r:1 = XL - v;
    resultFlags(r);
    C = (XL >= v);
}

:CPY "#"imm8 is x16=0 & op=0xC0; imm8
{
    local v:1 = imm8;
    local r:1 = YL - v;
    resultFlags(r);
    C = (YL >= v);
}

:INX is x16=0 & op=0xE8
{
    XL = XL + 1;
    resultFlags(XL);
}

:INY is x16=0 & op=0xC8
{
    YL = YL + 1;
    resultFlags(YL);
}

:DEX is x16=0 & op=0xCA
{
    XL = XL - 1;
    resultFlags(XL);
}

:DEY is x16=0 & op=0x88
{
    YL = YL - 1;
    resultFlags(YL);
}

:LDX EA_DP is x16=1 & op=0xA6; EA_DP
{
    local v:2 = *:2 EA_DP;
    X = v;
    resultFlags(v);
}

:STX EA_DP is x16=1 & op=0x86; EA_DP
{
    *:2 EA_DP = X;
}

:LDX EA_ABS is x16=1 & op=0xAE; EA_ABS
{
    local v:2 = *:2 EA_ABS;
    X = v;
    resultFlags(v);
}

:STX EA_ABS is x16=1 & op=0x8E; EA_ABS
{
    *:2 EA_ABS = X;
}

:LDX EA_DPY is x16=1 & op=0xB6; EA_DPY
{
    local v:2 = *:2 EA_DPY;
    X = v;
    resultFlags(v);
}

:STX EA_DPY is x16=1 & op=0x96; EA_DPY
{
    *:2 EA_DPY = X;
}

:LDX EA_ABSY is x16=1 & op=0xBE; EA_ABSY
{
    local v:2 = *:2 EA_ABSY;
    X = v;
    resultFlags(v);
}

:LDY EA_DP is x16=1 & op=0xA4; EA_DP
{
    local v:2 = *:2 EA_DP;
    Y = v;
    resultFlags(v);
}

:STY EA_DP is x16=1 & op=0x84; EA_DP
{
    *:2 EA_DP = Y;
}

:LDY EA_ABS is x16=1 & op=0xAC; EA_ABS
{
    local v:2 = *:2 EA_ABS;
    Y = v;
    resultFlags(v);
}

:STY EA_ABS is x16=1 & op=0x8C; EA_ABS
{
    *:2 EA_ABS = Y;
}

:LDY EA_DPX is x16=1 & op=0xB4; EA_DPX
{
    local v:2 = *:2 EA_DPX;
    Y = v;
    resultFlags(v);
}

:STY EA_DPX is x16=1 & op=0x94; EA_DPX
{
    *:2 EA_DPX = Y;
}

:LDY EA_ABSX is x16=1 & op=0xBC; EA_ABSX
{
    local v:2 = *:2 EA_ABSX;
    Y = v;
    resultFlags(v);
}

:CPX EA_DP is x16=1 & op=0xE4; EA_DP
{
    local v:2 = *:2 EA_DP;
    local r:2 = X - v;
    resultFlags(r);
    C = (X >= v);
}

:CPY EA_DP is x16=1 & op=0xC4; EA_DP
{
    local v:2 = *:2 EA_DP;
    local r:2 = Y - v;
    resultFlags(r);
    C = (Y >= v);
}

:CPX EA_ABS is x16=1 & op=0xEC; EA_ABS
{
    local v:2 = *:2 EA_ABS;
    local r:2 = X - v;
    resultFlags(r);
    C = (X >= v);
}

:CPY EA_ABS is x16=1 & op=0xCC; EA_ABS
{
    local v:2 = *:2 EA_ABS;
    local r:2 = Y - v;
    resultFlags(r);
    C = (Y >= v);
}

:LDX "#"imm16 is x16=1 & op=0xA2; imm16
{
    local v:2 = imm16;
    X = v;
    resultFlags(v);
}

:LDY "#"imm16 is x16=1 & op=0xA0; imm16
{
    local v:2 = imm16;
    Y = v;
    resultFlags(v);
}

:CPX "#"imm16 is x16=1 & op=0xE0; imm16
{
    local v:2 = imm16;
    local r:2 = X - v;
    resultFlags(r);
    C = (X >= v);
}

:CPY "#"imm16 is x16=1 & op=0xC0; imm16
{
    local v:2 = imm16;
    local r:2 = Y - v;
    resultFlags(r);
    C = (Y >= v);
}

:INX is x16=1 & op=0xE8
{
    X = X + 1;
    resultFlags(X);
}

:INY is x16=1 & op=0xC8
{
    Y = Y + 1;
    resultFlags(Y);
}

:DEX is x16=1 & op=0xCA
{
    X = X - 1;
    resultFlags(X);
}

:DEY is x16=1 & op=0x88
{
    Y = Y - 1;
    resultFlags(Y);
}

# --- register transfers

:TAX is x16=0 & op=0xAA
{
    X = zext(AL);
    resultFlags(XL);
}

:TAY is x16=0 & op=0xA8
{
    Y = zext(AL);
    resultFlags(YL);
}

:TSX is x16=0 & op=0xBA
{
    X = zext(SPL);
    resultFlags(XL);
}

:TXY is x16=0 & op=0x9B
{
    Y = zext(XL);
    resultFlags(YL);
}

:TYX is x16=0 & op=0xBB
{
    X = zext(YL);
    resultFlags(XL);
}

:TXA is m16=0 & op=0x8A
{
    AL = XL;
    resultFlags(AL);
}

:TYA is m16=0 & op=0x98
{
    AL = YL;
    resultFlags(AL);
}

:TAX is x16=1 & op=0xAA
{
    X = A;
    resultFlags(X);
}

:TAY is x16=1 & op=0xA8
{
    Y = A;
    resultFlags(Y);
}

:TSX is x16=1 & op=0xBA
{
    X = SP;
    resultFlags(X);
}

:TXY is x16=1 & op=0x9B
{
    Y = X;
    resultFlags(Y);
}

:TYX is x16=1 & op=0xBB
{
    X = Y;
    resultFlags(X);
}

:TXA is m16=1 & op=0x8A
{
    A = X;
    resultFlags(A);
}

:TYA is m16=1 & op=0x98
{
    A = Y;
    resultFlags(A);
}

:TXS is op=0x9A { SP = X; }
:TCS is op=0x1B { SP = A; }
:TSC is op=0x3B { A = SP; resultFlags(A); }
:TCD is op=0x5B { DP = A; resultFlags(DP); }
:TDC is op=0x7B { A = DP; resultFlags(A); }
:XBA is op=0xEB { local t:1 = AL; AL = AH; AH = t; resultFlags(AL); }
:XCE is op=0xFB { local t:1 = C; C = E; E = t; }

# --- stack

:PHA is m16=0 & op=0x48 { local v:1 = AL; push8(v); }

:PHX is x16=0 & op=0xDA { local v:1 = XL; push8(v); }

:PHY is x16=0 & op=0x5A { local v:1 = YL; push8(v); }

:PLA is m16=0 & op=0x68 { local v:1 = 0; pull8(v); AL = v; resultFlags(v); }

:PLX is x16=0 & op=0xFA { local v:1 = 0; pull8(v); X = zext(v); resultFlags(v); }

:PLY is x16=0 & op=0x7A { local v:1 = 0; pull8(v); Y = zext(v); resultFlags(v); }

:PHA is m16=1 & op=0x48 { local v:2 = A; push16(v); }

:PHX is x16=1 & op=0xDA { local v:2 = X; push16(v); }

:PHY is x16=1 & op=0x5A { local v:2 = Y; push16(v); }

:PLA is m16=1 & op=0x68 { local v:2 = 0; pull16(v); A = v; resultFlags(v); }

:PLX is x16=1 & op=0xFA { local v:2 = 0; pull16(v); X = v; resultFlags(v); }

:PLY is x16=1 & op=0x7A { local v:2 = 0; pull16(v); Y = v; resultFlags(v); }

:PHB is op=0x8B { push8(DB); }
:PLB is op=0xAB { local v:1 = 0; pull8(v); DB = v; resultFlags(v); }
:PHK is op=0x4B { push8(PB); }
:PHD is op=0x0B { push16(DP); }
:PLD is op=0x2B { local v:2 = 0; pull16(v); DP = v; resultFlags(v); }
:PHP is op=0x08 { pushP(); }
:PLP is op=0x28 { popP(); }
:PEA imm16 is op=0xF4; imm16 { local v:2 = imm16; push16(v); }
:PEI "("imm8")" is op=0xD4; imm8 { local pa:3 = zext(DP + imm8); local v:2 = *:2 pa; push16(v); }
:PER reloc is op=0x62; rel16 [ reloc = (inst_next + rel16) & 0xffff; ] { local v:2 = reloc; push16(v); }

# --- flags
:CLC is op=0x18 { C = 0; }
:SEC is op=0x38 { C = 1; }
:CLI is op=0x58 { I = 0; }
:SEI is op=0x78 { I = 1; }
:CLV is op=0xB8 { V = 0; }
:CLD is op=0xD8 { D = 0; }
:SED is op=0xF8 { D = 1; }

# REP and SEP change the flags, and with them the widths the following instructions are read in
:REP "#"imm8 is op=0xC2; imm8 & repm & repx [ m16 = m16 | repm; x16 = x16 | repx; globalset(inst_next, m16); globalset(inst_next, x16); ]
{
    local m:1 = imm8;
    repP(m);
}

:SEP "#"imm8 is op=0xE2; imm8 & repm & repx [ m16 = m16 & (1 - repm); x16 = x16 & (1 - repx); globalset(inst_next, m16); globalset(inst_next, x16); ]
{
    local m:1 = imm8;
    sepP(m);
}

# --- branches
:BPL REL is op=0x10; REL { if (N == 0) goto REL; }
:BMI REL is op=0x30; REL { if (N) goto REL; }
:BVC REL is op=0x50; REL { if (V == 0) goto REL; }
:BVS REL is op=0x70; REL { if (V) goto REL; }
:BCC REL is op=0x90; REL { if (C == 0) goto REL; }
:BCS REL is op=0xB0; REL { if (C) goto REL; }
:BNE REL is op=0xD0; REL { if (Z == 0) goto REL; }
:BEQ REL is op=0xF0; REL { if (Z) goto REL; }
:BRA REL is op=0x80; REL { goto REL; }
:BRL REL16 is op=0x82; REL16 { goto REL16; }

# --- jumps and calls
:JMP JABS is op=0x4C; JABS { goto JABS; }
:JML JLONG is op=0x5C; JLONG { goto JLONG; }

:JMP "("imm16")" is op=0x6C; imm16
{
    local p:3 = imm16;
    local t16:2 = *:2 p;
    local b:3 = zext(PB);
    b = b << 16;
    local t:3 = b + zext(t16);
    goto [t];
}

:JMP "("imm16",X)" is op=0x7C; imm16
{
    local s:2 = imm16 + X;
    local b:3 = zext(PB);
    b = b << 16;
    local p:3 = b + zext(s);
    local t16:2 = *:2 p;
    local t:3 = b + zext(t16);
    goto [t];
}

:JML "["imm16"]" is op=0xDC; imm16
{
    local p:3 = imm16;
    local t:3 = *:3 p;
    goto [t];
}

:JSR JABS is op=0x20; JABS
{
    local r:3 = inst_next - 1;
    local r16:2 = r:2;
    push16(r16);
    call JABS;
}

:JSR "("imm16",X)" is op=0xFC; imm16
{
    local r:3 = inst_next - 1;
    local r16:2 = r:2;
    push16(r16);
    local s:2 = imm16 + X;
    local b:3 = zext(PB);
    b = b << 16;
    local p:3 = b + zext(s);
    local t16:2 = *:2 p;
    local t:3 = b + zext(t16);
    call [t];
}

:JSL JLONG is op=0x22; JLONG
{
    push8(PB);
    local r:3 = inst_next - 1;
    local r16:2 = r:2;
    push16(r16);
    call JLONG;
}

:RTS is op=0x60
{
    local v:2 = 0;
    pull16(v);
    local b:3 = zext(PB);
    b = b << 16;
    local t:3 = b + zext(v + 1);	# JSR pushed the address of its last byte
    return [t];
}

:RTL is op=0x6B
{
    local v:2 = 0;
    local bk:1 = 0;
    pull16(v);
    pull8(bk);
    local b:3 = zext(bk);
    b = b << 16;
    local t:3 = b + zext(v + 1);
    return [t];
}

:RTI is op=0x40
{
    local v:2 = 0;
    local bk:1 = 0;
    popP();
    pull16(v);
    pull8(bk);
    local b:3 = zext(bk);
    b = b << 16;
    local t:3 = b | zext(v);
    return [t];
}

# --- software interrupts (native mode vectors in bank 0: COP $FFE4, BRK $FFE6)
:BRK "#"imm8 is op=0x00; imm8
{
    push8(PB);
    local r:3 = inst_next;
    local r16:2 = r:2;
    push16(r16);
    pushP();
    I = 1;
    D = 0;
    local vec:3 = 0xFFE6;
    local t16:2 = *:2 vec;
    local t:3 = zext(t16);
    goto [t];
}

:COP "#"imm8 is op=0x02; imm8
{
    push8(PB);
    local r:3 = inst_next;
    local r16:2 = r:2;
    push16(r16);
    pushP();
    I = 1;
    D = 0;
    local vec:3 = 0xFFE4;
    local t16:2 = *:2 vec;
    local t:3 = zext(t16);
    goto [t];
}

:WDM "#"imm8 is op=0x42; imm8 { }
:WAI is op=0xCB { wait_for_interrupt(); }
:STP is op=0xDB { stop_clock(); }
:NOP is op=0xEA { }

# --- block moves: A is the count less one, X the source, Y the destination (one byte per pass:
# the instruction repeats until A is $FFFF); the second operand byte is the source bank
:MVN imm8b, imm8 is op=0x54; imm8; imm8b
{
    local sb:3 = imm8b;
    local db:3 = imm8;
    local s:3 = (sb << 16) + zext(X);
    local d:3 = (db << 16) + zext(Y);
    *:1 d = *:1 s;
    X = X + 1;
    Y = Y + 1;
    A = A - 1;
    DB = imm8;
    if (A != 0xFFFF) goto inst_start;
}

:MVP imm8b, imm8 is op=0x44; imm8; imm8b
{
    local sb:3 = imm8b;
    local db:3 = imm8;
    local s:3 = (sb << 16) + zext(X);
    local d:3 = (db << 16) + zext(Y);
    *:1 d = *:1 s;
    X = X - 1;
    Y = Y - 1;
    A = A - 1;
    DB = imm8;
    if (A != 0xFFFF) goto inst_start;
}
