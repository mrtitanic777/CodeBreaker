# sleigh specification file for the WDC 65C816 (SNES)
#
# Derived from the 6502/65C02 descriptions in ../6502 (Ghidra, Apache-2.0).
#
# The accumulator and the index registers are 8 or 16 bits wide by the M and X flags. A SLEIGH
# disassembler cannot follow a flag at run time, so the widths are context variables:
#
#     m16 = 1   the accumulator is 16 bits (the M flag is clear)     default 0: 8 bits
#     x16 = 1   X and Y are 16 bits       (the X flag is clear)      default 0: 8 bits
#
# REP and SEP change them (globalset: from the next instruction on), and the immediate operand
# of the instructions that follow takes its size from them. The default is the state a program
# starts in as CodeBreaker's own decoder reads it (8-bit A, X and Y). The E flag (emulation) is
# modeled as a flag only: XCE exchanges it with the carry, and nothing follows it.
#
# Addresses are 24 bits: the program bank PB (the top byte of PC) and the data bank DB.

define endian=little;
define alignment=1;

define space RAM      type=ram_space      size=3 default;
define space register type=register_space size=1;

define register offset=0x00 size=2 [ A X Y SP DP ];
define register offset=0x00 size=1 [ AL AH XL XH YL YH SPL SPH DPL DPH ];
define register offset=0x10 size=1 [ DB ];
define register offset=0x20 size=3 [ PC ];
define register offset=0x20 size=2 [ PCW ];
define register offset=0x20 size=1 [ PCL PCH PB ];
define register offset=0x30 size=1 [ N V MF XF D I Z C E ];		# status bits (MF, XF: the M and X flags)

define register offset=0x40 size=4 contextreg;

define context contextreg
    m16 = (0,0)
    x16 = (1,1)
;

# TOKENS

define token opbyte (8)
    op      = (0,7)
    aaa     = (5,7)
    bbb     = (2,4)
    cc      = (0,1)
    lo5     = (0,4)
;

define token data8 (8)
    imm8    = (0,7)
    rel     = (0,7) signed
    repm    = (5,5)
    repx    = (4,4)
;

define token data8b (8)
    imm8b   = (0,7)
;

define token data16 (16)
    imm16   = (0,15)
    rel16   = (0,15) signed
;

define token data24 (24)
    imm24   = (0,23)
;

define pcodeop wait_for_interrupt;	# WAI
define pcodeop stop_clock;		# STP

macro resultFlags(value) {
    Z = (value == 0);
    N = (value s< 0);
}

# The stack lives in bank 0.
macro push8(v) {
    local sa:3 = zext(SP);
    *:1 sa = v;
    SP = SP - 1;
}

macro push16(v) {
    local sa:3 = zext(SP - 1);
    *:2 sa = v;
    SP = SP - 2;
}

macro pull8(v) {
    SP = SP + 1;
    local sa:3 = zext(SP);
    v = *:1 sa;
}

macro pull16(v) {
    local sa:3 = zext(SP + 1);
    v = *:2 sa;
    SP = SP + 2;
}

macro pushP() {
    local ccr:1 = 0;
    ccr[7,1] = N;
    ccr[6,1] = V;
    ccr[5,1] = MF;
    ccr[4,1] = XF;
    ccr[3,1] = D;
    ccr[2,1] = I;
    ccr[1,1] = Z;
    ccr[0,1] = C;
    local sa:3 = zext(SP);
    *:1 sa = ccr;
    SP = SP - 1;
}

macro popP() {
    SP = SP + 1;
    local sa:3 = zext(SP);
    local ccr:1 = *:1 sa;
    N = ccr[7,1];
    V = ccr[6,1];
    MF = ccr[5,1];
    XF = ccr[4,1];
    D = ccr[3,1];
    I = ccr[2,1];
    Z = ccr[1,1];
    C = ccr[0,1];
}

# REP clears, SEP sets, the P bits named by the mask (the context follows it: see REP and SEP)
macro repbit(f, m, n) { f = f & (((m >> n) & 1) ^ 1); }
macro sepbit(f, m, n) { f = f | ((m >> n) & 1); }

macro repP(m) {
    repbit(N, m, 7); repbit(V, m, 6); repbit(MF, m, 5); repbit(XF, m, 4);
    repbit(D, m, 3); repbit(I, m, 2); repbit(Z, m, 1); repbit(C, m, 0);
}

macro sepP(m) {
    sepbit(N, m, 7); sepbit(V, m, 6); sepbit(MF, m, 5); sepbit(XF, m, 4);
    sepbit(D, m, 3); sepbit(I, m, 2); sepbit(Z, m, 1); sepbit(C, m, 0);
}


# 8-bit accumulator arithmetic (binary mode)
macro adc8(v) {
    local a:1 = AL;
    local cs:1 = C;
    local r:1 = a + v + cs;
    C = carry(a, v) || carry(a + v, cs);
    V = ((a ^ r) & (v ^ r) & 0x80) != 0;
    AL = r;
    resultFlags(r);
}

macro sbc8(v) {
    local a:1 = AL;
    local cs:1 = C;
    local bs:1 = cs ^ 1;
    local r:1 = a - v - bs;
    local w:2 = zext(a) - zext(v) - zext(bs);
    C = w s>= 0;		# the carry is "no borrow"
    V = (((a ^ v) & (a ^ r)) & 0x80) != 0;
    AL = r;
    resultFlags(r);
}

macro cmp8(v) {
    local r:1 = AL - v;
    resultFlags(r);
    C = (AL >= v);
}


# 16-bit accumulator arithmetic (binary mode)
macro adc16(v) {
    local a:2 = A;
    local cs:2 = zext(C);
    local r:2 = a + v + cs;
    C = carry(a, v) || carry(a + v, cs);
    V = ((a ^ r) & (v ^ r) & 0x8000) != 0;
    A = r;
    resultFlags(r);
}

macro sbc16(v) {
    local a:2 = A;
    local cs:2 = zext(C);
    local bs:2 = cs ^ 1;
    local r:2 = a - v - bs;
    local w:4 = zext(a) - zext(v) - zext(bs);
    C = w s>= 0;		# the carry is "no borrow"
    V = (((a ^ v) & (a ^ r)) & 0x8000) != 0;
    A = r;
    resultFlags(r);
}

macro cmp16(v) {
    local r:2 = A - v;
    resultFlags(r);
    C = (A >= v);
}


################################################################
# Addressing modes: each is a table (its operand bytes follow the opcode) exporting the 24-bit
# effective address: the data bank (DB), direct page (DP), stack-relative and long modes.
################################################################
EA_DPXI: "("imm8",X)" is imm8
{
    local pp:3 = zext(DP + imm8 + X);
    local p:2 = *:2 pp;
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + zext(p);
    export ea;
}
EA_SR: imm8",S" is imm8
{
    local ea:3 = zext(SP + imm8);
    export ea;
}
EA_DP: imm8 is imm8
{
    local ea:3 = zext(DP + imm8);
    export ea;
}
EA_DPL: "["imm8"]" is imm8
{
    local pp:3 = zext(DP + imm8);
    local ea:3 = *:3 pp;
    export ea;
}
EA_ABS: imm16 is imm16
{
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + imm16;
    export ea;
}
EA_LONG: imm24 is imm24
{
    local ea:3 = imm24;
    export ea;
}
EA_DPIY: "("imm8"),Y" is imm8
{
    local pp:3 = zext(DP + imm8);
    local p:2 = *:2 pp;
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + zext(p) + zext(Y);
    export ea;
}
EA_DPI: "("imm8")" is imm8
{
    local pp:3 = zext(DP + imm8);
    local p:2 = *:2 pp;
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + zext(p);
    export ea;
}
EA_SRIY: "("imm8",S),Y" is imm8
{
    local pp:3 = zext(SP + imm8);
    local p:2 = *:2 pp;
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + zext(p) + zext(Y);
    export ea;
}
EA_DPX: imm8",X" is imm8
{
    local ea:3 = zext(DP + imm8 + X);
    export ea;
}
EA_DPY: imm8",Y" is imm8
{
    local ea:3 = zext(DP + imm8 + Y);
    export ea;
}
EA_DPLY: "["imm8"],Y" is imm8
{
    local pp:3 = zext(DP + imm8);
    local ea:3 = *:3 pp;
    ea = ea + zext(Y);
    export ea;
}
EA_ABSX: imm16",X" is imm16
{
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + imm16 + zext(X);
    export ea;
}
EA_ABSY: imm16",Y" is imm16
{
    local b:3 = zext(DB);
    b = b << 16;
    local ea:3 = b + imm16 + zext(Y);
    export ea;
}
EA_LONGX: imm24",X" is imm24
{
    local ea:3 = imm24 + zext(X);
    export ea;
}

# Branch targets stay in the program bank
REL: reloc            is rel [ reloc = (inst_next & 0xff0000) | ((inst_next + rel) & 0xffff); ] { export *:3 reloc; }
REL16: reloc          is rel16 [ reloc = (inst_next & 0xff0000) | ((inst_next + rel16) & 0xffff); ] { export *:3 reloc; }

# JMP and JSR to an address in the program bank
JABS: target          is imm16 [ target = (inst_next & 0xff0000) | imm16; ] { export *:3 target; }
JLONG: imm24          is imm24 { export *:3 imm24; }


################################################################
# Instructions
################################################################

# --- the accumulator group: ORA AND EOR ADC STA LDA CMP SBC (the width of A)

:ORA EA_DPXI is m16=0 & op=0x01; EA_DPXI
{
    local v:1 = *:1 EA_DPXI;
    AL = AL | v;
    resultFlags(AL);
}

:ORA EA_SR is m16=0 & op=0x03; EA_SR
{
    local v:1 = *:1 EA_SR;
    AL = AL | v;
