{
    *:1 EA_ABSX = 0;
}

:BIT EA_DP is m16=1 & op=0x24; EA_DP
{
    local t:2 = *:2 EA_DP;
    N = (t s< 0);
    V = (((t >> 14) & 1) != 0);
    local r:2 = A & t;
    Z = (r == 0);
}

:BIT EA_ABS is m16=1 & op=0x2C; EA_ABS
{
    local t:2 = *:2 EA_ABS;
