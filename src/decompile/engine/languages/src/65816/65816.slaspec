}

:ROL EA_DP is m16=0 & op=0x26; EA_DP
{
    local t:1 = *:1 EA_DP;
    local oc:1 = C;
    C = (t s< 0);
    t = (t << 1) | oc;
    *:1 EA_DP = t;
    resultFlags(t);
}

:ROL EA_ABS is m16=0 & op=0x2E; EA_ABS
{
    local t:1 = *:1 EA_ABS;
