}

:ROL EA_ABSX is m16=0 & op=0x3E; EA_ABSX
{
    local t:1 = *:1 EA_ABSX;
    local oc:1 = C;
    C = (t s< 0);
    t = (t << 1) | oc;
    *:1 EA_ABSX = t;
