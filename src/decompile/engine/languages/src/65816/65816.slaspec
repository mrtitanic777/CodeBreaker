}

:ROL A is m16=0 & op=0x2A & A
{
    local t:1 = AL;
    local oc:1 = C;
    C = (t s< 0);
    t = (t << 1) | oc;
    AL = t;
    resultFlags(t);
}

:ROL EA_DP is m16=1 & op=0x26; EA_DP
{
    local t:2 = *:2 EA_DP;
    local oc:2 = zext(C);
    C = (t s< 0);
    t = (t << 1) | oc;
    *:2 EA_DP = t;
    resultFlags(t);
}

:ROL EA_ABS is m16=1 & op=0x2E; EA_ABS
{
    local t:2 = *:2 EA_ABS;
    local oc:2 = zext(C);
    C = (t s< 0);
    t = (t << 1) | oc;
