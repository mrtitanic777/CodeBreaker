# --- shifts, rotates, INC and DEC: memory, then the accumulator

:ASL EA_DP is m16=0 & op=0x06; EA_DP
{
    local t:1 = *:1 EA_DP;
    C = (t s< 0);
    t = t << 1;
    *:1 EA_DP = t;
    resultFlags(t);
}

:ASL EA_ABS is m16=0 & op=0x0E; EA_ABS
{
    local t:1 = *:1 EA_ABS;
    C = (t s< 0);
    t = t << 1;
    *:1 EA_ABS = t;
    resultFlags(t);
}

:ASL EA_DPX is m16=0 & op=0x16; EA_DPX
{
