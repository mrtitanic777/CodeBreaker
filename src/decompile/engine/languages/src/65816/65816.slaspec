# --- BIT, TSB, TRB, STZ

:BIT EA_DP is m16=0 & op=0x24; EA_DP
{
    local t:1 = *:1 EA_DP;
    N = (t s< 0);
    V = (((t >> 6) & 1) != 0);
    local r:1 = AL & t;
    Z = (r == 0);
}

:BIT EA_ABS is m16=0 & op=0x2C; EA_ABS
{
    local t:1 = *:1 EA_ABS;
    N = (t s< 0);
    V = (((t >> 6) & 1) != 0);
    local r:1 = AL & t;
    Z = (r == 0);
}

:BIT EA_DPX is m16=0 & op=0x34; EA_DPX
{
    local t:1 = *:1 EA_DPX;
    N = (t s< 0);
    V = (((t >> 6) & 1) != 0);
    local r:1 = AL & t;
    Z = (r == 0);
}

:BIT EA_ABSX is m16=0 & op=0x3C; EA_ABSX
{
    local t:1 = *:1 EA_ABSX;
    N = (t s< 0);
    V = (((t >> 6) & 1) != 0);
    local r:1 = AL & t;
    Z = (r == 0);
}

:BIT "#"imm8 is m16=0 & op=0x89; imm8
{
    local t:1 = imm8;
    local r:1 = AL & t;
    Z = (r == 0);
}

:TSB EA_DP is m16=0 & op=0x04; EA_DP
{
    local t:1 = *:1 EA_DP;
    local r:1 = AL & t;
    Z = (r == 0);
    *:1 EA_DP = t | AL;
}

:TSB EA_ABS is m16=0 & op=0x0C; EA_ABS
{
    local t:1 = *:1 EA_ABS;
    local r:1 = AL & t;
    Z = (r == 0);
    *:1 EA_ABS = t | AL;
}

:TRB EA_DP is m16=0 & op=0x14; EA_DP
{
    local t:1 = *:1 EA_DP;
    local r:1 = AL & t;
    Z = (r == 0);
    *:1 EA_DP = t & ~AL;
}

:TRB EA_ABS is m16=0 & op=0x1C; EA_ABS
{
    local t:1 = *:1 EA_ABS;
    local r:1 = AL & t;
    Z = (r == 0);
    *:1 EA_ABS = t & ~AL;
}

