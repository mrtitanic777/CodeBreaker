X4H: "XHL3" is mhi6=0x0F { export XHL3; }
@endif
@if defined(EXACT)
X4H: "XWA'" is mhi6=0x34 { local p:4 = 0x40 + zext((RFP + 3) & 3) * 0x10; export *[register]:4 p; }
@else
X4H: "XWA'" is mhi6=0x34 { export pr_XWA; }
@endif
@if defined(EXACT)
X4H: "XBC'" is mhi6=0x35 { local p:4 = 0x44 + zext((RFP + 3) & 3) * 0x10; export *[register]:4 p; }
@else
X4H: "XBC'" is mhi6=0x35 { export pr_XBC; }
@endif
@if defined(EXACT)
X4H: "XDE'" is mhi6=0x36 { local p:4 = 0x48 + zext((RFP + 3) & 3) * 0x10; export *[register]:4 p; }
@else
X4H: "XDE'" is mhi6=0x36 { export pr_XDE; }
@endif
@if defined(EXACT)
X4H: "XHL'" is mhi6=0x37 { local p:4 = 0x4c + zext((RFP + 3) & 3) * 0x10; export *[register]:4 p; }
@else
X4H: "XHL'" is mhi6=0x37 { export pr_XHL; }
@endif
X4H: "XWA" is mhi6=0x38 { export XWA; }
X4H: "XBC" is mhi6=0x39 { export XBC; }
X4H: "XDE" is mhi6=0x3A { export XDE; }
X4H: "XHL" is mhi6=0x3B { export XHL; }
X4H: "XIX" is mhi6=0x3C { export XIX; }
X4H: "XIY" is mhi6=0x3D { export XIY; }
X4H: "XIZ" is mhi6=0x3E { export XIZ; }
X4H: "XSP" is mhi6=0x3F { export XSP; }

# the current bank's registers by the three low bits of a byte
Rz1: "W" is flo3=0 { export W; }
Rz1: "A" is flo3=1 { export A; }
Rz1: "B" is flo3=2 { export B; }
Rz1: "C" is flo3=3 { export C; }
Rz1: "D" is flo3=4 { export D; }
Rz1: "E" is flo3=5 { export E; }
Rz1: "H" is flo3=6 { export H; }
Rz1: "L" is flo3=7 { export L; }

Rz2: "WA" is flo3=0 { export WA; }
Rz2: "BC" is flo3=1 { export BC; }
Rz2: "DE" is flo3=2 { export DE; }
Rz2: "HL" is flo3=3 { export HL; }
Rz2: "IX" is flo3=4 { export IX; }
Rz2: "IY" is flo3=5 { export IY; }
Rz2: "IZ" is flo3=6 { export IZ; }
Rz2: "SP" is flo3=7 { export SP; }

Rz4: "XWA" is flo3=0 { export XWA; }
Rz4: "XBC" is flo3=1 { export XBC; }
Rz4: "XDE" is flo3=2 { export XDE; }
Rz4: "XHL" is flo3=3 { export XHL; }
Rz4: "XIX" is flo3=4 { export XIX; }
Rz4: "XIY" is flo3=5 { export XIY; }
Rz4: "XIZ" is flo3=6 { export XIZ; }
Rz4: "XSP" is flo3=7 { export XSP; }

Rmul1: "WA" is flo3=1 { export WA; }
Rmul1: "BC" is flo3=3 { export BC; }
Rmul1: "DE" is flo3=5 { export DE; }
Rmul1: "HL" is flo3=7 { export HL; }

# conditions (all, and all but T for the ones written without it)
Cc: "F" is flo4=0 { local c:1 = 0; export c; }
CcN: "F" is flo4=0 { local c:1 = 0; export c; }
Cc: "LT" is flo4=1 { local c:1 = (fS != fV); export c; }
CcN: "LT" is flo4=1 { local c:1 = (fS != fV); export c; }
Cc: "LE" is flo4=2 { local c:1 = ((fS != fV) || fZ); export c; }
CcN: "LE" is flo4=2 { local c:1 = ((fS != fV) || fZ); export c; }
Cc: "ULE" is flo4=3 { local c:1 = (fC || fZ); export c; }
CcN: "ULE" is flo4=3 { local c:1 = (fC || fZ); export c; }
Cc: "OV" is flo4=4 { local c:1 = fV; export c; }
CcN: "OV" is flo4=4 { local c:1 = fV; export c; }
Cc: "MI" is flo4=5 { local c:1 = fS; export c; }
CcN: "MI" is flo4=5 { local c:1 = fS; export c; }
Cc: "Z" is flo4=6 { local c:1 = fZ; export c; }
CcN: "Z" is flo4=6 { local c:1 = fZ; export c; }
Cc: "C" is flo4=7 { local c:1 = fC; export c; }
CcN: "C" is flo4=7 { local c:1 = fC; export c; }
Cc: "T" is flo4=8 { local c:1 = 1; export c; }
Cc: "GE" is flo4=9 { local c:1 = (fS == fV); export c; }
CcN: "GE" is flo4=9 { local c:1 = (fS == fV); export c; }
Cc: "GT" is flo4=10 { local c:1 = (((fS != fV) || fZ) == 0); export c; }
CcN: "GT" is flo4=10 { local c:1 = (((fS != fV) || fZ) == 0); export c; }
Cc: "UGT" is flo4=11 { local c:1 = ((fC || fZ) == 0); export c; }
CcN: "UGT" is flo4=11 { local c:1 = ((fC || fZ) == 0); export c; }
Cc: "NOV" is flo4=12 { local c:1 = (fV == 0); export c; }
CcN: "NOV" is flo4=12 { local c:1 = (fV == 0); export c; }
Cc: "PL" is flo4=13 { local c:1 = (fS == 0); export c; }
CcN: "PL" is flo4=13 { local c:1 = (fS == 0); export c; }
Cc: "NZ" is flo4=14 { local c:1 = (fZ == 0); export c; }
CcN: "NZ" is flo4=14 { local c:1 = (fZ == 0); export c; }
Cc: "NC" is flo4=15 { local c:1 = (fC == 0); export c; }
CcN: "NC" is flo4=15 { local c:1 = (fC == 0); export c; }

# control register bytes (the offset is what the getCR / setCR operations take)
CrN: "DMAS0" is crb=0x00 { local o:1 = 0x00; export o; }
CrN: "DMAS1" is crb=0x04 { local o:1 = 0x04; export o; }
CrN: "DMAS2" is crb=0x08 { local o:1 = 0x08; export o; }
CrN: "DMAS3" is crb=0x0C { local o:1 = 0x0C; export o; }
CrN: "DMAD0" is crb=0x10 { local o:1 = 0x10; export o; }
CrN: "DMAD1" is crb=0x14 { local o:1 = 0x14; export o; }
CrN: "DMAD2" is crb=0x18 { local o:1 = 0x18; export o; }
CrN: "DMAD3" is crb=0x1C { local o:1 = 0x1C; export o; }
CrN: "DMAC0" is crb=0x20 { local o:1 = 0x20; export o; }
CrN: "DMAM0" is crb=0x22 { local o:1 = 0x22; export o; }
CrN: "DMAC1" is crb=0x24 { local o:1 = 0x24; export o; }
CrN: "DMAM1" is crb=0x26 { local o:1 = 0x26; export o; }
CrN: "DMAC2" is crb=0x28 { local o:1 = 0x28; export o; }
CrN: "DMAM2" is crb=0x2A { local o:1 = 0x2A; export o; }
CrN: "DMAC3" is crb=0x2C { local o:1 = 0x2C; export o; }
CrN: "DMAM3" is crb=0x2E { local o:1 = 0x2E; export o; }
CrN: "INTNEST" is crb=0x30 { local o:1 = 0x30; export o; }
CrN: "CR_"^crb is crb { local o:1 = crb; export o; }

# the short form of a register operand of the first byte (the long form is the first byte and a code byte)
RS1: "W" is fb=0xC8 { export W; }
RS1: "A" is fb=0xC9 { export A; }
RS1: "B" is fb=0xCA { export B; }
RS1: "C" is fb=0xCB { export C; }
RS1: "D" is fb=0xCC { export D; }
RS1: "E" is fb=0xCD { export E; }
RS1: "H" is fb=0xCE { export H; }
RS1: "L" is fb=0xCF { export L; }

RS2: "WA" is fb=0xD8 { export WA; }
RS2: "BC" is fb=0xD9 { export BC; }
RS2: "DE" is fb=0xDA { export DE; }
RS2: "HL" is fb=0xDB { export HL; }
RS2: "IX" is fb=0xDC { export IX; }
RS2: "IY" is fb=0xDD { export IY; }
RS2: "IZ" is fb=0xDE { export IZ; }
RS2: "SP" is fb=0xDF { export SP; }

RS4: "XWA" is fb=0xE8 { export XWA; }
RS4: "XBC" is fb=0xE9 { export XBC; }
RS4: "XDE" is fb=0xEA { export XDE; }
RS4: "XHL" is fb=0xEB { export XHL; }
RS4: "XIX" is fb=0xEC { export XIX; }
RS4: "XIY" is fb=0xED { export XIY; }
RS4: "XIZ" is fb=0xEE { export XIZ; }
RS4: "XSP" is fb=0xEF { export XSP; }

RMW1: "WA" is fb=0xC9 { export WA; }
RMW1: "BC" is fb=0xCB { export BC; }
RMW1: "DE" is fb=0xCD { export DE; }
RMW1: "HL" is fb=0xCF { export HL; }
RMW2: "XWA" is fb=0xD8 { export XWA; }
RMW2: "XBC" is fb=0xD9 { export XBC; }
RMW2: "XDE" is fb=0xDA { export XDE; }
RMW2: "XHL" is fb=0xDB { export XHL; }
RMW2: "XIX" is fb=0xDC { export XIX; }
RMW2: "XIY" is fb=0xDD { export XIY; }
RMW2: "XIZ" is fb=0xDE { export XIZ; }
RMW2: "XSP" is fb=0xDF { export XSP; }

A8w1: "("^ab8^")" is ab8 { export *[ram]:1 ab8; }
A16w1: "("^ab16^")" is ab16 { export *[ram]:1 ab16; }
A8w2: "("^ab8^")" is ab8 { export *[ram]:2 ab8; }
A16w2: "("^ab16^")" is ab16 { export *[ram]:2 ab16; }
Cnt4c: "16" is p2b4=0 { local n:1 = 16; export n; }
Cnt4c: "1" is p2b4=1 { local n:1 = 1; export n; }
Cnt4c: "2" is p2b4=2 { local n:1 = 2; export n; }
Cnt4c: "3" is p2b4=3 { local n:1 = 3; export n; }
Cnt4c: "4" is p2b4=4 { local n:1 = 4; export n; }
Cnt4c: "5" is p2b4=5 { local n:1 = 5; export n; }
Cnt4c: "6" is p2b4=6 { local n:1 = 6; export n; }
Cnt4c: "7" is p2b4=7 { local n:1 = 7; export n; }
Cnt4c: "8" is p2b4=8 { local n:1 = 8; export n; }
Cnt4c: "9" is p2b4=9 { local n:1 = 9; export n; }
Cnt4c: "10" is p2b4=10 { local n:1 = 10; export n; }
Cnt4c: "11" is p2b4=11 { local n:1 = 11; export n; }
Cnt4c: "12" is p2b4=12 { local n:1 = 12; export n; }
Cnt4c: "13" is p2b4=13 { local n:1 = 13; export n; }
Cnt4c: "14" is p2b4=14 { local n:1 = 14; export n; }
Cnt4c: "15" is p2b4=15 { local n:1 = 15; export n; }
CrNc: "DMAS0" is p2v=0x00 { local o:1 = 0x00; export o; }
CrNc: "DMAS1" is p2v=0x04 { local o:1 = 0x04; export o; }
CrNc: "DMAS2" is p2v=0x08 { local o:1 = 0x08; export o; }
CrNc: "DMAS3" is p2v=0x0C { local o:1 = 0x0C; export o; }
CrNc: "DMAD0" is p2v=0x10 { local o:1 = 0x10; export o; }
CrNc: "DMAD1" is p2v=0x14 { local o:1 = 0x14; export o; }
CrNc: "DMAD2" is p2v=0x18 { local o:1 = 0x18; export o; }
CrNc: "DMAD3" is p2v=0x1C { local o:1 = 0x1C; export o; }
CrNc: "DMAC0" is p2v=0x20 { local o:1 = 0x20; export o; }
CrNc: "DMAM0" is p2v=0x22 { local o:1 = 0x22; export o; }
CrNc: "DMAC1" is p2v=0x24 { local o:1 = 0x24; export o; }
CrNc: "DMAM1" is p2v=0x26 { local o:1 = 0x26; export o; }
CrNc: "DMAC2" is p2v=0x28 { local o:1 = 0x28; export o; }
CrNc: "DMAM2" is p2v=0x2A { local o:1 = 0x2A; export o; }
CrNc: "DMAC3" is p2v=0x2C { local o:1 = 0x2C; export o; }
CrNc: "DMAM3" is p2v=0x2E { local o:1 = 0x2E; export o; }
CrNc: "INTNEST" is p2v=0x30 { local o:1 = 0x30; export o; }
CrNc: "CR_"^p2v is p2v { local o:1 = p2v; export o; }
Rel8c: reloc is p2s [ reloc = (inst_next + p2s) & 0xffffff; ] { export *[ram]:1 reloc; }
A16c1: "("^p3v^")" is p3v { export *[ram]:1 p3v; }
A16c2: "("^p3v^")" is p3v { export *[ram]:2 p3v; }
Rel8t: reloc is s8 [ reloc = (inst_next + s8) & 0xffffff; ] { export *[ram]:1 reloc; }
Rel16t: reloc is s16 [ reloc = (inst_next + s16) & 0xffffff; ] { export *[ram]:1 reloc; }
T16t: i16 is i16 { export *[ram]:1 i16; }
T24t: t24 is t24 { export *[ram]:1 t24; }

# flag helpers are written out in each constructor (the size differs); parity is the V flag of logic operations

N3: "8" is flo3=0 { local n:1 = 8; export n; }
N3: "1" is flo3=1 { local n:1 = 1; export n; }
N3: "2" is flo3=2 { local n:1 = 2; export n; }
N3: "3" is flo3=3 { local n:1 = 3; export n; }
N3: "4" is flo3=4 { local n:1 = 4; export n; }
N3: "5" is flo3=5 { local n:1 = 5; export n; }
N3: "6" is flo3=6 { local n:1 = 6; export n; }
N3: "7" is flo3=7 { local n:1 = 7; export n; }
Cnt4: "16" is bit4=0 { local n:1 = 16; export n; }
Cnt4: "1" is bit4=1 { local n:1 = 1; export n; }
Cnt4: "2" is bit4=2 { local n:1 = 2; export n; }
Cnt4: "3" is bit4=3 { local n:1 = 3; export n; }
Cnt4: "4" is bit4=4 { local n:1 = 4; export n; }
Cnt4: "5" is bit4=5 { local n:1 = 5; export n; }
Cnt4: "6" is bit4=6 { local n:1 = 6; export n; }
Cnt4: "7" is bit4=7 { local n:1 = 7; export n; }
Cnt4: "8" is bit4=8 { local n:1 = 8; export n; }
Cnt4: "9" is bit4=9 { local n:1 = 9; export n; }
Cnt4: "10" is bit4=10 { local n:1 = 10; export n; }
Cnt4: "11" is bit4=11 { local n:1 = 11; export n; }
Cnt4: "12" is bit4=12 { local n:1 = 12; export n; }
Cnt4: "13" is bit4=13 { local n:1 = 13; export n; }
Cnt4: "14" is bit4=14 { local n:1 = 14; export n; }
Cnt4: "15" is bit4=15 { local n:1 = 15; export n; }

:nop is fb=0x00 { }
:push "SR" is fb=0x02 {
  local v:2 = 0;
  getSR(v);
  XSP = XSP - 2;
  *[ram]:2 (XSP:3) = v;
}
:pop "SR" is fb=0x03 {
  local v:2 = *[ram]:2 (XSP:3);
  XSP = XSP + 2;
  setSR(v);
}
:halt is fb=0x05 {
  halt();
}
:ei i8 is fb=0x06 ; i8 {
  local v:1 = i8;
@if defined(EXACT)
@else
  setIFF(v);
@endif
  IFF = v[0,3];
}
:reti is fb=0x07 {
  local s:2 = *[ram]:2 (XSP:3);
  XSP = XSP + 2;
  setSR(s);
  local t4:4 = *[ram]:4 (XSP:3);
  XSP = XSP + 4;
  local t:3 = t4:3;
  return [t];
}
:ld A8w1^","^i8 is fb=0x08 ; A8w1 ; i8 {
  A8w1 = i8;
}
:push i8 is fb=0x09 ; i8 {
  local v:1 = i8;
  XSP = XSP - 1;
  *[ram]:1 (XSP:3) = v;
}
:ldw A8w2^","^i16 is fb=0x0A ; A8w2 ; i16 {
  A8w2 = i16;
}
:pushw i16 is fb=0x0B ; i16 {
  local v:2 = i16;
  XSP = XSP - 2;
  *[ram]:2 (XSP:3) = v;
}
:incf is fb=0x0C {
@if defined(EXACT)
  bankSave();
@endif
  RFP = (RFP + 1) & 3;
@if defined(EXACT)
  bankLoad();
@endif
}
:decf is fb=0x0D {
@if defined(EXACT)
  bankSave();
@endif
  RFP = (RFP - 1) & 3;
@if defined(EXACT)
  bankLoad();
@endif
}
:ret is fb=0x0E {
  local t4:4 = *[ram]:4 (XSP:3);
  local t:3 = t4:3;
  XSP = XSP + 4;
  return [t];
}
:retd s16 is fb=0x0F ; s16 {
  local t4:4 = *[ram]:4 (XSP:3);
  local t:3 = t4:3;
  local dd:4 = s16;
  XSP = XSP + 4 + dd;
  return [t];
}
:rcf is fb=0x10 {
  fC = 0;
  fN = 0;
  fH = 0;
}
:scf is fb=0x11 {
  fC = 1;
  fN = 0;
  fH = 0;
}
:ccf is fb=0x12 {
  fC = fC ^ 1;
  fN = 0;
}
:zcf is fb=0x13 {
  fC = fZ == 0;
  fN = 0;
}
:push "A" is fb=0x14 {
  local v:1 = A;
  XSP = XSP - 1;
  *[ram]:1 (XSP:3) = v;
}
:pop "A" is fb=0x15 {
  local v:1 = *[ram]:1 (XSP:3);
  XSP = XSP + 1;
  A = v;
}
:ex "F"^","^"F'" is fb=0x16 {
  local t:1 = 0;
  local u:1 = 0;
  getF(t);
  getFp(u);
  setF(u);
  setFp(t);
}
:ldf i8 is fb=0x17 ; i8 {
@if defined(EXACT)
  bankSave();
@endif
  RFP = i8 & 3;
@if defined(EXACT)
  bankLoad();
@endif
}
:push "F" is fb=0x18 {
  local v:1 = 0;
  getF(v);
  XSP = XSP - 1;
  *[ram]:1 (XSP:3) = v;
}
:pop "F" is fb=0x19 {
  local v:1 = *[ram]:1 (XSP:3);
  XSP = XSP + 1;
  setF(v);
}
:jp T16t is fb=0x1A ; T16t {
  goto T16t;
}
:jp T24t is fb=0x1B ; T24t {
  goto T24t;
}
:call T16t is fb=0x1C ; T16t {
  XSP = XSP - 4;
  local rt:4 = inst_next;
  *[ram]:4 (XSP:3) = rt;
  call T16t;
}
:call T24t is fb=0x1D ; T24t {
  XSP = XSP - 4;
  local rt:4 = inst_next;
  *[ram]:4 (XSP:3) = rt;
  call T24t;
}
:calr Rel16t is fb=0x1E ; Rel16t {
  XSP = XSP - 4;
  local rt:4 = inst_next;
  *[ram]:4 (XSP:3) = rt;
  call Rel16t;
}
:ld Rz1^","^i8 is fhi5=0x04 & Rz1 ; i8 {
  Rz1 = i8;
}
:push Rz2 is fhi5=0x05 & Rz2 {
  local v:2 = Rz2;
  XSP = XSP - 2;
  *[ram]:2 (XSP:3) = v;
}
:ld Rz2^","^i16 is fhi5=0x06 & Rz2 ; i16 {
  Rz2 = i16;
}
:push Rz4 is fhi5=0x07 & Rz4 {
  local v:4 = Rz4;
  XSP = XSP - 4;
  *[ram]:4 (XSP:3) = v;
}
:ld Rz4^","^i32 is fhi5=0x08 & Rz4 ; i32 {
  Rz4 = i32;
}
:pop Rz2 is fhi5=0x09 & Rz2 {
  local v:2 = *[ram]:2 (XSP:3);
  XSP = XSP + 2;
  Rz2 = v;
}
:pop Rz4 is fhi5=0x0B & Rz4 {
  local v:4 = *[ram]:4 (XSP:3);
  XSP = XSP + 4;
  Rz4 = v;
}
:jr Rel8t is fhi4=0x6 & flo4=8 ; Rel8t {
  goto Rel8t;
}
:jr CcN^","^Rel8t is fhi4=0x6 & CcN ; Rel8t {
  if (CcN) goto Rel8t;
}
:jrl Rel16t is fhi4=0x7 & flo4=8 ; Rel16t {
  goto Rel16t;
}
:jrl CcN^","^Rel16t is fhi4=0x7 & CcN ; Rel16t {
  if (CcN) goto Rel16t;
}
:ldx A8w1^","^i8 is fb=0xF7 ; pad0=0 ; A8w1 ; pad0=0 ; i8 ; pad0=0 {
  A8w1 = i8;
}
:swi flo3 is fhi5=0x1F & flo3 {
  local n:1 = flo3;
  swi(n);
}
:ld RS1^","^p2v is RS1 ; p2op=0x03 & p2v {
  RS1 = p2v;
}
:ld X1^","^p2v is fb=0xC7 ; X1 ; p2op=0x03 & p2v {
  X1 = p2v;
}
:ld RS2^","^p3v is RS2 ; p3op=0x03 & p3v {
  RS2 = p3v;
}
:ld X2^","^p3v is fb=0xD7 ; X2 ; p3op=0x03 & p3v {
  X2 = p3v;
}
:ld RS4^","^p5v is RS4 ; p5op=0x03 & p5v {
  RS4 = p5v;
}
:ld X4H^","^p5v is fb=0xE7 ; X4H & mlo2=0 ; p5op=0x03 & p5v {
  X4H = p5v;
}
:push RS1 is RS1 ; fb=0x04 {
  local v:1 = RS1;
  XSP = XSP - 1;
  *[ram]:1 (XSP:3) = v;
}
:push X1 is fb=0xC7 ; X1 ; fb=0x04 {
