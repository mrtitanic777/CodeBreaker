# sleigh specification file for the Toshiba TLCS-900/H (Neo Geo Pocket, TMP95C061)
#
# Generated from CodeBreaker's table-driven decoder structure (decompile/tlcs900.cpp); the layout:
#   first byte   what the second byte (the operation) works on:
#     $00-$7F   single-byte forms (nop, push, ld r,#, jr cc ...)
#     $80-$BF   memory by (XRR) / (XRR+d8): byte $80, word $90, long $A0 as a source, $B0 as a destination
#     $C0-$C5   memory by an absolute address or an extended mode ($C3), predecrement ($C4), postincrement ($C5);
#               $D0-$D5 word, $E0-$E5 long, $F0-$F5 destination
#     $C7-$EF   a register: $C8+r byte W A B C D E H L, $D8+r word WA BC DE HL IX IY IZ SP, $E8+r long XWA..XSP,
#               $C7 / $D7 / $E7 + a register code byte (QA, IXL, RA3, XWA3, XBC' ...)
#     $F7       ldx;  $F8-$FF swi
# The memory operand and register operand are sub-tables that consume the first byte and the bytes the mode needs; the
# operation byte follows.  Registers: the current bank is XWA XBC XDE XHL (with the previous bank's as XWA' ... and banks
# 0-3 as XWA0 ..) and the global XIX XIY XIZ XSP; the flags are kept apart (S Z H V N C) and put together on push F / ldf.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=3 default;
define space register type=register_space size=4;

define register offset=0x00 size=4 [ XWA XBC XDE XHL XIX XIY XIZ XSP ];
define register offset=0x00 size=2 [ WA QWA BC QBC DE QDE HL QHL IX QIX IY QIY IZ QIZ SP QSP ];
define register offset=0x00 size=1 [ A W QA QW C B QC QB E D QE QD L H QL QH
                                     IXL IXH QIXL QIXH IYL IYH QIYL QIYH IZL IZH QIZL QIZH SPL SPH QSPL QSPH ];

define register offset=0x40 size=4 [ XWA0 XBC0 XDE0 XHL0 ];
define register offset=0x40 size=2 [ RWA0 RQWA0 RBC0 RQBC0 RDE0 RQDE0 RHL0 RQHL0 ];
define register offset=0x40 size=1 [ RA0 RW0 RQA0 RQW0 RC0 RB0 RQC0 RQB0 RE0 RD0 RQE0 RQD0 RL0 RH0 RQL0 RQH0 ];
define register offset=0x50 size=4 [ XWA1 XBC1 XDE1 XHL1 ];
define register offset=0x50 size=2 [ RWA1 RQWA1 RBC1 RQBC1 RDE1 RQDE1 RHL1 RQHL1 ];
define register offset=0x50 size=1 [ RA1 RW1 RQA1 RQW1 RC1 RB1 RQC1 RQB1 RE1 RD1 RQE1 RQD1 RL1 RH1 RQL1 RQH1 ];
define register offset=0x60 size=4 [ XWA2 XBC2 XDE2 XHL2 ];
define register offset=0x60 size=2 [ RWA2 RQWA2 RBC2 RQBC2 RDE2 RQDE2 RHL2 RQHL2 ];
define register offset=0x60 size=1 [ RA2 RW2 RQA2 RQW2 RC2 RB2 RQC2 RQB2 RE2 RD2 RQE2 RQD2 RL2 RH2 RQL2 RQH2 ];
define register offset=0x70 size=4 [ XWA3 XBC3 XDE3 XHL3 ];
define register offset=0x70 size=2 [ RWA3 RQWA3 RBC3 RQBC3 RDE3 RQDE3 RHL3 RQHL3 ];
define register offset=0x70 size=1 [ RA3 RW3 RQA3 RQW3 RC3 RB3 RQC3 RQB3 RE3 RD3 RQE3 RQD3 RL3 RH3 RQL3 RQH3 ];
define register offset=0x80 size=4 [ pr_XWA pr_XBC pr_XDE pr_XHL ];
define register offset=0x80 size=2 [ pr_WA pr_QWA pr_BC pr_QBC pr_DE pr_QDE pr_HL pr_QHL ];
define register offset=0x80 size=1 [ pr_A pr_W pr_QA pr_QW pr_C pr_B pr_QC pr_QB pr_E pr_D pr_QE pr_QD pr_L pr_H pr_QL pr_QH ];

define register offset=0x100 size=1 [ fS fZ fH fV fN fC aS aZ aH aV aN aC RFP IFF fMAX fSYSM ];
define register offset=0x120 size=4 [ PC ];
@if defined(EXACT)
# CodeBreaker: what the one emulator (tlcs900exact.sla) keeps besides: SR's bits that the flags, RFP and IFF leave (F's bits 5 and 3, SR's
# bits 10, 11 and 15) as SRX, F''s bits 5 and 3 as aX, and the DMA control registers and INTNEST that ldc reads and writes.  The four
# register banks are XWA0 .. XHL3 with the current one in XWA .. XHL as well (the bank's own copy is stale while it is the current one).
define register offset=0x110 size=2 [ SRX ];
define register offset=0x112 size=1 [ aX ];
define register offset=0x140 size=4 [ DMAS0 DMAS1 DMAS2 DMAS3 DMAD0 DMAD1 DMAD2 DMAD3 ];
define register offset=0x160 size=2 [ DMAC0 DMAC1 DMAC2 DMAC3 ];
define register offset=0x168 size=1 [ DMAM0 DMAM1 DMAM2 DMAM3 ];
define register offset=0x16c size=2 [ INTNEST ];
@endif

define token byt (8)
   fb    = (0,7)
   fbs   = (0,7) signed
   flo2  = (0,1)
   flo3  = (0,2)
   flo4  = (0,3)
   fhi3  = (5,7)
   fhi4  = (4,7)
   fhi5  = (3,7)
   fhi6  = (2,7)
   mhi6  = (2,7)
   mlo2  = (0,1)
   db    = (0,7)
   dbs   = (0,7) signed
   db7   = (7,7)
   ab8   = (0,7)
   i8    = (0,7)
   s8    = (0,7) signed
   crb   = (0,7)
   bit4  = (0,3)
   pad0  = (0,7)
;

define token wrd (16)
   d16u  = (0,15)
   d16s  = (0,15) signed
   d16sg = (15,15)
   ab16  = (0,15)
   i16   = (0,15)
   s16   = (0,15) signed
;

define token tri (24)
   ab24  = (0,23)
   t24   = (0,23)
;

define token lng (32)
   i32   = (0,31)
;

# the operation byte and what follows it as one token, for the instructions whose first part (a memory
# operand) is of variable length: a pattern may have only one token after such a part
define token op2 (16)
   p2op  = (0,7)
   p2v   = (8,15)
   p2s   = (8,15) signed
   p2b4  = (8,11)
;

define token op3 (24)
   p3op  = (0,7)
   p3v   = (8,23)
   p3s   = (8,23) signed
;

define token op5 (40)
   p5op  = (0,7)
   p5v   = (8,39)
;

define pcodeop swi;
define pcodeop halt;
define pcodeop setIFF;
define pcodeop setRFP;
define pcodeop daa;
define pcodeop mirr;
define pcodeop mula;
define pcodeop bs1f;
define pcodeop bs1b;
define pcodeop getCR;
define pcodeop setCR;
define pcodeop minc;
define pcodeop mdec;
define pcodeop rotcl;
define pcodeop rotcr;
define pcodeop rotcl_c;
define pcodeop rotcr_c;
define pcodeop rld;
define pcodeop rrd;

macro getF(f) {
  f = 0;
  f[7,1] = fS;
  f[6,1] = fZ;
  f[4,1] = fH;
  f[2,1] = fV;
  f[1,1] = fN;
  f[0,1] = fC;
@if defined(EXACT)
  f = f | (SRX:1 & 0x28);
@endif
}

macro setF(f) {
  fS = f[7,1];
  fZ = f[6,1];
  fH = f[4,1];
  fV = f[2,1];
  fN = f[1,1];
  fC = f[0,1];
@if defined(EXACT)
  SRX = (SRX & 0xff00) | zext(f & 0x28);
@endif
}

macro getFp(f) {
  f = 0;
  f[7,1] = aS;
  f[6,1] = aZ;
  f[4,1] = aH;
  f[2,1] = aV;
  f[1,1] = aN;
  f[0,1] = aC;
@if defined(EXACT)
  f = f | (aX & 0x28);
@endif
}

macro setFp(f) {
  aS = f[7,1];
  aZ = f[6,1];
  aH = f[4,1];
  aV = f[2,1];
  aN = f[1,1];
  aC = f[0,1];
@if defined(EXACT)
  aX = f & 0x28;
@endif
}

@if defined(EXACT)
# the current bank put back in its place among the four, and the bank RFP names taken out of it
macro bankSave() {
  local sbp:4 = 0x40 + zext(RFP) * 0x10;
  *[register]:4 sbp = XWA;
  *[register]:4 (sbp + 4) = XBC;
  *[register]:4 (sbp + 8) = XDE;
  *[register]:4 (sbp + 12) = XHL;
}

macro bankLoad() {
  local lbp:4 = 0x40 + zext(RFP) * 0x10;
  XWA = *[register]:4 lbp;
  XBC = *[register]:4 (lbp + 4);
  XDE = *[register]:4 (lbp + 8);
  XHL = *[register]:4 (lbp + 12);
}
@endif

macro getSR(s) {
  local f:1 = 0;
  getF(f);
  s = zext(f);
  s[8,2] = RFP[0,2];
  s[12,3] = IFF[0,3];
@if defined(EXACT)
  s = s | (SRX & 0x8c00);
@endif
}

macro setSR(s) {
  local f:1 = s:1;
  setF(f);
@if defined(EXACT)
  SRX = s & 0x8c28;
  bankSave();
@endif
  RFP = s[8,2];
  IFF = s[12,3];
@if defined(EXACT)
  bankLoad();
@endif
}

# register code bytes (a code byte names any part of any bank)
@if defined(EXACT)
X1: "RA0" is fb=0x00 { local p:4 = 0x40 - zext(RFP == 0) * 0x40; export *[register]:1 p; }
@else
X1: "RA0" is fb=0x00 { export RA0; }
@endif
