  goto inst_start;
<go>
  local sa:4 = r30;
  local sb:4 = r27 & 31;
  local n:4 = r28;
  local found:1 = 0;
<loop>
  if (n == 0) goto <end>;
  local wa:4 = sa & 0xfffffffc;
  local w:4 = *[ram]:4 wa;
  if (((w >> sb) & 1) != 0) goto <step>;
  found = 1;
  goto <end>;
<step>
  sb = sb - 1;
  if (sb s>= 0) goto <next>;
  sb = 31;
  sa = sa - 4;
<next>
  n = n - 1;
  goto <loop>;
<end>
  r29 = r28 - n;
  r30 = sa;
  r27 = sb;
  r28 = n;
  Z = found == 0;
  S = 0;
  OV = 0;
  CY = 0;
@else
  sch0bsd(r26, r27, r28, r29, r30);
@endif
}
