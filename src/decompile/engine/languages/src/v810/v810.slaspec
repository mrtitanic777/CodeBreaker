:orbsu   is op6=0x1F & r1n=8 & r2n=0 {
@if defined(EXACT)
  if (r28 <= 0x100000) goto <go>;
  bitStringTooLong();
  goto inst_start;
<go>
  local sa:4 = r30;
  local sb:4 = r27 & 31;
  local da:4 = r29;
  local db:4 = r26 & 31;
  local n:4 = r28;
<loop>
  if (n == 0) goto <end>;
  local swa:4 = sa & 0xfffffffc;
  local sw:4 = *[ram]:4 swa;
  local s:4 = (sw >> sb) & 1;
  local dwa:4 = da & 0xfffffffc;
  local dw:4 = *[ram]:4 dwa;
  local d:4 = (dw >> db) & 1;
  local nb:4 = d | s;
  local pw:4 = *[ram]:4 dwa;
  pw = (pw & ~(1 << db)) | (nb << db);
  *[ram]:4 dwa = pw;
  sb = sb + 1;
  if (sb != 32) goto <s2>;
  sb = 0;
  sa = sa + 4;
<s2>
  db = db + 1;
  if (db != 32) goto <d2>;
  db = 0;
  da = da + 4;
<d2>
  n = n - 1;
  goto <loop>;
<end>
  r30 = sa;
  r27 = sb;
  r29 = da;
  r26 = db;
  r28 = 0;
@else
  orbsu(r26, r27, r28, r29, r30);
@endif
}
