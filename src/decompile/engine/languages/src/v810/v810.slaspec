################################################################
# Format III: conditional branches (100 cccc ddddddddd, bit 0 of the displacement is 0)

:b^CcB Rel9  is op3=4 & CcB & Rel9 {
  if (CcB) goto Rel9;
}
:br Rel9      is op3=4 & cnd=5 & Rel9 {
  goto Rel9;
}
:bnop Rel9    is op3=4 & cnd=13 & Rel9 {
}

################################################################
# Format IV: jr, jal (26-bit displacement, hw0 low 10 bits high, hw1 low)

:jr Rel26     is op6w=0x2A & Rel26 {
  goto Rel26;
}
:jal Rel26    is op6w=0x2B & Rel26 {
  r31 = inst_next;
  call Rel26;
}

################################################################
# Format V: imm16

:movea simm16,reg1,reg2 is op6=0x28 & reg1 & reg2; simm16 { reg2 = reg1 + simm16; }
:addi simm16,reg1,reg2  is op6=0x29 & reg1 & reg2; simm16 { local v:4 = simm16; addop(reg2, reg1, v); }
:ori imm16,reg1,reg2    is op6=0x2C & reg1 & reg2; imm16 { logic(reg2, reg1 | imm16); }
:andi imm16,reg1,reg2   is op6=0x2D & reg1 & reg2; imm16 { logic(reg2, reg1 & imm16); }
:xori imm16,reg1,reg2   is op6=0x2E & reg1 & reg2; imm16 { logic(reg2, reg1 ^ imm16); }
:movhi imm16,reg1,reg2  is op6=0x2F & reg1 & reg2; imm16 { local v:4 = imm16; reg2 = reg1 + (v << 16); }

################################################################
# Format VI: loads and stores, disp16[reg1]

:ld.b simm16^"["^reg1^"],"^reg2  is op6=0x30 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; reg2 = sext(*[ram]:1 ea); }
:ld.h simm16^"["^reg1^"],"^reg2  is op6=0x31 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; reg2 = sext(*[ram]:2 ea); }
:ld.w simm16^"["^reg1^"],"^reg2  is op6=0x33 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; reg2 = *[ram]:4 ea; }
:st.b reg2^","^simm16^"["^reg1^"]" is op6=0x34 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; *[ram]:1 ea = reg2:1; }
:st.h reg2^","^simm16^"["^reg1^"]" is op6=0x35 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; *[ram]:2 ea = reg2:2; }
:st.w reg2^","^simm16^"["^reg1^"]" is op6=0x37 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; *[ram]:4 ea = reg2; }
:in.b simm16^"["^reg1^"],"^reg2  is op6=0x38 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; reg2 = zext(*[ram]:1 ea); }
:in.h simm16^"["^reg1^"],"^reg2  is op6=0x39 & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; reg2 = zext(*[ram]:2 ea); }
:in.w simm16^"["^reg1^"],"^reg2  is op6=0x3B & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; reg2 = *[ram]:4 ea; }
:caxi simm16^"["^reg1^"],"^reg2  is op6=0x3A & reg1 & reg2; simm16 {
  local ea:4 = reg1 + simm16;
  local m:4 = *[ram]:4 ea;
  cmpop(reg2, m);
  if (reg2 != m) goto <keep>;
  *[ram]:4 ea = r30;
<keep>
  reg2 = m;
}
:out.b reg2^","^simm16^"["^reg1^"]" is op6=0x3C & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; *[ram]:1 ea = reg2:1; }
:out.h reg2^","^simm16^"["^reg1^"]" is op6=0x3D & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; *[ram]:2 ea = reg2:2; }
:out.w reg2^","^simm16^"["^reg1^"]" is op6=0x3F & reg1 & reg2; simm16 { local ea:4 = reg1 + simm16; *[ram]:4 ea = reg2; }

################################################################
# Format VII: floating point and the extended instructions (opcode 0x3E; the
# sub-opcode is the top six bits of the second halfword, the rest of it zero)

:cmpf.s reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x00 & extlow=0 {
@if defined(EXACT)
  local ra:1 = 0;
  local rb:1 = 0;
  reserved(reg2, ra);
  reserved(reg1, rb);
  if ((ra || rb) == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
@endif
  local d:4 = reg2 f- reg1;
  Z = (reg2 f== reg1);
  CY = (reg2 f< reg1);
  S = CY;
  OV = 0;
}
:cvt.ws reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x02 & extlow=0 {
@if defined(EXACT)
  local r:4 = int2float(reg1);
  fresult(r);
  reg2 = r;
@else
  reg2 = int2float(reg1); fcheck(reg2);
@endif
}
:cvt.sw reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x03 & extlow=0 {
@if defined(EXACT)
  local f:4 = reg1;
  local rf:1 = 0;
  reserved(f, rf);
  if (rf == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
  local mag:4 = f & 0x7fffffff;
  if ((mag < 0x4f000000) || (f == 0xcf000000)) goto <fits>;
  FIV = 1;
  goto inst_next;
<fits>
  local t:4 = trunc(f);
  local back:4 = int2float(t);
  local d:4 = f f- back;
  local d2:4 = d f+ d;
  local one:4 = 1;
  local fone:4 = int2float(one);
  local fmone:4 = fone ^ 0x80000000;
  if (d2 f> fone) goto <up>;
  if (d2 f< fmone) goto <down>;
  if ((t & 1) == 0) goto <done>;
  if (d2 f== fone) goto <up>;
  if (d2 f== fmone) goto <down>;
  goto <done>;
<up>
  t = t + 1;
  goto <done>;
<down>
  t = t - 1;
<done>
  reg2 = t;
  zs(t);
  OV = 0;
@else
  local t:4 = round(reg1); reg2 = trunc(t); zs(reg2); OV = 0;
@endif
}
:addf.s reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x04 & extlow=0 {
@if defined(EXACT)
  local a:4 = reg2;
  local b:4 = reg1;
  local ra:1 = 0;
  local rb:1 = 0;
  reserved(a, ra);
  reserved(b, rb);
  if ((ra || rb) == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
  local r:4 = a f+ b;
  fresult(r);
  reg2 = r;
@else
  reg2 = reg2 f+ reg1; fcheck(reg2);
@endif
}
:subf.s reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x05 & extlow=0 {
@if defined(EXACT)
  local a:4 = reg2;
  local b:4 = reg1;
  local ra:1 = 0;
  local rb:1 = 0;
  reserved(a, ra);
  reserved(b, rb);
  if ((ra || rb) == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
  local r:4 = a f- b;
  fresult(r);
  reg2 = r;
@else
  reg2 = reg2 f- reg1; fcheck(reg2);
@endif
}
:mulf.s reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x06 & extlow=0 {
@if defined(EXACT)
  local a:4 = reg2;
  local b:4 = reg1;
  local ra:1 = 0;
  local rb:1 = 0;
  reserved(a, ra);
  reserved(b, rb);
  if ((ra || rb) == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
  local r:4 = a f* b;
  fresult(r);
  reg2 = r;
@else
  reg2 = reg2 f* reg1; fcheck(reg2);
@endif
}
:divf.s reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x07 & extlow=0 {
@if defined(EXACT)
  local a:4 = reg2;
  local b:4 = reg1;
  local ra:1 = 0;
  local rb:1 = 0;
  reserved(a, ra);
  reserved(b, rb);
  if ((ra || rb) == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
  if ((b & 0x7fffffff) != 0) goto <go>;
  FZD = 1;
  goto inst_next;
<go>
  local r:4 = a f/ b;
  fresult(r);
  reg2 = r;
@else
  reg2 = reg2 f/ reg1; fcheck(reg2);
@endif
}
:xb reg2          is op6=0x3E & r1n=0 & reg2; ext6=0x08 & extlow=0 {
  local t:4 = reg2;
  reg2[8,8] = t[0,8];
  reg2[0,8] = t[8,8];
}
:xh reg2          is op6=0x3E & r1n=0 & reg2; ext6=0x09 & extlow=0 {
  local t:4 = reg2;
  reg2[16,16] = t[0,16];
  reg2[0,16] = t[16,16];
}
:rev reg1,reg2    is op6=0x3E & reg1 & reg2; ext6=0x0A & extlow=0 {
@if defined(EXACT)
  local v:4 = reg1;
  v = ((v >> 1) & 0x55555555) | ((v & 0x55555555) << 1);
  v = ((v >> 2) & 0x33333333) | ((v & 0x33333333) << 2);
  v = ((v >> 4) & 0x0f0f0f0f) | ((v & 0x0f0f0f0f) << 4);
  v = ((v >> 8) & 0x00ff00ff) | ((v & 0x00ff00ff) << 8);
  v = (v >> 16) | (v << 16);
  reg2 = v;
@else
  reg2 = bitrev(reg1);
@endif
}
:trnc.sw reg1,reg2 is op6=0x3E & reg1 & reg2; ext6=0x0B & extlow=0 {
@if defined(EXACT)
  local f:4 = reg1;
  local rf:1 = 0;
  reserved(f, rf);
  if (rf == 0) goto <ok>;
  FRO = 1;
  goto inst_next;
<ok>
  local mag:4 = f & 0x7fffffff;
  if ((mag < 0x4f000000) || (f == 0xcf000000)) goto <fits>;
  FIV = 1;
  goto inst_next;
<fits>
  local t:4 = trunc(f);
  reg2 = t;
  zs(t);
  OV = 0;
@else
  reg2 = trunc(reg1); zs(reg2); OV = 0;
@endif
}
:mpyhw reg1,reg2  is op6=0x3E & reg1 & reg2; ext6=0x0C & extlow=0 { local t:4 = sext(reg1[0,16]); reg2 = reg2 * t; }

